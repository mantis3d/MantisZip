<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CA1416</NoWarn>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="HarfBuzzSharp" Version="14.2.0" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="14.2.0" />
    <PackageReference Include="Svg.Skia" Version="2.0.0.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="Ude.NetStandard" Version="1.2.0" />
    <PackageReference Include="Markdig" Version="0.40.0" />
    <PackageReference Include="ReverseMarkdown" Version="4.7.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.4" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="PdfPig.Rendering.Skia" Version="0.1.15.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18" />
  </ItemGroup>

  <ItemGroup>
    <!-- 排除 .axaml，Avalonia 构建目标会自动处理 -->
    <AvaloniaResource Include="Resources\**" Exclude="Resources\**\*.axaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MantisZip.Core\MantisZip.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Localization\*.json;Resources\languages.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\MenuIcons\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 拖拽光标：按 overlay 状态加载的不同 .cur（DragCursor/Ok/Warn/Self），构建时复制到输出目录 -->
    <None Include="Resources\Cursors\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="contributors-*.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 构建后将 ShellExt 输出（comhost.dll + DLL + runtimeconfig.json）复制到 UI 输出目录 -->
  <Target Name="CopyShellExtComhost" AfterTargets="Build" Condition="'$(SkipShellExtCopy)' != 'true'">
    <MSBuild Projects="..\MantisZip.ShellExt\MantisZip.ShellExt.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
    <PropertyGroup>
      <_ShellExtDir>..\MantisZip.ShellExt\bin\$(Configuration)\net9.0-windows10.0.17763.0</_ShellExtDir>
    </PropertyGroup>
    <ItemGroup>
      <_ShellExtFiles Include="$(_ShellExtDir)\MantisZip.ShellExt.comhost.dll" />
      <_ShellExtFiles Include="$(_ShellExtDir)\MantisZip.ShellExt.dll" />
      <_ShellExtFiles Include="$(_ShellExtDir)\MantisZip.ShellExt.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_ShellExtFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish 后复制 ShellExt 输出（comhost.dll + DLL + runtimeconfig.json）到发布目录 -->
  <Target Name="CopyShellExtComhostToPublish" AfterTargets="Publish">
    <MSBuild Projects="..\MantisZip.ShellExt\MantisZip.ShellExt.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
    <PropertyGroup>
      <_ShellExtDir>..\MantisZip.ShellExt\bin\$(Configuration)\net9.0-windows10.0.17763.0</_ShellExtDir>
    </PropertyGroup>
    <ItemGroup>
      <_ShellExtPublishFiles Include="$(_ShellExtDir)\MantisZip.ShellExt.comhost.dll" />
      <_ShellExtPublishFiles Include="$(_ShellExtDir)\MantisZip.ShellExt.dll" />
      <_ShellExtPublishFiles Include="$(_ShellExtDir)\MantisZip.ShellExt.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_ShellExtPublishFiles)" DestinationFolder="$(PublishDir.TrimEnd('\\'))" SkipUnchangedFiles="true" />
  </Target>

</Project>
