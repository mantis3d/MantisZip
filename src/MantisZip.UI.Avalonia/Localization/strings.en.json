  "PwdHelp_Title": "Match Rules Help - MantisZip",
  "PwdHelp_Section_Title": "Password Match Rules",
  "PwdHelp_Intro": "Match rules determine which password to use for each archive. Each password can have multiple rules; any one matching will select that password. Supports Glob wildcards and Regex matching patterns.",
  "PwdHelp_Glob_Title": "1. Glob Matching (Wildcards)",
  "PwdHelp_Glob_Col_Wildcard": "Wildcard",
  "PwdHelp_Glob_MatchAny": "Matches any characters (including none)",
  "PwdHelp_Glob_MatchSingle": "Matches any single character",
  "PwdHelp_Glob_MatchDot": "Matches a dot (literal)",
  "PwdHelp_Glob_OtherChars": "Other characters",
  "PwdHelp_Glob_MatchLiteral": "Matches itself literally",
  "PwdHelp_Glob_Examples_Title": "Examples",
  "PwdHelp_Glob_Col_Meaning": "Meaning",
  "PwdHelp_Glob_Example_AllZip": "Matches all .zip files",
  "PwdHelp_Glob_Example_DocStar": "doc*",
  "PwdHelp_Glob_Example_DocStarDesc": "Matches \"doc\", \"document\", \"draft-v2\"",
  "PwdHelp_Glob_Example_ThreeChars": "Matches \"abc.zip\" and \"123.zip\", not \"ab.zip\"",
  "PwdHelp_Glob_Example_Backup": "backup-202?-*.7z",
  "PwdHelp_Glob_Example_BackupDesc": "Matches \"backup-2023-01.7z\", \"backup-2024-finance.7z\"",
  "PwdHelp_Regex_Title": "2. Regex Matching",
  "PwdHelp_Regex_Col_Expr": "Expression",
  "PwdHelp_Regex_Col_Meaning": "Meaning",
  "PwdHelp_Regex_Common_Title": "Common Symbols",
  "PwdHelp_Regex_Intro": "If Glob is not enough, write a regex directly. The system tries regex first; if it fails (syntax error), it falls back to Glob. Matching is case-insensitive.",
  "PwdHelp_Regex_Digit": "Digit 0-9",
  "PwdHelp_Regex_Word": "Letter, digit, underscore",
  "PwdHelp_Regex_CharSet": "Character set, matches any one",
  "PwdHelp_Regex_Anchors": "Match start to end",
  "PwdHelp_Regex_Or": "Match left or right",
  "PwdHelp_Regex_Examples_Title": "Examples",
  "PwdHelp_Regex_Ex_Finance": "^finance",
  "PwdHelp_Regex_Ex_FinanceDesc": "Matches files starting with \"finance\"",
  "PwdHelp_Regex_Ex_Rar": "Matches all .rar files",
  "PwdHelp_Regex_Ex_Year": "Matches \"2020.zip\" through \"2029.zip\"",
  "PwdHelp_Regex_Ex_Project": "(projectA|projectB)-\\d+",
  "PwdHelp_Regex_Ex_ProjectDesc": "Matches \"projectA-001\", \"projectB-99\"",
  "PwdHelp_Match_Title": "Match Execution Logic",
  "PwdHelp_Match_Step1": "1. When opening an archive, extract the filename and check each password's rules.",
  "PwdHelp_Match_Step2": "2. Each rule is tried as regex first.",
  "PwdHelp_Match_Step3": "3. If regex throws (syntax error), fall back to Glob matching.",
  "PwdHelp_Match_Step4": "4. If any rule matches → that password is selected.",
  "PwdHelp_Match_Step5": "5. If no rules match, try the next password in the list.",
  "PwdHelp_Close": "Got it",

  "Settings_Debug_LogPrivacyHelp_Title": "Log Privacy Mode",
  "Settings_Debug_LogPrivacyHelp_Intro": "Log privacy mode automatically redacts file/directory paths in log output to prevent sensitive information leakage when sharing logs. Useful when sending logs for debugging but wanting to avoid exposing directory structure.",
  "Settings_Debug_LogPrivacyHelp_Mode_Off": "▫ Off: No path redaction, full paths are logged",
  "Settings_Debug_LogPrivacyHelp_Mode_Filename": "▫ Filename: Only filename is kept, directory path is removed (e.g. report.docx)",
  "Settings_Debug_LogPrivacyHelp_Mode_Extension": "▫ Extension: Only file extension is kept, both path and filename are redacted (e.g. [PATH_1]\\[FILE_1].docx)",
  "Settings_Debug_LogPrivacyHelp_Mode_Full": "▫ Full: All path and filename info is redacted (e.g. [PATH_1])",
  "Settings_Debug_LogPrivacyHelp_What": "Affected: Local file paths, directory paths, UNC paths appearing in log output.",
  "Settings_Debug_LogPrivacyHelp_WhatNot": "Not affected: Log content outside file paths, error message text (without path portions), UI display.",
