<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MantisZip.UI.Avalonia.Dialogs.EditAdaptiveRuleDialog"
        x:CompileBindings="False"
        Width="420" WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="{Binding DialogTitle}">
  <!-- 主布局：垂直排列的输入表单 + 底部按钮 -->
  <ScrollViewer MaxHeight="500">
    <StackPanel Margin="12" Spacing="{DynamicResource SpacingSm}">
      <!-- 提示文本 -->
      <TextBlock Text="{Binding PromptText}" />
      <!-- 规则名称标签 + 输入框 -->
      <TextBlock Text="{Binding NameLabelText}" />
      <TextBox x:Name="RuleNameTextBox"
               PlaceholderText="规则名称 / Rule name"
               Background="{DynamicResource ThemeSurfaceBgBrush}"
               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
               BorderBrush="{DynamicResource ThemeBorderBrush}" />
      <!-- 压缩级别标签 + 下拉选择框 -->
      <TextBlock Text="{Binding LevelLabelText}" />
      <ComboBox x:Name="LevelComboBox" Width="200" />
      <!-- 适用格式标签 + 多选列表 -->
      <TextBlock Text="{Binding FormatsLabelText}" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding FormatsHintText}" Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="11"/>
      <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
              CornerRadius="{DynamicResource BorderRadius}" MaxHeight="180">
        <ScrollViewer>
          <StackPanel x:Name="FormatsPanel" Spacing="2"/>
        </ScrollViewer>
      </Border>
      <!-- 底部按钮区域：取消 / 确定 -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource SpacingSm}" Margin="0,8,0,0">
        <Button Content="{Binding CancelText}" Click="Cancel_Click" />
        <Button Content="{Binding OkText}" Click="Ok_Click" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
