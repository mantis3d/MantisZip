<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MantisZip.UI.Avalonia.Dialogs.CompressConflictDialog"
        x:CompileBindings="False"
        Title="{Binding WinTitle}"
        Width="440"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        CanResize="False"
        Background="{DynamicResource ThemeWindowBgBrush}"
        Padding="16">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
        Margin="8">

    <!-- Row 0: Header -->
    <TextBlock Grid.Row="0"
               x:Name="HeaderText"
               FontSize="13"
               TextWrapping="Wrap" />

    <!-- Row 1: Target file info panel -->
    <Border Grid.Row="1"
            Margin="0,8,0,0"
            Padding="12"
            Background="{DynamicResource ThemeSurfaceBgBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding TargetLabel}"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
        <TextBlock FontSize="11"
                   Foreground="{DynamicResource ThemeTextPrimaryBrush}">
          <Run Text="{Binding SizeLabel}" />
          <Run x:Name="TargetSizeText"
               Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
        </TextBlock>
        <TextBlock FontSize="11"
                   Foreground="{DynamicResource ThemeTextPrimaryBrush}">
          <Run Text="{Binding DateLabel}" />
          <Run x:Name="TargetDateText"
               Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
        </TextBlock>
        <TextBlock x:Name="TargetPathBlock"
                   FontSize="11"
                   Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <!-- Row 2: Buttons -->
    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,10,0,0">
      <Button x:Name="OverwriteBtn"
              MinWidth="80"
              Padding="6,4"
              Margin="0,0,6,0"
              Click="Overwrite_Click">
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center">
          <TextBlock Text="🔄"
                     FontSize="24"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding OverwriteText}"
                     FontSize="11"
                     HorizontalAlignment="Center"
                     Margin="0,2,0,0" />
        </StackPanel>
      </Button>
      <Button x:Name="RenameBtn"
              MinWidth="80"
              Padding="6,4"
              Margin="6,0,6,0"
              Click="Rename_Click">
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center">
          <TextBlock Text="✏️"
                     FontSize="24"
                     HorizontalAlignment="Center" />
          <TextBlock x:Name="RenameBtnLabel"
                     Text="{Binding RenameText}"
                     FontSize="11"
                     HorizontalAlignment="Center"
                     Margin="0,2,0,0" />
        </StackPanel>
      </Button>
      <Button MinWidth="80"
              Padding="6,4"
              Margin="6,0,6,0"
              Click="Skip_Click">
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center">
          <TextBlock Text="⏭️"
                     FontSize="24"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding SkipText}"
                     FontSize="11"
                     HorizontalAlignment="Center"
                     Margin="0,2,0,0" />
        </StackPanel>
      </Button>
      <Button MinWidth="80"
              Padding="6,4"
              Margin="6,0,0,0"
              Click="Cancel_Click">
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Center">
          <TextBlock Text="❌"
                     FontSize="24"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding CancelText}"
                     FontSize="11"
                     HorizontalAlignment="Center"
                     Margin="0,2,0,0" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Row 3: Custom rename input -->
    <TextBox Grid.Row="3"
             x:Name="RenameTextBox"
             FontSize="12"
             Padding="3,2"
             Margin="14,8,14,0"
             PlaceholderText="{Binding RenameHint}" />

    <!-- Row 4: Apply to all -->
    <CheckBox Grid.Row="4"
              x:Name="ApplyAllCheck"
              Content="{Binding ApplyAllText}"
              FontSize="12"
              Foreground="{DynamicResource ThemeTextSecondaryBrush}"
              HorizontalAlignment="Center"
              Margin="0,8,0,0" />
  </Grid>
</Window>
