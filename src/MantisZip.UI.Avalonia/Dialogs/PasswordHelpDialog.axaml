<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MantisZip.UI.Avalonia.Dialogs.PasswordHelpDialog"
        x:CompileBindings="False"
        Title="{Binding WinTitle}"
        Width="560"
        Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBgBrush}"
        Padding="16">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" Spacing="20">

      <!-- 简介 -->
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding SectionTitle}"
                   FontSize="18"
                   FontWeight="Bold" />
        <TextBlock Text="{Binding IntroText}"
                   TextWrapping="Wrap"
                   LineHeight="22" />
      </StackPanel>

      <!-- Glob 匹配 -->
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding GlobTitle}"
                   FontSize="15"
                   FontWeight="SemiBold" />
        <Border Background="{DynamicResource ThemeSurfaceBgBrush}"
                CornerRadius="4"
                Padding="14"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1">
          <StackPanel Spacing="8">
            <!-- Glob table header -->
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="{Binding GlobColWildcard}"
                         FontWeight="Bold"
                         Width="120" />
              <TextBlock Grid.Column="1"
                         Text="{Binding GlobColMeaning}"
                         FontWeight="Bold" />
            </Grid>
            <!-- Glob table rows -->
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="  *"
                         FontFamily="Consolas"
                         Foreground="{DynamicResource ThemeAccentBrush}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding GlobMatchAny}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="  ?"
                         FontFamily="Consolas"
                         Foreground="{DynamicResource ThemeAccentBrush}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding GlobMatchSingle}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="  ."
                         FontFamily="Consolas"
                         Foreground="{DynamicResource ThemeAccentBrush}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding GlobMatchDot}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="{Binding GlobOtherChars}"
                         FontFamily="Consolas"
                         Foreground="{DynamicResource ThemeAccentBrush}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding GlobMatchLiteral}" />
            </Grid>

            <!-- Glob Examples -->
            <TextBlock Text="{Binding GlobExamplesTitle}"
                       FontWeight="SemiBold"
                       Margin="0,4,0,0" />
            <Border Background="{DynamicResource ThemeWindowBgBrush}"
                    CornerRadius="4"
                    Padding="10"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1">
              <StackPanel Spacing="4">
                <TextBlock FontFamily="Consolas" FontSize="13">
                  <Run FontWeight="Bold"
                       Foreground="{DynamicResource ThemeAccentBrush}"
                       Text="*.zip" />
                  <Run Text="  →  " />
                  <Run Text="{Binding GlobExAllZip}" />
                </TextBlock>
                <TextBlock FontFamily="Consolas" FontSize="13">
                  <Run FontWeight="Bold"
                       Foreground="{DynamicResource ThemeAccentBrush}"
                       Text="{Binding GlobExDocStar}" />
                  <Run Text="  →  " />
                  <Run Text="{Binding GlobExDocStarDesc}" />
                </TextBlock>
                <TextBlock FontFamily="Consolas" FontSize="13">
                  <Run FontWeight="Bold"
                       Foreground="{DynamicResource ThemeAccentBrush}"
                       Text="???.zip" />
                  <Run Text="  →  " />
                  <Run Text="{Binding GlobExThreeChars}" />
                </TextBlock>
                <TextBlock FontFamily="Consolas" FontSize="13">
                  <Run FontWeight="Bold"
                       Foreground="{DynamicResource ThemeAccentBrush}"
                       Text="{Binding GlobExBackup}" />
                  <Run Text="  →  " />
                  <Run Text="{Binding GlobExBackupDesc}" />
                </TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Regex 匹配 -->
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding RegexTitle}"
                   FontSize="15"
                   FontWeight="SemiBold" />
        <Border Background="{DynamicResource ThemeSurfaceBgBrush}"
                CornerRadius="4"
                Padding="14"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1">
          <StackPanel Spacing="8">
            <!-- Regex common symbols -->
            <TextBlock Text="{Binding RegexCommonTitle}"
                       FontWeight="SemiBold" />
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="  \d"
                         FontFamily="Consolas"
                         Foreground="{DynamicResource ThemeAccentBrush}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding RegexDigit}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="  \w"
                         FontFamily="Consolas"
                         Foreground="{DynamicResource ThemeAccentBrush}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding RegexWord}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="  [a-z]"
                         FontFamily="Consolas"
                         Foreground="{DynamicResource ThemeAccentBrush}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding RegexCharSet}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="  ^...$"
                         FontFamily="Consolas"
                         Foreground="{DynamicResource ThemeAccentBrush}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding RegexAnchors}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="  |"
                         FontFamily="Consolas"
                         Foreground="{DynamicResource ThemeAccentBrush}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding RegexOr}" />
            </Grid>

            <!-- Regex examples -->
            <TextBlock Text="{Binding RegexExamplesTitle}"
                       FontWeight="SemiBold"
                       Margin="0,4,0,0" />
            <Border Background="{DynamicResource ThemeWindowBgBrush}"
                    CornerRadius="4"
                    Padding="10"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1">
              <StackPanel Spacing="4">
                <TextBlock FontFamily="Consolas" FontSize="13">
                  <Run FontWeight="Bold"
                       Foreground="{DynamicResource ThemeAccentBrush}"
                       Text="{Binding RegexExFinance}" />
                  <Run Text="  →  " />
                  <Run Text="{Binding RegexExFinanceDesc}" />
                </TextBlock>
                <TextBlock FontFamily="Consolas" FontSize="13">
                  <Run FontWeight="Bold"
                       Foreground="{DynamicResource ThemeAccentBrush}"
                       Text="\.rar$" />
                  <Run Text="  →  " />
                  <Run Text="{Binding RegexExRar}" />
                </TextBlock>
                <TextBlock FontFamily="Consolas" FontSize="13">
                  <Run FontWeight="Bold"
                       Foreground="{DynamicResource ThemeAccentBrush}"
                       Text="202[0-9]\.zip" />
                  <Run Text="  →  " />
                  <Run Text="{Binding RegexExYear}" />
                </TextBlock>
                <TextBlock FontFamily="Consolas" FontSize="13">
                  <Run FontWeight="Bold"
                       Foreground="{DynamicResource ThemeAccentBrush}"
                       Text="{Binding RegexExProject}" />
                  <Run Text="  →  " />
                  <Run Text="{Binding RegexExProjectDesc}" />
                </TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 匹配顺序 -->
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding MatchTitle}"
                   FontSize="15"
                   FontWeight="SemiBold" />
        <Border Background="{DynamicResource ThemeSurfaceBgBrush}"
                CornerRadius="4"
                Padding="14"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1">
          <TextBlock TextWrapping="Wrap"
                     LineHeight="22">
            <Run Text="{Binding MatchStep1}" /><LineBreak />
            <Run Text="{Binding MatchStep2}" /><LineBreak />
            <Run Text="{Binding MatchStep3}" /><LineBreak />
            <Run Text="{Binding MatchStep4}" /><LineBreak />
            <Run Text="{Binding MatchStep5}" />
          </TextBlock>
        </Border>
      </StackPanel>

      <!-- 关闭按钮 -->
      <Button Content="{Binding CloseText}"
              HorizontalAlignment="Right"
              Width="100"
              Height="28"
              IsDefault="True"
              Click="OnCloseClick"
              Background="{DynamicResource ThemeAccentBrush}"
              Foreground="White"
              Margin="0,0,0,12" />
    </StackPanel>
  </ScrollViewer>
</Window>
