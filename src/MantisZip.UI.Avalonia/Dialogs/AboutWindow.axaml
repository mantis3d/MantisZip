<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MantisZip.UI.Avalonia.Dialogs.AboutWindow"
        x:CompileBindings="False"
        Title="{Binding LocalizedStrings[About_Title]}"
        Width="400"
        Height="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBgBrush}"
        Padding="16">

  <Grid Margin="24">
    <StackPanel VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Spacing="12">
      <!-- App icon placeholder -->
      <Border Width="64"
              Height="64"
              CornerRadius="14"
              Background="{DynamicResource ThemeAccentBrush}"
              HorizontalAlignment="Center">
        <TextBlock Text="MZ"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>

      <!-- App name -->
      <TextBlock Text="MantisZip"
                 FontSize="24"
                 FontWeight="Bold"
                 HorizontalAlignment="Center" />

      <!-- Version -->
      <TextBlock Text="{Binding VersionText}"
                 FontSize="14"
                 Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                 HorizontalAlignment="Center" />

      <!-- Tech stack -->
      <TextBlock Text="{Binding LocalizedStrings[About_Technology]}"
                 FontSize="12"
                 Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 HorizontalAlignment="Center" />

      <!-- License link -->
      <Button Content="{Binding LocalizedStrings[About_License]}"
              HorizontalAlignment="Center"
              Background="Transparent"
              Foreground="{DynamicResource ThemeAccentBrush}"
              BorderThickness="0"
              Cursor="Hand"
              Click="OnLicenseClick">
      </Button>

      <!-- Close button -->
      <Button Content="{Binding LocalizedStrings[About_Close]}"
              HorizontalAlignment="Center"
              Width="100"
              Padding="8,6"
              Click="OnCloseClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
      </Button>
    </StackPanel>
  </Grid>
</Window>
