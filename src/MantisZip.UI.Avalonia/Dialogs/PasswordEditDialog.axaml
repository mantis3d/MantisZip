<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MantisZip.UI.Avalonia.Dialogs.PasswordEditDialog"
        x:CompileBindings="False"
        Title="{Binding WinTitle}"
        Width="500"
        Height="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBgBrush}"
        Padding="{DynamicResource SpacingMdThk}">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto"
        Margin="20">

    <!-- Row 0: Password label -->
    <TextBlock Grid.Row="0"
               Text="{Binding PwdLabel}"
               Margin="0,0,0,4"
               Foreground="{DynamicResource ThemeTextPrimaryBrush}" />

    <!-- Row 1: Password TextBox -->
    <TextBox Grid.Row="1"
             x:Name="PasswordBox"
             FontSize="14"
             Padding="8,6" />

    <!-- Row 2: Description label -->
    <TextBlock Grid.Row="2"
               Text="{Binding DescLabel}"
               Margin="0,12,0,4"
               Foreground="{DynamicResource ThemeTextPrimaryBrush}" />

    <!-- Row 3: Description TextBox -->
    <TextBox Grid.Row="3"
             x:Name="DescriptionBox"
             FontSize="14"
             Padding="8,6" />

    <!-- Row 4: Rules label -->
    <TextBlock Grid.Row="4"
               Text="{Binding RulesLabel}"
               Margin="0,12,0,4"
               Foreground="{DynamicResource ThemeTextPrimaryBrush}" />

    <!-- Row 5: Rules multi-line TextBox -->
    <Border Grid.Row="5"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="1"
            CornerRadius="2"
            Margin="0,0,0,12">
      <TextBox x:Name="PatternsBox"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               Padding="8,6"
               Background="{DynamicResource ThemeWindowBgBrush}"
               Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
    </Border>

    <!-- Row 6: Save + Cancel buttons -->
    <StackPanel Grid.Row="6"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="{DynamicResource SpacingXs}">
      <Button Content="{Binding SaveText}"
              Width="80"
              Height="{DynamicResource ControlHeight}"
              IsDefault="True"
              Click="OnSaveClick"
              Background="{DynamicResource ThemeAccentBrush}"
              Foreground="White" />
      <Button Content="{Binding CancelText}"
              Width="80"
              Height="{DynamicResource ControlHeight}"
              IsCancel="True"
              Click="OnCancelClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}" />
    </StackPanel>
  </Grid>
</Window>
