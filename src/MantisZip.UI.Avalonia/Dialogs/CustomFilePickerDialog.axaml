<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MantisZip.UI.Avalonia.Controls"
        x:Class="MantisZip.UI.Avalonia.Dialogs.CustomFilePickerDialog"
        x:CompileBindings="False"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource ThemeWindowBgBrush}">

  <!-- ══════════════════════════════════════════════════════════════════════
       文件选择器壳层（薄）：只保留
         ① 窗口标题栏（Title 由代码后台按 PickerMode 设置）
         ② 内嵌的选择器控件 controls:CustomFilePickerControl（地址栏 / 浏览 / 参数区等全部逻辑）
         ③ 底部「确定 / 取消」按钮行
         ④ 「系统浏览」原生逃生通道：按钮元素在选择器控件的地址行内，点击经
            SystemBrowseRequested 事件上抛，本窗口的 SystemBrowse_Click 完成原生
            StorageProvider 调用（规则 15 唯一豁免点，必须留在本文件）。
       ══════════════════════════════════════════════════════════════════════ -->
  <Grid RowDefinitions="*,Auto"
        Margin="{DynamicResource SpacingMdThk}">

    <!-- 选择器主体：自包含控件（DataContext 为其自身，内部全部绑定走控件属性） -->
    <controls:CustomFilePickerControl x:Name="Picker"
                                      Grid.Row="0" />

    <!-- ═══════ 底部：确定 / 取消（窗口级按钮，不属于选择器本身） ═══════ -->
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="{DynamicResource SpacingXs}"
                Margin="0,12,0,0">
      <!-- 确定：主色按钮 -->
      <Button x:Name="OkButton"
              Content="{Binding OkText}"
              MinWidth="96"
              MinHeight="{DynamicResource ControlHeightMd}"
              Click="Ok_Click"
              Background="{DynamicResource ThemeAccentBrush}"
              Foreground="{DynamicResource ThemeTextOnAccentBrush}"
              BorderThickness="0" />
      <!-- 取消：次要按钮 -->
      <Button x:Name="CancelButton"
              Content="{Binding CancelText}"
              MinWidth="96"
              MinHeight="{DynamicResource ControlHeightMd}"
              Click="Cancel_Click"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}" />
    </StackPanel>
  </Grid>
</Window>
