<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MantisZip.UI.Avalonia.Controls"
        xmlns:dialogs="clr-namespace:MantisZip.UI.Avalonia.Dialogs"
        x:Class="MantisZip.UI.Avalonia.Dialogs.CustomFilePickerDialog"
        x:CompileBindings="False"
        Width="900"
        Height="700"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource ThemeWindowBgBrush}">

  <Grid x:Name="RootGrid"
        RowDefinitions="Auto,*,Auto,Auto"
        Margin="{DynamicResource SpacingMdThk}">

    <!-- ═══════ Row 0: 地址栏 + 导航按钮 ═══════ -->
    <Grid Grid.Row="0"
          ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
          ColumnSpacing="{DynamicResource SpacingXxs}"
          Margin="0,0,0,8">
      <!-- 后退按钮 -->
      <Button x:Name="BackButton"
              Width="32"
              MinHeight="{DynamicResource ControlHeightSm}"
              Click="Back_Click"
              ToolTip.Tip="{Binding BackText}"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
        <PathIcon Data="{StaticResource IconChevronLeft}"
                  Width="14"
                  Height="14"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
      </Button>
      <!-- 前进按钮 -->
      <Button Grid.Column="1"
              x:Name="ForwardButton"
              Width="32"
              MinHeight="{DynamicResource ControlHeightSm}"
              Click="Forward_Click"
              ToolTip.Tip="{Binding ForwardText}"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
        <PathIcon Data="{StaticResource IconChevronRight}"
                  Width="14"
                  Height="14"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
      </Button>
      <!-- 向上一级目录按钮 -->
      <Button Grid.Column="2"
              x:Name="UpButton"
              Width="32"
              MinHeight="{DynamicResource ControlHeightSm}"
              Click="Up_Click"
              ToolTip.Tip="{Binding UpText}"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
        <PathIcon Data="{StaticResource IconArrowUp}"
                  Width="14"
                  Height="14"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
      </Button>
      <!-- 系统浏览按钮（打开系统文件夹选择器） -->
      <Button Grid.Column="3"
              x:Name="SystemBrowseButton"
              Width="32"
              MinHeight="{DynamicResource ControlHeightSm}"
              Click="SystemBrowse_Click"
              ToolTip.Tip="{Binding BrowseSystemTooltip}"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
        <PathIcon Data="{StaticResource IconFolder}"
                  Width="14"
                  Height="14"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
      </Button>
      <!-- 路径输入框（支持自动补全） -->
      <AutoCompleteBox Grid.Column="4"
                       x:Name="PathAutoComplete"
                       MinHeight="{DynamicResource ControlHeightSm}"
                       FilterMode="Contains"
                       MinimumPrefixLength="0"
                       KeyDown="PathAutoComplete_KeyDown"
                       Background="{DynamicResource ThemeSurfaceBgBrush}"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       BorderBrush="{DynamicResource ThemeBorderBrush}" />
      <!-- 添加收藏按钮 -->
      <Button Grid.Column="5"
              x:Name="AddFavoriteButton"
              Width="32"
              MinHeight="{DynamicResource ControlHeightSm}"
              Click="AddFavorite_Click"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
        <PathIcon Data="{StaticResource IconBookmarkAdd}"
                  Width="14"
                  Height="14"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
      </Button>
    </Grid>

    <!-- ═══════ Row 1: 左侧快速路径 | 中间文件浏览器 | 右侧面板 ═══════ -->
    <Grid x:Name="BrowserGrid"
          Grid.Row="1"
          ColumnSpacing="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- 左侧：快速路径面板（收藏夹、历史、驱动器等） -->
      <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="6"
              Background="{DynamicResource ThemeSurfaceBgBrush}">
        <controls:QuickPathControl x:Name="QuickPath"
                                   PathSelected="QuickPath_PathSelected" />
      </Border>

      <!-- 分割器：左侧面板宽度可调 -->
      <GridSplitter Grid.Column="1"
                    Width="5"
                    Background="{DynamicResource ThemeSplitterBgBrush}"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Auto" />

      <!-- 中间：文件/目录列表区域 -->
      <Border Grid.Column="2"
              BorderBrush="{DynamicResource ThemeBorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Background="{DynamicResource ThemeSurfaceBgBrush}">
        <Grid RowDefinitions="Auto,*">
          <!-- 当前路径显示 -->
          <TextBlock x:Name="CurrentPathText"
                     Grid.Row="0"
                     Margin="8,6"
                     FontSize="11"
                     Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                     TextTrimming="CharacterEllipsis" />
          <!-- 文件/目录列表 -->
          <ListBox x:Name="FileList"
                   Grid.Row="1"
                   Background="Transparent"
                   BorderThickness="0"
                   SelectionMode="Multiple"
                   SelectionChanged="FileList_SelectionChanged"
                   DoubleTapped="FileList_DoubleTapped"
                   KeyDown="FileList_KeyDown">
            <ListBox.ItemContainerTheme>
              <ControlTheme TargetType="ListBoxItem">
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeightMd}" />
                <Setter Property="Padding" Value="{DynamicResource SpacingXxsThk}" />
                <!-- 悬停高亮 -->
                <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource ThemeTabHoverBrush}" />
                </Style>
                <!-- 选中高亮 -->
                <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource ThemeListSelectedBrush}" />
                </Style>
                <!-- 选中+悬停高亮 -->
                <Style Selector="^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource ThemeListSelectedBrush}" />
                </Style>
              </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <!-- Background=Transparent：让整行参与命中测试，点击行内任意位置均可选中 -->
                <Grid ColumnDefinitions="24,20,*,80,110" Background="Transparent">
                  <!-- 复选框：用于多选，仅当 CanCheck=true 时显示 -->
                  <CheckBox Grid.Column="0"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            IsVisible="{Binding CanCheck}"
                            VerticalAlignment="Center" />
                  <!-- 文件/文件夹图标 -->
                  <Image Grid.Column="1"
                         Source="{Binding Icon}"
                         Width="16"
                         Height="16"
                         VerticalAlignment="Center" />
                  <!-- 名称 + 子文本（类型/大小等） -->
                  <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="0">
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SubText}"
                               FontSize="10"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding ShowSubText}" />
                  </StackPanel>
                  <!-- 文件大小 -->
                  <TextBlock Grid.Column="3"
                             Text="{Binding SizeText}"
                             FontSize="11"
                             HorizontalAlignment="Right"
                             Margin="0,0,8,0"
                             Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                             VerticalAlignment="Center" />
                  <!-- 修改时间 -->
                  <TextBlock Grid.Column="4"
                             Text="{Binding ModifiedText}"
                             FontSize="11"
                             HorizontalAlignment="Right"
                             Margin="0,0,4,0"
                             Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- 分割器：右侧面板宽度可调 -->
      <GridSplitter x:Name="RightSplitter"
                    Grid.Column="3"
                    Width="5"
                    Background="{DynamicResource ThemeSplitterBgBrush}"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Auto" />

      <!-- ═══════ 右侧面板：PickItems 累积选择 / ExtractFolder 解压预览 ═══════ -->
      <!-- 宽度：由 MinWidth/MaxWidth 约束 + Stretch 填满列，随 RightSplitter 拖拽实时变化 -->
      <Grid x:Name="PickItemsPanel"
            Grid.Row="1"
            Grid.Column="4"
            MinWidth="200"
            MaxWidth="800"
            Margin="12,0,0,0"
            IsVisible="False">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 标题：已选择的项目 -->
        <TextBlock Grid.Row="0"
                   x:Name="PickTitleText"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
        <!-- 操作按钮行：添加选中项、移除选中项 -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource SpacingXs}"
                    Margin="0,8,0,0">
          <Button x:Name="AddSelectedButton"
                  MinHeight="{DynamicResource ControlHeightSm}"
                  Padding="10,0"
                  Click="AddSelected_Click"
                  Background="{DynamicResource ThemeButtonBgBrush}"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                  BorderBrush="{DynamicResource ThemeBorderBrush}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <PathIcon Data="{StaticResource IconAdd}" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock x:Name="AddSelectedButtonText" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="RemoveSelectedButton"
                  MinHeight="{DynamicResource ControlHeightSm}"
                  Padding="10,0"
                  Click="RemoveSelected_Click"
                  IsEnabled="False"
                  Background="{DynamicResource ThemeButtonBgBrush}"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                  BorderBrush="{DynamicResource ThemeBorderBrush}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <PathIcon Data="{StaticResource IconSubtract}" Width="16" Height="16" VerticalAlignment="Center" />
              <TextBlock x:Name="RemoveSelectedButtonText" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <!-- 统计信息：已累积的项目数量 -->
        <TextBlock Grid.Row="2"
                   x:Name="PickActionCountText"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
        <!-- 清空累积列表按钮 -->
        <Button Grid.Row="3"
                x:Name="ClearAccumulatedButton"
                Margin="0,4,0,0"
                HorizontalAlignment="Left"
                MinHeight="{DynamicResource ControlHeightSm}"
                Padding="10,0"
                Click="ClearAccumulated_Click"
                Background="{DynamicResource ThemeButtonBgBrush}"
                Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <PathIcon Data="{StaticResource IconDismiss}" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock x:Name="ClearAccumulatedButtonText" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <!-- 空状态提示文本 -->
        <TextBlock Grid.Row="4"
                   x:Name="PickEmptyText"
                   Margin="0,12,0,0"
                   Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
        <!-- 累积项目列表 -->
        <Border Grid.Row="5"
                Margin="0,8,0,0"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6"
                Background="{DynamicResource ThemeSurfaceBgBrush}">
          <ItemsControl x:Name="AccumulatedItemsControl">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto"
                      MinHeight="{DynamicResource ControlHeightSm}">
                  <TextBlock Text="{Binding Path}"
                             TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Path}"
                             Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                             VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          Content="×"
                          Width="24"
                          Height="24"
                          Padding="0"
                          Margin="4,0,0,0"
                          Tag="{Binding Path}"
                          ToolTip.Tip="{Binding Path}"
                          Click="RemoveItem_Click"
                          Background="{DynamicResource ThemeButtonBgBrush}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </Grid>

      <!-- 解压预览面板（ExtractFolder 模式） -->
      <Grid x:Name="ExtractFolderPanel"
            Grid.Row="1"
            Grid.Column="4"
            MinWidth="200"
            MaxWidth="800"
            Margin="12,0,0,0"
            IsVisible="False">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 预览标题 -->
        <TextBlock Grid.Row="0"
                   x:Name="ExtractPreviewTitleText"
                   FontWeight="SemiBold"
                   Text="{Binding ExtractPreviewTitle}"
                   Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
        <!-- 分割器：可调整预览树高度 -->
        <GridSplitter x:Name="PreviewSplitter"
                      Grid.Row="1"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource ThemeSplitterBgBrush}"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Auto" />
        <!-- 结果预览树（紧凑模式） -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6"
                Background="{DynamicResource ThemeSurfaceBgBrush}">
          <controls:ResultTreeView x:Name="PreviewTree"
                                   CompactMode="True"
                                   MaxItemsPerDirectory="8"
                                   MaxDepth="4"
                                   ShowFilteredGhosts="False" />
        </Border>
      </Grid>
    </Grid>

    <!-- ═══════ Row 2: 文件名 + 文件类型（保存/打开模式） ═══════ -->
    <Grid x:Name="FileNameArea"
          Grid.Row="2"
          ColumnDefinitions="60,*,60,110"
          ColumnSpacing="{DynamicResource SpacingXs}"
          Margin="0,12,0,0">
      <!-- 文件名标签 -->
      <TextBlock Text="{Binding FileNameLabel}"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
      <!-- 文件名输入框 -->
      <TextBox Grid.Column="1"
               x:Name="FileNameBox"
               MinHeight="{DynamicResource ControlHeightSm}"
               TextChanged="FileNameBox_TextChanged"
               Background="{DynamicResource ThemeSurfaceBgBrush}"
               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
               BorderBrush="{DynamicResource ThemeBorderBrush}" />
      <!-- 文件类型标签 -->
      <TextBlock Grid.Column="2"
                 Text="{Binding FileTypeLabel}"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
      <!-- 文件类型下拉选择器 -->
      <ComboBox Grid.Column="3"
                x:Name="FileTypeSelector"
                MinHeight="{DynamicResource ControlHeightSm}"
                SelectionChanged="FileTypeSelector_SelectionChanged"
                Background="{DynamicResource ThemeSurfaceBgBrush}"
                Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" />
    </Grid>

    <!-- ═══════ Row 3: 确定/取消按钮 ═══════ -->
    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="{DynamicResource SpacingXs}"
                Margin="0,12,0,0">
      <Button x:Name="OkButton"
              Content="{Binding OkText}"
              MinWidth="96"
              MinHeight="{DynamicResource ControlHeightMd}"
              Click="Ok_Click"
              Background="{DynamicResource ThemeAccentBrush}"
              Foreground="{DynamicResource ThemeTextOnAccentBrush}"
              BorderThickness="0" />
      <Button x:Name="CancelButton"
              Content="{Binding CancelText}"
              MinWidth="96"
              MinHeight="{DynamicResource ControlHeightMd}"
              Click="Cancel_Click"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}" />
    </StackPanel>
  </Grid>
</Window>
