<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MantisZip.UI.Avalonia.Converters"
        xmlns:controls="clr-namespace:MantisZip.UI.Avalonia.Controls"
        x:Class="MantisZip.UI.Avalonia.Dialogs.CompressSettingsWindow"
        x:CompileBindings="False"
        Title="{Binding WindowTitle}"
        Width="550"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource ThemeWindowBgBrush}">

  <Window.Resources>
    <conv:BoolInvertConverter x:Key="BoolInvertConverter" />
  </Window.Resources>

  <Grid RowDefinitions="*,Auto"
        Margin="16">
    <!-- === Tabbed content === -->
    <TabControl Grid.Row="0">
      <!-- Tab 1: General -->
      <TabItem Header="{Binding LocalizedStrings[Compress_TabGeneral]}"
               Classes="compactTab">
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}"
                       TextElement.Foreground="{DynamicResource ThemeTextPrimaryBrush}">
          <StackPanel Spacing="12"
                       Margin="0,8,0,0">
            <!-- Group: Source files (first, like WPF) -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12"
                    Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding LocalizedStrings[Compress_SourceFiles]}"
                           FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="{Binding LocalizedStrings[Compress_AddFile]}"
                          Height="26" Padding="8,0"
                          Command="{Binding AddFilesCommand}"
                          Background="{DynamicResource ThemeButtonBgBrush}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}" />
                  <Button Content="{Binding LocalizedStrings[Compress_AddFolder]}"
                          Height="26" Padding="8,0"
                          Command="{Binding AddFolderCommand}"
                          Background="{DynamicResource ThemeButtonBgBrush}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}" />
                  <Button Content="{Binding LocalizedStrings[Compress_Remove]}"
                          Height="26" Padding="8,0"
                          Command="{Binding RemoveSelectedCommand}"
                          CommandParameter="{Binding SelectedItem, ElementName=SourceFilesList}"
                          Background="{DynamicResource ThemeButtonBgBrush}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}" />
                </StackPanel>
                <ListBox x:Name="SourceFilesList"
                         ItemsSource="{Binding SelectedPaths}"
                         MinHeight="80" MaxHeight="160"
                         BorderBrush="{DynamicResource ThemeBorderBrush}"
                         Background="{DynamicResource ThemeSurfaceBgBrush}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding SelectedPathsSummary}"
                           FontSize="12"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
              </StackPanel>
            </Border>

            <!-- Group: Compression options (Format + Level + Output path combined) -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12"
                    Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding LocalizedStrings[Compress_Archive_Group]}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding LocalizedStrings[Compress_Format]}"
                           FontSize="12"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding FormatOptions}"
                          SelectedItem="{Binding DefaultFormat}" />

                <TextBlock Text="{Binding LocalizedStrings[Compress_Level]}"
                           FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto">
                  <Slider Grid.Column="0"
                          Minimum="1"
                          Maximum="9"
                          TickFrequency="1"
                          IsSnapToTickEnabled="True"
                          Value="{Binding CompressionLevel}" />
                  <TextBlock Grid.Column="1"
                              Text="{Binding CompressionLevel}"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              FontWeight="Bold" />
                </Grid>

                <TextBlock Text="{Binding LocalizedStrings[Compress_OutputPath]}"
                           FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0"
                            PlaceholderText="{Binding LocalizedStrings[Compress_OutputPlaceholder]}"
                            Text="{Binding OutputPath}" />
                  <Button Grid.Column="1"
                          Content="{Binding LocalizedStrings[Compress_Browse]}"
                          Width="80"
                          Height="28"
                          Margin="8,0,0,0"
                          Command="{Binding BrowseOutputPathCommand}"
                          Background="{DynamicResource ThemeButtonBgBrush}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}" />
                </Grid>

                <!-- Format-specific advanced options (ZIP encoding, 7z method/solid) -->
                <controls:DynamicFormatOptionsPanel x:Name="FormatOptionsPanel"
                                                    SelectedFormat="{Binding DefaultFormat}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab 2: Password -->
      <TabItem Header="{Binding LocalizedStrings[Compress_TabPassword]}"
               Classes="compactTab">
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}"
                       TextElement.Foreground="{DynamicResource ThemeTextPrimaryBrush}">
          <StackPanel Spacing="12"
                       Margin="0,8,0,0">
            <!-- Group: Password mode -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12"
                    Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding LocalizedStrings[Compress_TabPassword]}"
                           FontWeight="SemiBold" />
                <RadioButton GroupName="PwdMode"
                              IsChecked="{Binding IsPasswordLibraryMode}">
                  <TextBlock Text="{Binding LocalizedStrings[Compress_Pwd_Library]}"
                              TextWrapping="Wrap" />
                </RadioButton>
                <RadioButton GroupName="PwdMode"
                              IsChecked="{Binding IsPasswordLibraryMode, Converter={StaticResource BoolInvertConverter}}">
                  <TextBlock Text="{Binding LocalizedStrings[Compress_Pwd_NewPassword]}"
                              TextWrapping="Wrap" />
                </RadioButton>
              </StackPanel>
            </Border>

            <!-- Group: Password library (visible in library mode) -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12"
                    Background="{DynamicResource ThemeSurfaceBgBrush}"
                    IsVisible="{Binding IsPasswordLibraryMode}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding LocalizedStrings[Compress_Pwd_Library]}"
                           FontWeight="SemiBold" />
                <!-- Search -->
                <TextBox PlaceholderText="{Binding LocalizedStrings[Compress_Pwd_Search]}"
                          Text="{Binding PasswordSearchText}" />

                <!-- Password list -->
                <ListBox ItemsSource="{Binding FilteredPasswordEntries}"
                          SelectedItem="{Binding SelectedPasswordEntry}"
                          MinHeight="100"
                          MaxHeight="200"
                          BorderBrush="{DynamicResource ThemeBorderBrush}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="{Binding Description}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        <TextBlock Text="{Binding PatternsDisplay}"
                                    FontSize="11"
                                    Opacity="0.6"
                                    Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <!-- No entry hint -->
                <TextBlock Text="{Binding LocalizedStrings[Compress_Pwd_NoEntry]}"
                            Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                            FontSize="12"
                            FontStyle="Italic" />
              </StackPanel>
            </Border>

            <!-- Group: New password (visible in new password mode) -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12"
                    Background="{DynamicResource ThemeSurfaceBgBrush}"
                    IsVisible="{Binding IsPasswordLibraryMode, Converter={StaticResource BoolInvertConverter}}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding LocalizedStrings[Compress_Pwd_NewPassword]}"
                           FontWeight="SemiBold" />
                <!-- New password -->
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0"
                            x:Name="PasswordTextBox"
                            PlaceholderText="{Binding LocalizedStrings[Compress_PasswordPlaceholder]}"
                            Text="{Binding Password}"
                            PasswordChar="●" />
                  <Button Grid.Column="1"
                          x:Name="RevealButton"
                          Content="{Binding LocalizedStrings[Compress_ShowPassword]}"
                          Width="60"
                          Height="28"
                          Margin="8,0,0,0"
                          Click="TogglePasswordReveal"
                          Background="{DynamicResource ThemeButtonBgBrush}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}" />
                </Grid>

                <!-- Confirm password -->
                <TextBlock Text="{Binding LocalizedStrings[Compress_Pwd_ConfirmPwd]}"
                           FontWeight="SemiBold" />
                <TextBox PlaceholderText="{Binding LocalizedStrings[Compress_ConfirmPlaceholder]}"
                          Text="{Binding ConfirmPassword}"
                          PasswordChar="●" />

                <!-- Password strength -->
                <StackPanel Orientation="Horizontal"
                             Spacing="6">
                  <TextBlock Text="{Binding LocalizedStrings[Compress_Strength]}"
                              Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                              FontSize="12" />
                  <TextBlock Text="{Binding PasswordStrength}"
                              FontWeight="Bold"
                              Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                  <TextBlock Text="{Binding PasswordStrengthIndicator}"
                              FontSize="14"
                              Foreground="{DynamicResource ThemeAccentBrush}" />
                </StackPanel>

                <!-- Match indicator -->
                <TextBlock x:Name="PasswordMatchIndicator"
                            FontSize="12"
                            IsVisible="False" />
              </StackPanel>
            </Border>

            <!-- Group: Password library settings (shared) -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12"
                    Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding LocalizedStrings[Compress_Pwd_SaveToLibrary]}"
                           FontWeight="SemiBold" />

                <!-- Save to library checkbox -->
                <CheckBox IsChecked="{Binding SaveToLibrary}">
                  <TextBlock Text="{Binding LocalizedStrings[Compress_Pwd_SaveToLibrary]}"
                              TextWrapping="Wrap" />
                </CheckBox>

                <!-- Description -->
                <TextBlock Text="{Binding LocalizedStrings[Compress_Pwd_Description]}"
                           FontWeight="SemiBold" />
                <TextBox PlaceholderText="{Binding LocalizedStrings[Compress_Pwd_DescWatermark]}"
                          Text="{Binding PasswordDescription}"
                          IsReadOnly="{Binding IsPasswordLibraryMode}" />

                <!-- Auto-generate rules -->
                <CheckBox IsChecked="{Binding AutoGenerateRules}"
                           IsEnabled="{Binding IsPasswordLibraryMode, Converter={StaticResource BoolInvertConverter}}">
                  <TextBlock Text="{Binding LocalizedStrings[Compress_Pwd_AutoRules]}"
                              TextWrapping="Wrap" />
                </CheckBox>

                <!-- Rules text -->
                <TextBlock Text="{Binding LocalizedStrings[Compress_Pwd_Rules]}"
                           FontWeight="SemiBold" />
                <TextBox Text="{Binding RulesText}"
                          PlaceholderText="{Binding LocalizedStrings[Compress_Pwd_RulesWatermark]}"
                          AcceptsReturn="True"
                          MinHeight="60"
                          TextWrapping="Wrap" />

                <!-- Encrypt archive -->
                <CheckBox IsChecked="{Binding Encrypt}">
                  <TextBlock Text="{Binding LocalizedStrings[Compress_EncryptArchive]}"
                              TextWrapping="Wrap" />
                </CheckBox>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab 3: Comment -->
      <TabItem Header="{Binding LocalizedStrings[Compress_TabComment]}"
               Classes="compactTab">
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}"
                       TextElement.Foreground="{DynamicResource ThemeTextPrimaryBrush}">
          <StackPanel Spacing="12"
                       Margin="0,8,0,0">
            <!-- Group: Comment content -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12"
                    Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding LocalizedStrings[Compress_TabComment]}"
                           FontWeight="SemiBold" />

                <!-- Hint -->
                <TextBlock Text="{Binding LocalizedStrings[Compress_CommentHint]}"
                            FontSize="12"
                            FontStyle="Italic"
                            Foreground="{DynamicResource ThemeTextSecondaryBrush}" />

                <!-- Comment text -->
                <TextBox PlaceholderText="{Binding LocalizedStrings[Compress_CommentPlaceholder]}"
                          Text="{Binding Comment}"
                          AcceptsReturn="True"
                          MinHeight="80"
                          TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- Group: Distribution -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12"
                    Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding LocalizedStrings[Compress_Distribution]}"
                           FontWeight="SemiBold" />
                <RadioButton GroupName="CommentDist"
                              IsChecked="{Binding CommentAllSame}">
                  <TextBlock Text="{Binding LocalizedStrings[Compress_Distribute_AllSame]}" TextWrapping="Wrap" />
                </RadioButton>
                <RadioButton GroupName="CommentDist"
                              IsChecked="{Binding CommentFirstOnly}">
                  <TextBlock Text="{Binding LocalizedStrings[Compress_Distribute_FirstOnly]}" TextWrapping="Wrap" />
                </RadioButton>
                <RadioButton GroupName="CommentDist"
                              IsChecked="{Binding CommentPerLine}">
                  <TextBlock Text="{Binding LocalizedStrings[Compress_Distribute_PerLine]}" TextWrapping="Wrap" />
                </RadioButton>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- === Bottom buttons === -->
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,16,0,0">
      <Button Content="{Binding LocalizedStrings[Compress_Start]}"
              Padding="16"
              Command="{Binding StartCompressCommand}"
              Background="{DynamicResource ThemeAccentBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderThickness="0" />
      <Button Content="{Binding LocalizedStrings[Compress_Cancel]}"
              Padding="16"
              Command="{Binding CancelCommand}"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}" />
    </StackPanel>
  </Grid>
</Window>
