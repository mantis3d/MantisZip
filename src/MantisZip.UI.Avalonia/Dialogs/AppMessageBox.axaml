<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MantisZip.UI.Avalonia.Dialogs.AppMessageBox"
        x:CompileBindings="False"
        Title="{Binding WinTitle}"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource ThemeWindowBgBrush}"
        Padding="{DynamicResource SpacingMdThk}">
  <Grid ColumnDefinitions="Auto,12,*"
        RowDefinitions="Auto,Auto"
        Margin="{DynamicResource SpacingMdThk}">

    <!-- 图标区域（根据消息类型显示不同图标，默认隐藏） -->
    <TextBlock Grid.Row="0" Grid.Column="0"
               x:Name="IconText"
               FontSize="32"
               VerticalAlignment="Top"
               IsVisible="False" />

    <!-- 消息文本区域 -->
    <TextBlock Grid.Row="0" Grid.Column="2"
               x:Name="MessageText"
               TextWrapping="Wrap"
               FontSize="13"
               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
               VerticalAlignment="Center" />

    <!-- 底部按钮面板（根据消息框类型动态显示不同按钮组合） -->
    <StackPanel Grid.Row="1" Grid.ColumnSpan="3"
                x:Name="ButtonPanel"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="{DynamicResource SpacingXs}"
                Margin="0,16,0,0">
      <!-- 自定义操作按钮（用于 ShowWithAction） -->
      <Button x:Name="ActionBtn"
              Width="110"
              Height="{DynamicResource ControlHeight}"
              IsVisible="False"
              Click="OnActionBtnClick"
              Background="{DynamicResource ThemeAccentBrush}"
              Foreground="White"
              BorderThickness="0" />
      <!-- 确定按钮 -->
      <Button x:Name="OkBtn"
              Content="{Binding OkText}"
              Width="80"
              Height="{DynamicResource ControlHeight}"
              IsVisible="False"
              Click="OnOkClick"
              Background="{DynamicResource ThemeAccentBrush}"
              Foreground="White"
              BorderThickness="0" />
      <!-- 取消按钮 -->
      <Button x:Name="CancelBtn"
              Content="{Binding CancelText}"
              Width="80"
              Height="{DynamicResource ControlHeight}"
              IsVisible="False"
              IsCancel="True"
              Click="OnCancelClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}" />
      <!-- 是按钮 -->
      <Button x:Name="YesBtn"
              Content="{Binding YesText}"
              Width="80"
              Height="{DynamicResource ControlHeight}"
              IsVisible="False"
              Click="OnYesClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}" />
      <!-- 否按钮 -->
      <Button x:Name="NoBtn"
              Content="{Binding NoText}"
              Width="80"
              Height="{DynamicResource ControlHeight}"
              IsVisible="False"
              Click="OnNoClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}" />
    </StackPanel>
  </Grid>
</Window>
