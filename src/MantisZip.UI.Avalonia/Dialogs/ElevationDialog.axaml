<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MantisZip.UI.Avalonia.Dialogs.ElevationDialog"
        x:CompileBindings="False"
        Title="{Binding WinTitle}"
        Width="480"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        CanResize="False"
        Background="{DynamicResource ThemeWindowBgBrush}"
        Padding="{DynamicResource SpacingMdThk}">

  <Grid RowDefinitions="Auto,Auto,Auto"
        Margin="{DynamicResource SpacingXsThk}">

    <!-- Row 0: Message -->
    <TextBlock Grid.Row="0"
               x:Name="MessageText"
               FontSize="13"
               FontWeight="SemiBold"
               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
               TextWrapping="Wrap" />

    <!-- Row 1: Directory list (only shown for multiple directories) -->
    <ItemsControl Grid.Row="1"
                  x:Name="DirectoryList"
                  Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                  FontSize="12"
                  IsVisible="False"
                  Margin="0,12,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}"
                     Margin="12,2,0,2"
                     TextWrapping="Wrap"
                     FontFamily="Consolas, Courier New, monospace" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Row 2: Hint + Buttons -->
    <StackPanel Grid.Row="2"
                Margin="0,16,0,0">
      <TextBlock Text="{Binding HintText}"
                 Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                 FontSize="11"
                 TextWrapping="Wrap"
                 Margin="0,0,0,16" />

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="{DynamicResource SpacingXs}">
        <Button Content="{Binding ElevateText}"
                Width="140"
                Height="{DynamicResource ControlHeightMd}"
                Click="Elevate_Click"
                IsDefault="True"
                Background="{DynamicResource ThemeAccentBrush}"
                Foreground="White" />
        <Button Content="{Binding CancelText}"
                Width="80"
                Height="{DynamicResource ControlHeightMd}"
                Click="Cancel_Click"
                IsCancel="True"
                Background="{DynamicResource ThemeButtonBgBrush}"
                Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
