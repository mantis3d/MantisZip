<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MantisZip.UI.Avalonia.Controls"
        x:Class="MantisZip.UI.Avalonia.Dialogs.ArchiveSaveAsDialog"
        x:CompileBindings="False"
        Title="{Binding WinTitle}"
        Width="530"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource ThemeWindowBgBrush}"
        Foreground="{DynamicResource ThemeTextPrimaryBrush}">
  <Grid Margin="15"
        RowDefinitions="Auto,*,Auto">

    <!-- Row 0: Format conversion hint -->
    <TextBlock x:Name="ConversionHintBlock"
               Grid.Row="0"
               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
               FontSize="12"
               TextWrapping="Wrap"
               Margin="0,0,0,12" />

    <!-- Row 1: Main settings area (scrollable) -->
    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">

        <!-- ── Output path ── -->
        <GroupBox Header="保存位置"
                  Background="{DynamicResource ThemeSurfaceBgBrush}"
                  BorderBrush="{DynamicResource ThemeBorderBrush}">
          <GroupBox.Styles>
            <Style Selector="GroupBox > :is(ContentControl) > TextBlock">
              <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
            </Style>
          </GroupBox.Styles>
          <Grid RowDefinitions="Auto,Auto"
                ColumnDefinitions="80,*">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="输出路径:"
                       VerticalAlignment="Center" />
            <controls:QuickPathControl x:Name="PathControl"
                                       Grid.Row="0" Grid.Column="1"
                                       IsFolderMode="False"
                                       IsFileOpenMode="False"
                                       FileTypeFilter="ZIP 文件|*.zip|7z 文件|*.7z|TAR.GZ 文件|*.tar.gz|所有文件|*.*"
                                       DefaultFileName="archive.zip" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="格式:"
                       VerticalAlignment="Center"
                       Margin="0,8,0,0" />
            <ComboBox x:Name="FormatComboBox"
                      Grid.Row="1" Grid.Column="1"
                      Height="24"
                      Margin="0,8,0,0"
                      SelectedIndex="0"
                      SelectionChanged="FormatComboBox_SelectionChanged"
                      Background="{DynamicResource ThemeSurfaceBgBrush}"
                      Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                      BorderBrush="{DynamicResource ThemeBorderBrush}">
              <ComboBoxItem Content="ZIP (.zip)" Tag="zip" />
              <ComboBoxItem Content="7z (.7z)" Tag="7z" />
              <ComboBoxItem Content="TAR.GZ (.tar.gz)" Tag="tar.gz" />
            </ComboBox>
          </Grid>
        </GroupBox>

        <!-- ── Format-specific options ── -->
        <GroupBox Header="格式选项"
                  Background="{DynamicResource ThemeSurfaceBgBrush}"
                  BorderBrush="{DynamicResource ThemeBorderBrush}">
          <controls:DynamicFormatOptionsPanel x:Name="FormatOptionsPanel" />
        </GroupBox>

        <!-- ── Encryption ── -->
        <GroupBox Header="加密"
                  Background="{DynamicResource ThemeSurfaceBgBrush}"
                  BorderBrush="{DynamicResource ThemeBorderBrush}">
          <StackPanel>
            <CheckBox x:Name="EncryptCheckBox"
                      Content="启用加密"
                      Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                      IsCheckedChanged="EncryptCheckBox_Changed" />
            <Grid x:Name="PasswordGrid"
                  IsEnabled="False"
                  Margin="20,8,0,0"
                  RowDefinitions="Auto,Auto"
                  ColumnDefinitions="80,*">
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="密码:"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBox Grid.Row="0" Grid.Column="1"
                       x:Name="PasswordBox"
                       Height="24"
                       PasswordChar="●"
                       Background="{DynamicResource ThemeSurfaceBgBrush}"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       BorderBrush="{DynamicResource ThemeBorderBrush}" />

              <TextBlock Grid.Row="1" Grid.Column="0"
                         Text="确认密码:"
                         VerticalAlignment="Center"
                         Margin="0,6,0,0"
                         Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBox Grid.Row="1" Grid.Column="1"
                       x:Name="ConfirmPasswordBox"
                       Height="24"
                       Margin="0,6,0,0"
                       PasswordChar="●"
                       Background="{DynamicResource ThemeSurfaceBgBrush}"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       BorderBrush="{DynamicResource ThemeBorderBrush}" />
            </Grid>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>

    <!-- Row 2: OK / Cancel buttons -->
    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="{DynamicResource SpacingXs}"
                Margin="0,12,0,0">
      <Button Content="确定"
              Width="80"
              Height="{DynamicResource ControlHeight}"
              IsDefault="True"
              Click="Ok_Click"
              Background="{DynamicResource ThemeAccentBrush}"
              Foreground="White"
              BorderThickness="0" />
      <Button Content="取消"
              Width="80"
              Height="{DynamicResource ControlHeight}"
              IsCancel="True"
              Click="Cancel_Click"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}" />
    </StackPanel>
  </Grid>
</Window>
