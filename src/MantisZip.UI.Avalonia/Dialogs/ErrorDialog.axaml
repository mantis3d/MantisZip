<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MantisZip.UI.Avalonia.Dialogs.ErrorDialog"
        x:CompileBindings="False"
        Title="{Binding WinTitle}"
        Width="420"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        CanResize="False"
        Background="{DynamicResource ThemeWindowBgBrush}"
        Padding="16">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto"
        Margin="8">

    <!-- Row 0: Header -->
    <TextBlock Grid.Row="0"
               x:Name="HeaderText"
               FontSize="13"
               FontWeight="SemiBold"
               TextWrapping="Wrap"
               Foreground="{DynamicResource ThemeTextPrimaryBrush}" />

    <!-- Row 1: Error message -->
    <TextBlock Grid.Row="1"
               x:Name="ErrorMsgText"
               TextWrapping="Wrap"
               FontSize="11"
               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
               Margin="0,8,0,0" />

    <!-- Row 2: Buttons -->
    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,14,0,0">
      <Button x:Name="RetryBtn"
              Width="72"
              Height="28"
              Content="{Binding RetryText}"
              Margin="0,0,6,0"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}"
              Click="Retry_Click" />
      <Button Width="72"
              Height="28"
              Content="{Binding SkipText}"
              Margin="6,0,6,0"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}"
              Click="Skip_Click" />
      <Button Width="72"
              Height="28"
              Content="{Binding AbortText}"
              Margin="6,0,0,0"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}"
              Click="Abort_Click" />
    </StackPanel>

    <!-- Row 3: Apply to all -->
    <CheckBox Grid.Row="3"
              x:Name="ApplyAllCheck"
              Content="{Binding ApplyAllText}"
              FontSize="12"
              Foreground="{DynamicResource ThemeTextSecondaryBrush}"
              HorizontalAlignment="Center"
              Margin="0,8,0,0" />
  </Grid>
</Window>
