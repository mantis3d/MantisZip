<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MantisZip.UI.Avalonia.Dialogs.AddAssocDialog"
        Width="360" Height="140" WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="添加自定义扩展名">
  <StackPanel Margin="12" Spacing="8">
    <TextBlock Text="请输入扩展名（例如 .zipx）:" />
    <TextBox x:Name="InputTextBox" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="取消" Click="Cancel_Click" />
      <Button Content="确定" Click="Ok_Click" />
    </StackPanel>
  </StackPanel>
</Window>
