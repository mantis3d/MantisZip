<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MantisZip.UI.Avalonia.Dialogs.PasswordManagerWindow"
        x:CompileBindings="False"
        Title="{Binding WinTitle}"
        Width="700"
        Height="500"
        MinWidth="500"
        MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBgBrush}"
        Padding="16">

  <Grid RowDefinitions="Auto,*,Auto,Auto"
        Margin="8">
    <!-- Row 0: Search bar -->
    <TextBox Grid.Row="0"
             x:Name="SearchBox"
             PlaceholderText="{Binding SearchWatermark}"
             TextChanged="OnSearchTextChanged"
             Margin="0,0,0,8" />

    <!-- Row 1: Password DataGrid -->
    <DataGrid Grid.Row="1"
              x:Name="PasswordGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              DoubleTapped="OnPasswordGridDoubleTapped">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{Binding DescColumnHeader}"
                            Binding="{Binding Description}"
                            Width="*" />
        <DataGridTextColumn Header="{Binding RulesColumnHeader}"
                            Binding="{Binding PatternDisplay}"
                            Width="*" />
        <DataGridTextColumn Header="{Binding PasswordColumnHeader}"
                            Binding="{Binding MaskedPassword}"
                            Width="130" />
      </DataGrid.Columns>
    </DataGrid>

    <!-- Row 2: Inline edit panel (hidden by default) -->
    <Border Grid.Row="2"
            x:Name="EditPanel"
            IsVisible="False"
            Margin="0,8,0,0"
            Padding="10"
            Background="{DynamicResource ThemeSurfaceBgBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
      <StackPanel Spacing="8"
                   TextElement.Foreground="{DynamicResource ThemeTextPrimaryBrush}">
        <!-- Edit title -->
        <TextBlock x:Name="EditTitle"
                   FontWeight="SemiBold"
                   FontSize="14" />

        <!-- Description field -->
        <Grid ColumnDefinitions="70,*">
          <TextBlock Text="{Binding DescLabel}"
                     VerticalAlignment="Center" />
          <TextBox Grid.Column="1"
                   x:Name="EditDesc"
                   PlaceholderText="{Binding DescLabel}" />
        </Grid>

        <!-- Password field with reveal toggle -->
        <Grid ColumnDefinitions="70,*,Auto">
          <TextBlock Text="{Binding PasswordLabel}"
                     VerticalAlignment="Center" />
          <TextBox Grid.Column="1"
                   x:Name="EditPasswordBox"
                   PasswordChar="●"
                   PlaceholderText="{Binding PasswordLabel}" />
          <Button Grid.Column="2"
                  Content="&#x1F441;"
                  Width="32"
                  Height="28"
                  Margin="4,0,0,0"
                  Click="OnEditRevealToggle"
                  Background="{DynamicResource ThemeButtonBgBrush}"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                  BorderBrush="{DynamicResource ThemeBorderBrush}">
          </Button>
        </Grid>

        <!-- Rules field -->
        <Grid ColumnDefinitions="70,*">
          <TextBlock Text="{Binding RulesLabel}"
                     VerticalAlignment="Center" />
          <TextBox Grid.Column="1"
                   x:Name="EditRules"
                   PlaceholderText="{Binding RulesWatermark}" />
        </Grid>

        <!-- Save/Cancel buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
          <Button x:Name="EditSaveBtn"
                  Content="{Binding SaveText}"
                  Padding="16,6"
                  Click="OnEditSave"
                  Background="{DynamicResource ThemeButtonBgBrush}"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                  BorderBrush="{DynamicResource ThemeBorderBrush}">
          </Button>
          <Button Content="{Binding CancelText}"
                  Padding="16,6"
                  Click="OnEditCancel"
                  Background="{DynamicResource ThemeButtonBgBrush}"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                  BorderBrush="{DynamicResource ThemeBorderBrush}">
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Row 3: Bottom toolbar -->
    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="4"
                Margin="0,8,0,0">
      <Button Content="{Binding AddText}"
              Padding="12,6"
              Click="OnAddClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
      </Button>
      <Button Content="{Binding EditText}"
              Padding="12,6"
              Click="OnEditClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
      </Button>
      <Button Content="{Binding DeleteText}"
              Padding="12,6"
              Click="OnDeleteClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
      </Button>
      <Button x:Name="TogglePwdBtn"
              Content="{Binding ShowPwdText}"
              Padding="12,6"
              Click="OnToggleShowPasswords"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
      </Button>
      <Button Content="{Binding CloseText}"
              Padding="12,6"
              Click="OnCloseClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
      </Button>
    </StackPanel>
  </Grid>
</Window>
