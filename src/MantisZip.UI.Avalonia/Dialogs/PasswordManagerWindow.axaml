<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MantisZip.UI.Avalonia.Dialogs.PasswordManagerWindow"
        x:CompileBindings="False"
        Title="{Binding WinTitle}"
        Width="700"
        Height="500"
        MinWidth="500"
        MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBgBrush}"
        Padding="{DynamicResource SpacingMdThk}">

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto"
        Margin="8">
    <!-- Row 0: Toolbar -->
    <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="0,0,0,10">
      <Button Padding="8,4"
              Margin="0,0,8,0"
              Click="OnAddClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <PathIcon Data="{StaticResource IconAdd}" Width="16" Height="16"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          <TextBlock Text="{Binding AddText}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Padding="8,4"
              Margin="0,0,8,0"
              Click="OnEditClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <PathIcon Data="{StaticResource IconEdit}" Width="16" Height="16"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          <TextBlock Text="{Binding EditText}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Padding="8,4"
              Margin="0,0,8,0"
              Click="OnDeleteClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <PathIcon Data="{StaticResource IconDelete}" Width="16" Height="16"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          <TextBlock Text="{Binding DeleteText}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Border Width="1"
              Height="24"
              Background="{DynamicResource ThemeBorderBrush}"
              Margin="0,0,8,0" />
      <Button Padding="8,4"
              Margin="0,0,8,0"
              Click="OnExportClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <PathIcon Data="{StaticResource IconExport}" Width="16" Height="16"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          <TextBlock Text="{Binding ExportText}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Padding="8,4"
              Margin="0,0,8,0"
              Click="OnImportClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <PathIcon Data="{StaticResource IconImport}" Width="16" Height="16"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          <TextBlock Text="{Binding ImportText}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Border Width="1"
              Height="24"
              Background="{DynamicResource ThemeBorderBrush}"
              Margin="0,0,8,0" />
      <Button x:Name="TogglePwdBtn"
              Padding="8,4"
              Margin="0,0,8,0"
              Click="OnToggleShowPasswords"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
        <StackPanel x:Name="TogglePwdPanel" Orientation="Horizontal" Spacing="4">
          <PathIcon x:Name="TogglePwdIcon" Data="{StaticResource IconEye}" Width="16" Height="16"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          <TextBlock x:Name="TogglePwdLabel" Text="{Binding ShowPwdText}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Padding="8,4"
              ToolTip.Tip="{Binding HelpTooltip}"
              Click="OnHelpClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <PathIcon Data="{StaticResource IconQuestion}" Width="16" Height="16"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          <TextBlock Text="?" VerticalAlignment="Center" FontWeight="Bold" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Row 1: Search bar with icon -->
    <Grid Grid.Row="1"
          Margin="0,0,0,8">
      <TextBox x:Name="SearchBox"
               PlaceholderText="{Binding SearchWatermark}"
               TextChanged="OnSearchTextChanged"
               Padding="24,4,4,4" />
      <PathIcon Data="{StaticResource IconSearch}"
                Width="14" Height="14"
                Margin="6,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                IsHitTestVisible="False" />
    </Grid>

    <!-- Row 2: Password DataGrid -->
    <DataGrid Grid.Row="2"
              x:Name="PasswordGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              RowHeight="{DynamicResource ControlHeightMd}"
              DoubleTapped="OnPasswordGridDoubleTapped">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{Binding DescColumnHeader}"
                            Binding="{Binding Description}"
                            Width="*" />
        <DataGridTextColumn Header="{Binding RulesColumnHeader}"
                            Binding="{Binding PatternDisplay}"
                            Width="*" />
        <DataGridTextColumn Header="{Binding PasswordColumnHeader}"
                            Binding="{Binding MaskedPassword}"
                            Width="130" />
        <DataGridTextColumn Header="{Binding CreatedColumnHeader}"
                            Binding="{Binding CreatedAt}"
                            Width="100" />
        <DataGridTextColumn Header="{Binding LastUsedColumnHeader}"
                            Binding="{Binding LastUsed}"
                            Width="100" />
      </DataGrid.Columns>
    </DataGrid>

    <!-- Row 3: Inline edit panel (hidden by default) -->
    <Border Grid.Row="3"
            x:Name="EditPanel"
            IsVisible="False"
            Margin="0,8,0,0"
            Padding="10"
            Background="{DynamicResource ThemeSurfaceBgBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource BorderRadius}">
      <StackPanel Spacing="{DynamicResource SpacingXs}"
                   TextElement.Foreground="{DynamicResource ThemeTextPrimaryBrush}">
        <!-- Edit title -->
        <TextBlock x:Name="EditTitle"
                   FontWeight="SemiBold"
                   FontSize="14" />

        <!-- Description field -->
        <Grid ColumnDefinitions="70,*">
          <TextBlock Text="{Binding DescLabel}"
                     VerticalAlignment="Center" />
          <TextBox Grid.Column="1"
                   x:Name="EditDesc"
                   PlaceholderText="{Binding DescLabel}" />
        </Grid>

        <!-- Password field with reveal toggle -->
        <Grid ColumnDefinitions="70,*,Auto">
          <TextBlock Text="{Binding PasswordLabel}"
                     VerticalAlignment="Center" />
          <TextBox Grid.Column="1"
                   x:Name="EditPasswordBox"
                   PasswordChar="●"
                   PlaceholderText="{Binding PasswordLabel}" />
          <Button Grid.Column="2"
                  Content="&#x1F441;"
                  Width="32"
                  Height="{DynamicResource ControlHeight}"
                  Margin="4,0,0,0"
                  Click="OnEditRevealToggle"
                  ToolTip.Tip="{Binding EditRevealTooltip}"
                  Background="{DynamicResource ThemeButtonBgBrush}"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                  BorderBrush="{DynamicResource ThemeBorderBrush}">
          </Button>
        </Grid>

        <!-- Rules field -->
        <Grid ColumnDefinitions="70,*">
          <TextBlock Text="{Binding RulesLabel}"
                     VerticalAlignment="Center" />
          <TextBox Grid.Column="1"
                   x:Name="EditRules"
                   PlaceholderText="{Binding RulesWatermark}" />
        </Grid>

        <!-- Save/Cancel buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{DynamicResource SpacingXs}">
          <Button x:Name="EditSaveBtn"
                  Content="{Binding SaveText}"
                  Padding="16,6"
                  Click="OnEditSave"
                  Background="{DynamicResource ThemeButtonBgBrush}"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                  BorderBrush="{DynamicResource ThemeBorderBrush}">
          </Button>
          <Button Content="{Binding CancelText}"
                  Padding="16,6"
                  Click="OnEditCancel"
                  Background="{DynamicResource ThemeButtonBgBrush}"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                  BorderBrush="{DynamicResource ThemeBorderBrush}">
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Row 4: Footer -->
    <Grid Grid.Row="4"
          Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0"
                 Text="{Binding TipText}"
                 Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                 VerticalAlignment="Center" />
      <TextBlock Grid.Column="1"
                 x:Name="PwdCounter"
                 Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
    </Grid>
  </Grid>
</Window>