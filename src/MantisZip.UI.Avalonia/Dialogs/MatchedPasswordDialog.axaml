<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MantisZip.UI.Avalonia.Dialogs.MatchedPasswordDialog"
        x:CompileBindings="False"
        Title="{Binding WinTitle}"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBgBrush}"
        Padding="{DynamicResource SpacingMdThk}">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
        Margin="{DynamicResource SpacingXsThk}">
    <!-- Row 0: Header (filename) -->
    <TextBlock Grid.Row="0"
               x:Name="HeaderText"
               FontWeight="Bold"
               FontSize="14"
               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
               Margin="0,0,0,12" />

    <!-- Row 1: Password row with icon + masked text + reveal + copy -->
    <Border Grid.Row="1"
            Background="{DynamicResource ThemeSurfaceBgBrush}"
            BorderBrush="{DynamicResource ThemeAccentBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource BorderRadius}"
            Padding="8,6"
            Margin="0,0,0,8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <!-- Key icon -->
        <TextBlock Grid.Column="0"
                   Text="🔑"
                   FontSize="14"
                   VerticalAlignment="Center"
                   Margin="0,0,6,0" />

        <!-- Password display (masked / plain) -->
        <Grid Grid.Column="1"
              VerticalAlignment="Center">
          <TextBlock x:Name="PwdMaskedText"
                     Text="●●●●●●●●●●"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                     VerticalAlignment="Center" />
          <TextBlock x:Name="PwdPlainText"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                     VerticalAlignment="Center"
                     IsVisible="False" />
        </Grid>

        <!-- Reveal toggle button -->
        <Button Grid.Column="2"
                x:Name="PwdRevealBtn"
                Width="24"
                Height="{DynamicResource ControlHeightXs}"
                Margin="4,0,0,0"
                Content="👁"
                FontSize="10"
                Padding="0"
                Background="{DynamicResource ThemeButtonBgBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                Click="OnRevealClick" />

        <!-- Copy button -->
        <Button Grid.Column="3"
                x:Name="PwdCopyBtn"
                Width="24"
                Height="{DynamicResource ControlHeightXs}"
                Margin="4,0,0,0"
                Content="📋"
                FontSize="10"
                Padding="0"
                Background="{DynamicResource ThemeButtonBgBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                Click="OnCopyClick" />
      </Grid>
    </Border>

    <!-- Row 2: Rules section -->
    <Border Grid.Row="2"
            x:Name="RulesSection"
            IsVisible="False"
            Margin="22,0,0,4">
      <TextBlock x:Name="RulesText"
                 FontSize="11"
                 Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                 TextWrapping="Wrap" />
    </Border>

    <!-- Row 3: Description section -->
    <Border Grid.Row="3"
            x:Name="DescriptionSection"
            IsVisible="False"
            Margin="22,0,0,12">
      <TextBlock x:Name="DescriptionText"
                 FontSize="11"
                 Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                 TextWrapping="Wrap" />
    </Border>

    <!-- Row 4: Button row -->
    <StackPanel Grid.Row="4"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="{DynamicResource SpacingXs}">
      <Button Content="{Binding UseText}"
              Click="OnUseClick"
              Padding="16,6"
              IsDefault="True"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}" />
      <Button Content="{Binding CancelText}"
              Click="OnCancelClick"
              Padding="16,6"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}" />
    </StackPanel>
  </Grid>
</Window>
