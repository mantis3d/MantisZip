<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MantisZip.UI.Avalonia.Dialogs.ExtractSettingsWindow"
        x:CompileBindings="False"
        Title="Extract Settings"
        Width="520"
        MinWidth="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBgBrush}">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="{DynamicResource ThemeComboBoxBgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeComboBoxBorderBrush}" />
    </Style>
    <Style Selector="ComboBoxItem">
      <Setter Property="Background" Value="{DynamicResource ThemeComboBoxBgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource ThemeListSelectedBrush}" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto"
        Margin="16">
    <!-- Content -->
    <StackPanel Grid.Row="0"
                Spacing="14">
      <!-- Source files -->
      <TextBlock Text="Source Archives"
                 FontWeight="SemiBold"
                 FontSize="14" />
      <ListBox x:Name="FileListBox"
               Height="100"
               BorderBrush="{DynamicResource ThemeBorderBrush}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Separator Background="{DynamicResource ThemeBorderBrush}" />

      <!-- Destination path -->
      <TextBlock Text="Destination"
                 FontWeight="SemiBold"
                 FontSize="14" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0"
                 PlaceholderText="Select destination folder"
                 Text="{Binding DestinationPath}" />
        <Button Grid.Column="1"
                Content="Browse"
                Width="80"
                Height="28"
                Margin="8,0,0,0"
                Command="{Binding BrowseDestinationCommand}"
                Background="{DynamicResource ThemeButtonBgBrush}"
                Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}">
          <Button.Styles>
            <Style Selector="Button:pressed">
              <Setter Property="Background" Value="{DynamicResource ThemeButtonPressedBrush}" />
            </Style>
            <Style Selector="Button:pointerover">
              <Setter Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}" />
            </Style>
          </Button.Styles>
        </Button>
      </Grid>

      <Separator Background="{DynamicResource ThemeBorderBrush}" />

      <!-- Conflict action -->
      <Grid ColumnDefinitions="Auto,*"
            RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="When file exists:"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0" />
        <ComboBox Grid.Row="0" Grid.Column="1"
                  SelectedItem="{Binding ConflictAction}"
                  HorizontalAlignment="Stretch">
          <ComboBoxItem Content="Ask" />
          <ComboBoxItem Content="Overwrite" />
          <ComboBoxItem Content="Rename" />
          <ComboBoxItem Content="Skip" />
        </ComboBox>

        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                  Margin="0,10,0,0"
                  IsChecked="{Binding OpenFolderAfterExtract}">
          <TextBlock Text="Open folder after extract"
                     TextWrapping="Wrap" />
        </CheckBox>
      </Grid>
    </StackPanel>

    <!-- Bottom buttons -->
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,16,0,0">
      <Button Content="Extract"
              Padding="20,7"
              Command="{Binding ExtractCommand}"
              Background="{DynamicResource ThemeAccentBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderThickness="0">
        <Button.Styles>
          <Style Selector="Button:pressed">
            <Setter Property="Opacity" Value="0.8" />
          </Style>
          <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="0.9" />
          </Style>
        </Button.Styles>
      </Button>
      <Button Content="Cancel"
              Padding="20,7"
              Command="{Binding CancelCommand}"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
        <Button.Styles>
          <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource ThemeButtonPressedBrush}" />
          </Style>
          <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}" />
          </Style>
        </Button.Styles>
      </Button>
    </StackPanel>
  </Grid>
</Window>
