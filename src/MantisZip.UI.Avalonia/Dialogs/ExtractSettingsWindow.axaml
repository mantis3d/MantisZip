<Window xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:controls="clr-namespace:MantisZip.UI.Avalonia.Controls"
         xmlns:conv="clr-namespace:MantisZip.UI.Avalonia.Converters"
         x:Class="MantisZip.UI.Avalonia.Dialogs.ExtractSettingsWindow"
         x:CompileBindings="False"
         Title="{Binding LocalizedStrings[Extract_Title]}"
         Width="850"
         MinWidth="700"
          MinHeight="500"
         SizeToContent="Height"
         WindowStartupLocation="CenterOwner"
         CanResize="True"
         Background="{DynamicResource ThemeWindowBgBrush}">

  <Window.Resources>
    <conv:GeometryResourceConverter x:Key="GeometryResourceConverter" />
    <conv:NodeForegroundConverter x:Key="NodeForegroundConverter" />
  </Window.Resources>

  <Grid RowDefinitions="*,Auto"
        Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="450" MinWidth="400" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <!-- ═══════ 左侧：设置选项卡 ═══════ -->
    <TabControl Grid.Column="0" Grid.Row="0"
                Background="{DynamicResource ThemeWindowBgBrush}"
                TextElement.Foreground="{DynamicResource ThemeTextPrimaryBrush}">
      <!-- 选项卡 1：常规设置 -->
      <TabItem Header="{Binding LocalizedStrings[Extract_Title]}"
               Classes="compactTab"
               controls:TabItemExtensions.TabIcon="IconSettings">
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}"
                       TextElement.Foreground="{DynamicResource ThemeTextPrimaryBrush}">
          <StackPanel Spacing="12"
                       Margin="0,8,0,0">
            <!-- 源压缩包列表 -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12"
                    Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding LocalizedStrings[Extract_SourceArchives]}"
                           FontWeight="SemiBold" />
                <ListBox x:Name="FileListBox"
                         Height="100"
                         BorderBrush="{DynamicResource ThemeBorderBrush}"
                         ItemsSource="{Binding SourceItems}"
                         SelectedItem="{Binding SelectedSourceItem}">
                  <ListBox.ItemContainerTheme>
                    <ControlTheme TargetType="ListBoxItem">
                      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightMd}" />
                    </ControlTheme>
                  </ListBox.ItemContainerTheme>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal"
                                  Spacing="6"
                                  Background="Transparent">
                        <!-- 状态图标 -->
                        <PathIcon Data="{Binding StatusIconKey, Converter={StaticResource GeometryResourceConverter}}"
                                  Width="16" Height="16"
                                  VerticalAlignment="Center"
                                  Foreground="{Binding StatusForegroundKey, Converter={StaticResource NodeForegroundConverter}}" />
                        <!-- 显示名称 -->
                        <TextBlock Text="{Binding DisplayName}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding RowToolTip}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <!-- 多包场景提示：过滤/预览统计语义绑定首包 -->
                <TextBlock Text="{Binding LocalizedStrings[Extract_Source_MultiFilterHint]}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                           IsVisible="{Binding HasMultipleArchives}" />
                <!-- 手动解锁按钮：选中锁定/加密未匹配行时出现 -->
                <Button Command="{Binding UnlockSelectedCommand}"
                        IsVisible="{Binding CanUnlockSelected}"
                        HorizontalAlignment="Left"
                        Classes="ToolbarButton">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconKey}"
                              Width="16" Height="16"
                              Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                    <TextBlock Text="{Binding LocalizedStrings[Extract_UnlockButton]}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>

            <!-- 目标路径 -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12"
                    Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding LocalizedStrings[Extract_Destination]}"
                           FontWeight="SemiBold" />
                <!-- 路径输入 + 快速按钮 + 浏览 (QuickPathPicker) -->
                <controls:QuickPathPicker x:Name="DestinationPicker"
                                          Path="{Binding DestinationPath}" />
              </StackPanel>
            </Border>

            <!-- 冲突处理方式 -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12"
                    Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding LocalizedStrings[Extract_WhenFileExists]}"
                           FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding ConflictActionOptions}"
                          SelectedItem="{Binding SelectedConflictActionOption}"
                          DisplayMemberBinding="{Binding Display}"
                          HorizontalAlignment="Stretch" />
                <CheckBox IsChecked="{Binding OpenFolderAfterExtract}">
                  <TextBlock Text="{Binding LocalizedStrings[Extract_OpenFolder]}"
                             TextWrapping="Wrap" />
                </CheckBox>

                <!-- 解压后将原压缩包移入回收站：默认值取自设置窗口同名选项，勾选仅本次解压生效，不写回全局设置 -->
                <CheckBox IsChecked="{Binding DeleteArchiveAfterExtract}">
                  <TextBlock Text="{Binding LocalizedStrings[Settings_Extract_DeleteArchiveAfterExtract]}"
                             TextWrapping="Wrap" />
                </CheckBox>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 选项卡 2：文件过滤 -->
      <TabItem Header="{Binding LocalizedStrings[Extract_TabFilter]}"
               Classes="compactTab"
               controls:TabItemExtensions.TabIcon="IconFilter">
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}"
                       TextElement.Foreground="{DynamicResource ThemeTextPrimaryBrush}">
          <controls:FileFilterEditor x:Name="FileFilterControl" />
        </ScrollViewer>
      </TabItem>

      <!-- 选项卡 3：加速（并行解压；与设置窗口对称；初值读取设置，本次解压生效不回写） -->
      <TabItem Header="{Binding LocalizedStrings[Settings_ExtractTab_Parallel]}"
               Classes="compactTab"
               controls:TabItemExtensions.TabIcon="IconLightning">
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}"
                       TextElement.Foreground="{DynamicResource ThemeTextPrimaryBrush}">
          <StackPanel Spacing="12" Margin="0,8,0,0">
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12"
                    Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="8">
                <!-- 全局并行开关：关闭则始终串行 -->
                <CheckBox IsChecked="{Binding EnableParallelExtract}"
                          Content="{Binding LocalizedStrings[Settings_EnableParallelExtract]}" />

                <!-- 智能并行度区域（全局开关关闭时隐藏，规则 6） -->
                <StackPanel Spacing="8" IsVisible="{Binding EnableParallelExtract}">
                  <!-- 智能并行度开关 -->
                  <CheckBox IsChecked="{Binding SmartParallelDegree}"
                            Content="{Binding SmartParallelDegreeText}" />

                  <!-- 智能开启：SSD/HDD 双线程数输入 -->
                  <Grid ColumnDefinitions="Auto,*,Auto,*"
                        IsVisible="{Binding IsSmartDegreeVisible}"
                        Margin="24,0,0,0">
                    <TextBlock Text="{Binding LocalizedStrings[Settings_SmartSsdLabel]}"
                               VerticalAlignment="Center" />
                    <NumericUpDown Classes="intOnly"
                                   Grid.Column="1" Minimum="1" Maximum="16" Increment="1"
                                   Value="{Binding SmartSsdDegree, Mode=TwoWay}"
                                   Width="120" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding LocalizedStrings[Settings_SmartHddLabel]}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                    <NumericUpDown Classes="intOnly"
                                   Grid.Column="3" Minimum="1" Maximum="16" Increment="1"
                                   Value="{Binding SmartHddDegree, Mode=TwoWay}"
                                   Width="120" HorizontalAlignment="Left" />
                  </Grid>

                  <!-- 智能关闭：手动线程数（1-16） -->
                  <StackPanel Orientation="Horizontal" Spacing="8"
                              IsVisible="{Binding IsManualDegreeVisible}"
                              Margin="24,0,0,0">
                    <TextBlock Text="{Binding LocalizedStrings[Settings_ManualDegreeLabel]}"
                               VerticalAlignment="Center" />
                    <NumericUpDown Classes="intOnly"
                                   Minimum="1" Maximum="16" Increment="1"
                                   Value="{Binding ManualParallelDegree, Mode=TwoWay}"
                                   Width="120" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding LocalizedStrings[Settings_ManualDegreeHint]}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                               FontSize="11" />
                  </StackPanel>

                  <!-- 大包预测试开关（智能开启时显示） -->
                  <CheckBox IsChecked="{Binding LargeArchivePreTest}"
                            Content="{Binding LocalizedStrings[Settings_LargeArchivePreTest]}"
                            IsVisible="{Binding IsPreTestVisible}"
                            Margin="24,4,0,0" />
                </StackPanel>

                <!-- 说明：本次解压一次性生效，不改设置 -->
                <TextBlock Text="{Binding LocalizedStrings[Extract_ParallelNotSavedHint]}"
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- ═══════ 分割器 ═══════ -->
    <GridSplitter Grid.Column="1" Grid.Row="0"
                  Width="5"
                  Background="{DynamicResource ThemeSplitterBgBrush}"
                  ResizeBehavior="PreviousAndNext"
                  ResizeDirection="Auto" />

    <!-- ═══════ 右侧：预览面板 ═══════ -->
    <controls:ResultTreeView Grid.Column="2" Grid.Row="0"
                              x:Name="PreviewTree"
                              Root="{Binding PreviewRoot}"
                              CompactMode="{Binding PreviewCompactMode}"
                              MaxItemsPerDirectory="5"
                              MaxDepth="5"
                              ShowFilteredGhosts="{Binding ShowFilteredGhosts}"
                              IsLoading="{Binding IsPreviewBuilding}"
                              BuildProgress="{Binding PreviewBuildProgress}"
                              IsListingPending="{Binding IsListingPending}"
                              LoadFailedTitle="{Binding PreviewErrorTitle}"
                              LoadFailedDetail="{Binding PreviewErrorDetail}"
                              LoadFailedNeedsPassword="{Binding PreviewNeedsPassword}"
                              MinWidth="200" />

    <!-- ═══════ 底部按钮（跨所有列） ═══════ -->
    <StackPanel Grid.Row="1"
                Grid.ColumnSpan="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,16,0,0">
      <Button Content="{Binding LocalizedStrings[Extract_Start]}"
              Padding="16"
              Command="{Binding ExtractCommand}"
              Background="{DynamicResource ThemeAccentBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderThickness="0">
      </Button>
      <Button Content="{Binding LocalizedStrings[Extract_Cancel]}"
              Padding="16"
              Command="{Binding CancelCommand}"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
      </Button>
    </StackPanel>
  </Grid>
</Window>
