<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MantisZip.UI.Avalonia.Dialogs.ExtractSettingsWindow"
        x:CompileBindings="False"
        Title="{Binding LocalizedStrings[Extract_Title]}"
        Width="520"
        MinWidth="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBgBrush}">

  <Grid RowDefinitions="*,Auto"
        Margin="16">
    <!-- Content -->
    <StackPanel Grid.Row="0"
                Spacing="14">
      <!-- Source files -->
      <TextBlock Text="{Binding LocalizedStrings[Extract_SourceArchives]}"
                 FontWeight="SemiBold"
                 FontSize="14" />
      <ListBox x:Name="FileListBox"
               Height="100"
               BorderBrush="{DynamicResource ThemeBorderBrush}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Separator Background="{DynamicResource ThemeBorderBrush}" />

      <!-- Destination path -->
      <TextBlock Text="{Binding LocalizedStrings[Extract_Destination]}"
                 FontWeight="SemiBold"
                 FontSize="14" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0"
                 PlaceholderText="{Binding LocalizedStrings[Extract_DestinationPlaceholder]}"
                 Text="{Binding DestinationPath}" />
        <Button Grid.Column="1"
                Content="{Binding LocalizedStrings[Extract_Browse]}"
                Width="80"
                Height="28"
                Margin="8,0,0,0"
                Command="{Binding BrowseDestinationCommand}"
                Background="{DynamicResource ThemeButtonBgBrush}"
                Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}">
        </Button>
      </Grid>

      <Separator Background="{DynamicResource ThemeBorderBrush}" />

      <!-- Conflict action -->
      <Grid ColumnDefinitions="Auto,*"
            RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="{Binding LocalizedStrings[Extract_WhenFileExists]}"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0" />
        <ComboBox Grid.Row="0" Grid.Column="1"
                  SelectedItem="{Binding ConflictAction}"
                  HorizontalAlignment="Stretch">
          <ComboBoxItem Content="{Binding LocalizedStrings[Extract_Conflict_Ask]}" />
          <ComboBoxItem Content="{Binding LocalizedStrings[Extract_Conflict_Overwrite]}" />
          <ComboBoxItem Content="{Binding LocalizedStrings[Extract_Conflict_Rename]}" />
          <ComboBoxItem Content="{Binding LocalizedStrings[Extract_Conflict_Skip]}" />
        </ComboBox>

        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                  Margin="0,10,0,0"
                  IsChecked="{Binding OpenFolderAfterExtract}">
          <TextBlock Text="{Binding LocalizedStrings[Extract_OpenFolder]}"
                     TextWrapping="Wrap" />
        </CheckBox>
      </Grid>
    </StackPanel>

    <!-- Bottom buttons -->
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,16,0,0">
      <Button Content="{Binding LocalizedStrings[Extract_Start]}"
              Padding="20,7"
              Command="{Binding ExtractCommand}"
              Background="{DynamicResource ThemeAccentBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderThickness="0">
      </Button>
      <Button Content="{Binding LocalizedStrings[Extract_Cancel]}"
              Padding="20,7"
              Command="{Binding CancelCommand}"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
      </Button>
    </StackPanel>
  </Grid>
</Window>
