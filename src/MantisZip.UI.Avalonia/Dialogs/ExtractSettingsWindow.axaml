<Window xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:controls="clr-namespace:MantisZip.UI.Avalonia.Controls"
         x:Class="MantisZip.UI.Avalonia.Dialogs.ExtractSettingsWindow"
         x:CompileBindings="False"
         Title="{Binding LocalizedStrings[Extract_Title]}"
         Width="850"
         MinWidth="700"
          MinHeight="500"
         SizeToContent="Height"
         WindowStartupLocation="CenterOwner"
         CanResize="True"
         Background="{DynamicResource ThemeWindowBgBrush}">

  <Grid RowDefinitions="*,Auto"
        Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="450" MinWidth="400" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <!-- ═══════ Left: TabControl with settings ═══════ -->
    <TabControl Grid.Column="0" Grid.Row="0"
                Background="{DynamicResource ThemeWindowBgBrush}"
                TextElement.Foreground="{DynamicResource ThemeTextPrimaryBrush}">
      <!-- Tab: General -->
      <TabItem Header="{Binding LocalizedStrings[Extract_Title]}"
               Classes="compactTab">
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}"
                       TextElement.Foreground="{DynamicResource ThemeTextPrimaryBrush}">
          <StackPanel Spacing="12"
                       Margin="0,8,0,0">
            <!-- Source archives -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12"
                    Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding LocalizedStrings[Extract_SourceArchives]}"
                           FontWeight="SemiBold" />
                <ListBox x:Name="FileListBox"
                         Height="100"
                         BorderBrush="{DynamicResource ThemeBorderBrush}">
                  <ListBox.ItemContainerTheme>
                    <ControlTheme TargetType="ListBoxItem">
                      <Setter Property="MinHeight" Value="{DynamicResource ControlHeightMd}" />
                    </ControlTheme>
                  </ListBox.ItemContainerTheme>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>

            <!-- Destination path -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12"
                    Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding LocalizedStrings[Extract_Destination]}"
                           FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0"
                           PlaceholderText="{Binding LocalizedStrings[Extract_DestinationPlaceholder]}"
                           Text="{Binding DestinationPath}"
                           Background="{DynamicResource ThemeSurfaceBgBrush}"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           BorderBrush="{DynamicResource ThemeBorderBrush}" />
                  <Button Grid.Column="1"
                          Content="{Binding LocalizedStrings[Extract_Browse]}"
                          Width="80"
                          MinHeight="{DynamicResource ControlHeight}"
                          Margin="8,0,0,0"
                          Click="BrowsePath_Click"
                          Background="{DynamicResource ThemeButtonBgBrush}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}">
                  </Button>
                </Grid>

                <!-- Quick buttons row: ⭐ 🕐 🪟 + 📁 (extract folder dialog) -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto"
                      ColumnSpacing="{DynamicResource SpacingXxs}">
                  <Button x:Name="QuickFavButton"
                          MinHeight="{DynamicResource ControlHeightSm}"
                          Padding="{DynamicResource SpacingXsThk}"
                          Click="QuickFavButton_Click"
                          ToolTip.Tip="{Binding LocalizedStrings[QuickPath_TabFavorites]}"
                          Background="{DynamicResource ThemeButtonBgBrush}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}">
                    <PathIcon Data="{StaticResource IconStar}"
                              Width="14" Height="14"
                              Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                  </Button>
                  <Button Grid.Column="1"
                          x:Name="QuickHistButton"
                          MinHeight="{DynamicResource ControlHeightSm}"
                          Padding="{DynamicResource SpacingXsThk}"
                          Click="QuickHistButton_Click"
                          ToolTip.Tip="{Binding LocalizedStrings[QuickPath_TabHistory]}"
                          Background="{DynamicResource ThemeButtonBgBrush}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}">
                    <PathIcon Data="{StaticResource IconHistory}"
                              Width="14" Height="14"
                              Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                  </Button>
                  <Button Grid.Column="2"
                          x:Name="QuickWinButton"
                          MinHeight="{DynamicResource ControlHeightSm}"
                          Padding="{DynamicResource SpacingXsThk}"
                          Click="QuickWinButton_Click"
                          ToolTip.Tip="{Binding LocalizedStrings[QuickPath_TabWindows]}"
                          Background="{DynamicResource ThemeButtonBgBrush}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}">
                    <PathIcon Data="{StaticResource IconHome}"
                              Width="14" Height="14"
                              Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                  </Button>
                    <Button Grid.Column="3"
                            x:Name="QuickBrowseButton"
                          MinHeight="{DynamicResource ControlHeightSm}"
                          Padding="{DynamicResource SpacingXsThk}"
                          Click="QuickBrowseButton_Click"
                          ToolTip.Tip="{Binding LocalizedStrings[Extract_Browse]}"
                          Background="{DynamicResource ThemeButtonBgBrush}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <PathIcon Data="{StaticResource IconFolderOpen}"
                                Width="14" Height="14"
                                Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                      <TextBlock Text="{Binding LocalizedStrings[Extract_Browse]}"
                                 FontSize="11"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                    </StackPanel>
                  </Button>
                </Grid>

                <!-- ⭐ Favorites popup -->
                <Popup x:Name="DestFavPopup"
                       PlacementTarget="{Binding #QuickFavButton}"
                       Placement="Bottom"
                       IsLightDismissEnabled="False">
                  <Border Background="{DynamicResource ThemeWindowBgBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}"
                          BorderThickness="1" CornerRadius="4" Padding="6"
                          Width="320" MaxHeight="420"
                          BoxShadow="0 2 8 0 #40000000">
                    <controls:QuickPathControl x:Name="DestFavControl"
                                               Width="308"
                                               PathSelected="DestPathControl_PathSelected" />
                  </Border>
                </Popup>

                <!-- 🕐 History popup -->
                <Popup x:Name="DestHistPopup"
                       PlacementTarget="{Binding #QuickHistButton}"
                       Placement="Bottom"
                       IsLightDismissEnabled="False">
                  <Border Background="{DynamicResource ThemeWindowBgBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}"
                          BorderThickness="1" CornerRadius="4" Padding="6"
                          Width="320" MaxHeight="420"
                          BoxShadow="0 2 8 0 #40000000">
                    <controls:QuickPathControl x:Name="DestHistControl"
                                               Width="308"
                                               PathSelected="DestPathControl_PathSelected" />
                  </Border>
                </Popup>

                <!-- 🪟 Windows popup -->
                <Popup x:Name="DestWinPopup"
                       PlacementTarget="{Binding #QuickWinButton}"
                       Placement="Bottom"
                       IsLightDismissEnabled="False">
                  <Border Background="{DynamicResource ThemeWindowBgBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}"
                          BorderThickness="1" CornerRadius="4" Padding="6"
                          Width="320" MaxHeight="420"
                          BoxShadow="0 2 8 0 #40000000">
                    <controls:QuickPathControl x:Name="DestWinControl"
                                               Width="308"
                                               PathSelected="DestPathControl_PathSelected" />
                  </Border>
                </Popup>

                <!-- ⭐ Favorites popup -->
              </StackPanel>
            </Border>

            <!-- Conflict action -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12"
                    Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding LocalizedStrings[Extract_WhenFileExists]}"
                           FontWeight="SemiBold" />
                <ComboBox SelectedItem="{Binding ConflictAction}"
                          HorizontalAlignment="Stretch">
                  <ComboBoxItem Content="{Binding LocalizedStrings[Extract_Conflict_Ask]}" />
                  <ComboBoxItem Content="{Binding LocalizedStrings[Extract_Conflict_Overwrite]}" />
                  <ComboBoxItem Content="{Binding LocalizedStrings[Extract_Conflict_Rename]}" />
                  <ComboBoxItem Content="{Binding LocalizedStrings[Extract_Conflict_Skip]}" />
                </ComboBox>
                <CheckBox IsChecked="{Binding OpenFolderAfterExtract}">
                  <TextBlock Text="{Binding LocalizedStrings[Extract_OpenFolder]}"
                             TextWrapping="Wrap" />
                </CheckBox>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab 2: File Filter -->
      <TabItem Header="{Binding LocalizedStrings[Extract_TabFilter]}"
               Classes="compactTab">
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}"
                       TextElement.Foreground="{DynamicResource ThemeTextPrimaryBrush}">
          <controls:FileFilterEditor x:Name="FileFilterControl" />
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- ═══════ GridSplitter ═══════ -->
    <GridSplitter Grid.Column="1" Grid.Row="0"
                  Width="5"
                  Background="{DynamicResource ThemeSplitterBgBrush}"
                  ResizeBehavior="PreviousAndNext"
                  ResizeDirection="Auto" />

    <!-- ═══════ Right: Preview panel ═══════ -->
    <controls:ResultTreeView Grid.Column="2" Grid.Row="0"
                              x:Name="PreviewTree"
                              Root="{Binding PreviewRoot}"
                              CompactMode="{Binding PreviewCompactMode}"
                              MaxItemsPerDirectory="5"
                              MaxDepth="5"
                              ShowFilteredGhosts="{Binding ShowFilteredGhosts}"
                              IsLoading="{Binding IsPreviewBuilding}"
                              BuildProgress="{Binding PreviewBuildProgress}"
                              MinWidth="200" />

    <!-- ═══════ Bottom buttons (span all columns) ═══════ -->
    <StackPanel Grid.Row="1"
                Grid.ColumnSpan="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,16,0,0">
      <Button Content="{Binding LocalizedStrings[Extract_Start]}"
              Padding="16"
              Command="{Binding ExtractCommand}"
              Background="{DynamicResource ThemeAccentBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderThickness="0">
      </Button>
      <Button Content="{Binding LocalizedStrings[Extract_Cancel]}"
              Padding="16"
              Command="{Binding CancelCommand}"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
      </Button>
    </StackPanel>
  </Grid>
</Window>
