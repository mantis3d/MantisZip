<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MantisZip.UI.Avalonia.Controls"
             x:Class="MantisZip.UI.Avalonia.Controls.QuickPathPicker"
             x:Name="RootControl">
  <Panel>
    <Grid RowDefinitions="Auto,Auto"
          RowSpacing="{DynamicResource SpacingXxs}">

      <!-- Row 0: 路径输入框（AutoCompleteBox，支持历史记录自动补全） -->
      <AutoCompleteBox x:Name="PathInput"
                       Grid.Row="0"
                       MinHeight="{DynamicResource ControlHeightMd}"
                       FilterMode="Contains"
                       MinimumPrefixLength="0"
                       TextChanged="PathInput_TextChanged"
                       KeyDown="PathInput_KeyDown"
                       Background="{DynamicResource ThemeSurfaceBgBrush}"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       BorderBrush="{DynamicResource ThemeBorderBrush}" />

      <!-- Row 1: 快速操作按钮栏（收藏/历史/窗口/浏览） -->
      <Grid Grid.Row="1"
            ColumnDefinitions="Auto,Auto,Auto,*,Auto"
            ColumnSpacing="{DynamicResource SpacingXxs}">
        <!-- ⭐ 收藏按钮：打开收藏路径弹出面板 -->
        <Button x:Name="QuickFavButton"
                Grid.Column="0"
                MinHeight="{DynamicResource ControlHeightSm}"
                Padding="{DynamicResource SpacingXsThk}"
                Click="QuickFavButton_Click"
                Background="{DynamicResource ThemeButtonBgBrush}"
                Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}">
          <PathIcon Data="{StaticResource IconBookmark}"
                    Width="14" Height="14"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
        </Button>
        <!-- 🕐 历史按钮：打开最近使用路径弹出面板 -->
        <Button x:Name="QuickHistButton"
                Grid.Column="1"
                MinHeight="{DynamicResource ControlHeightSm}"
                Padding="{DynamicResource SpacingXsThk}"
                Click="QuickHistButton_Click"
                Background="{DynamicResource ThemeButtonBgBrush}"
                Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}">
          <PathIcon Data="{StaticResource IconHistory}"
                    Width="14" Height="14"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
        </Button>
        <!-- 🪟 窗口按钮：打开当前打开的资源管理器窗口路径弹出面板 -->
        <Button x:Name="QuickWinButton"
                Grid.Column="2"
                MinHeight="{DynamicResource ControlHeightSm}"
                Padding="{DynamicResource SpacingXsThk}"
                Click="QuickWinButton_Click"
                Background="{DynamicResource ThemeButtonBgBrush}"
                Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}">
          <PathIcon Data="{StaticResource IconLightning}"
                    Width="14" Height="14"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
        </Button>
        <!-- 📁 浏览按钮：打开系统文件夹选择对话框 -->
        <Button x:Name="QuickBrowseButton"
                Grid.Column="4"
                MinHeight="{DynamicResource ControlHeightSm}"
                Padding="{DynamicResource SpacingXsThk}"
                Click="QuickBrowseButton_Click"
                Background="{DynamicResource ThemeButtonBgBrush}"
                Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}">
          <PathIcon Data="{StaticResource IconFolder}"
                    Width="14" Height="14"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
        </Button>
      </Grid>
    </Grid>

    <!-- ⭐ 收藏弹出面板：包含 QuickPathControl，显示用户收藏的路径 -->
    <Popup x:Name="FavPopup"
           PlacementTarget="{Binding #QuickFavButton}"
           Placement="Bottom"
           IsLightDismissEnabled="False">
      <Border Background="{DynamicResource ThemeWindowBgBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}"
              BorderThickness="1" CornerRadius="4" Padding="6"
              Width="320" MaxHeight="420"
              BoxShadow="0 2 8 0 #40000000">
        <controls:QuickPathControl x:Name="FavControl"
                                   Width="308"
                                   PathSelected="FavControl_PathSelected" />
      </Border>
    </Popup>

    <!-- 🕐 历史弹出面板：包含 QuickPathControl，显示最近访问的路径 -->
    <Popup x:Name="HistPopup"
           PlacementTarget="{Binding #QuickHistButton}"
           Placement="Bottom"
           IsLightDismissEnabled="False">
      <Border Background="{DynamicResource ThemeWindowBgBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}"
              BorderThickness="1" CornerRadius="4" Padding="6"
              Width="320" MaxHeight="420"
              BoxShadow="0 2 8 0 #40000000">
        <controls:QuickPathControl x:Name="HistControl"
                                   Width="308"
                                   PathSelected="HistControl_PathSelected" />
      </Border>
    </Popup>

    <!-- 🪟 窗口弹出面板：包含 QuickPathControl，显示当前打开的资源管理器窗口路径 -->
    <Popup x:Name="WinPopup"
           PlacementTarget="{Binding #QuickWinButton}"
           Placement="Bottom"
           IsLightDismissEnabled="False">
      <Border Background="{DynamicResource ThemeWindowBgBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}"
              BorderThickness="1" CornerRadius="4" Padding="6"
              Width="320" MaxHeight="420"
              BoxShadow="0 2 8 0 #40000000">
        <controls:QuickPathControl x:Name="WinControl"
                                   Width="308"
                                   PathSelected="WinControl_PathSelected" />
      </Border>
    </Popup>
  </Panel>
</UserControl>
