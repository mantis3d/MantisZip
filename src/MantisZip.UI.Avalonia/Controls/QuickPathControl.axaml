<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:controls="clr-namespace:MantisZip.UI.Avalonia.Controls"
            xmlns:conv="clr-namespace:MantisZip.UI.Avalonia.Converters"
            x:Class="MantisZip.UI.Avalonia.Controls.QuickPathControl"
            x:Name="RootControl">
  <UserControl.Resources>
    <conv:GeometryResourceConverter x:Key="GeometryResourceConverter" />
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,*"
        RowSpacing="{DynamicResource SpacingXxs}">

    <!-- Row 0: Tab row + search box -->
    <Grid x:Name="TabRow"
          Grid.Row="0"
          ColumnDefinitions="Auto,Auto,Auto,Auto,*"
          ColumnSpacing="{DynamicResource SpacingXxs}">
      <ToggleButton x:Name="FavoritesTab"
                    IsChecked="True"
                    MinHeight="{DynamicResource ControlHeightSm}"
                    Padding="{DynamicResource SpacingXsThk}"
                    Click="FavoritesTab_Click"
                    Background="{DynamicResource ThemeButtonBgBrush}"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}">
        <PathIcon Data="{StaticResource IconStar}"
                  Width="14"
                  Height="14"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
      </ToggleButton>
      <ToggleButton Grid.Column="1"
                    x:Name="HistoryTab"
                    MinHeight="{DynamicResource ControlHeightSm}"
                    Padding="{DynamicResource SpacingXsThk}"
                    Click="HistoryTab_Click"
                    Background="{DynamicResource ThemeButtonBgBrush}"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}">
        <PathIcon Data="{StaticResource IconHistory}"
                  Width="14"
                  Height="14"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
      </ToggleButton>
      <ToggleButton Grid.Column="2"
                    x:Name="WindowsTab"
                    MinHeight="{DynamicResource ControlHeightSm}"
                    Padding="{DynamicResource SpacingXsThk}"
                    Click="WindowsTab_Click"
                    Background="{DynamicResource ThemeButtonBgBrush}"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}">
        <PathIcon Data="{StaticResource IconLightning}"
                  Width="14"
                  Height="14"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
      </ToggleButton>
      <ToggleButton Grid.Column="3"
                    x:Name="TreeTab"
                    MinHeight="{DynamicResource ControlHeightSm}"
                    Padding="{DynamicResource SpacingXsThk}"
                    Click="TreeTab_Click"
                    Background="{DynamicResource ThemeButtonBgBrush}"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}">
        <PathIcon Data="{StaticResource IconFolder}"
                  Width="14"
                  Height="14"
                  Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
      </ToggleButton>
      <TextBox Grid.Column="4"
              x:Name="SearchBox"
              MinHeight="{DynamicResource ControlHeightSm}"
              TextChanged="SearchBox_TextChanged"
              Background="{DynamicResource ThemeSurfaceBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}" />
    </Grid>

    <!-- Row 1: Path list -->
    <Grid Grid.Row="1">
      <ListBox x:Name="PathList"
              Background="Transparent"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderThickness="0"
              SelectionChanged="PathList_SelectionChanged">
        <ListBox.ItemContainerTheme>
          <ControlTheme TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="{DynamicResource ControlHeightMd}" />
            <Setter Property="Padding" Value="{DynamicResource SpacingXxsThk}" />
            <!-- 选中高亮（伪类选择器作用于默认模板的 ContentPresenter） -->
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource ThemeTabHoverBrush}" />
            </Style>
            <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource ThemeListSelectedBrush}" />
            </Style>
            <Style Selector="^:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource ThemeListSelectedBrush}" />
            </Style>
          </ControlTheme>
        </ListBox.ItemContainerTheme>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="controls:QuickPathItem">
            <!-- Background=Transparent：让整行参与命中测试，点击行内任意位置均可选中 -->
            <Grid ColumnDefinitions="20,*,Auto" Background="Transparent">
              <!-- 真实图标优先；Icon 为空时用矢量 PathIcon 回退 -->
              <Image Source="{Binding Icon}"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    IsVisible="{Binding !IsNullIcon}" />
              <PathIcon Data="{Binding IconKey, Converter={StaticResource GeometryResourceConverter}}"
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                        IsVisible="{Binding IsNullIcon}" />
              <StackPanel Grid.Column="1"
                          Orientation="Vertical"
                          Spacing="0">
                <TextBlock Text="{Binding DisplayName}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                          TextTrimming="CharacterEllipsis"
                          MaxWidth="150" />
                <TextBlock Text="{Binding Path}"
                          Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                          FontSize="11"
                          MaxWidth="150" />
              </StackPanel>
              <Border Grid.Column="2"
                      Background="{DynamicResource ThemeSurfaceBgBrush}"
                      CornerRadius="3"
                      Padding="4,0"
                      VerticalAlignment="Center"
                      IsVisible="{Binding ShowSourceTag}">
                <TextBlock Text="{Binding SourceTag}"
                          FontSize="10"
                          Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Empty state placeholder -->
      <TextBlock x:Name="EmptyText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                IsVisible="False" />

      <!-- Directory tree (Tree tab only) -->
      <TreeView x:Name="DirTree"
                Background="Transparent"
                BorderThickness="0"
                IsVisible="False"
                SelectionChanged="DirTree_SelectionChanged"
                DoubleTapped="DirTree_DoubleTapped">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="MinHeight" Value="{DynamicResource ControlHeightSm}" />
            <Setter Property="Padding" Value="{DynamicResource SpacingXxsThk}" />
          </Style>
          <Style Selector="TreeViewItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeTabHoverBrush}" />
          </Style>
          <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeListSelectedBrush}" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="controls:DirectoryTreeNode"
                            ItemsSource="{Binding Children}">
            <!-- Background=Transparent：让整行参与命中测试，点击行内任意位置均可选中 -->
            <Grid ColumnDefinitions="18,*" Background="Transparent">
              <Image Source="{Binding Icon}"
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center" />
              <TextBlock Grid.Column="1"
                        Text="{Binding Name}"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                        TextTrimming="CharacterEllipsis" />
            </Grid>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Grid>
  </Grid>
</UserControl>
