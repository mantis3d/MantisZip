<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MantisZip.UI.Avalonia.ViewModels"
             xmlns:models="clr-namespace:MantisZip.UI.Avalonia.Models"
             xmlns:conv="clr-namespace:MantisZip.UI.Avalonia.Converters"
             xmlns:controls="clr-namespace:MantisZip.UI.Avalonia.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="MantisZip.UI.Avalonia.Controls.ArchiveContentView"
             x:DataType="vm:MainWindowViewModel">

  <!-- 视图局部资源：随内容区一并迁入（原声明在 MainWindow.axaml 的 Window.Resources，
       拆出后静态资源查找作用域只到本视图 → 缺失会导致 DataGrid 行渲染时
       KeyNotFoundException: Static resource 'RatioToWidthConverter' not found）。
       规则：拆出 UserControl 时，凡是被搬走的 XAML 引用到的局部资源必须一并搬过来。 -->
  <UserControl.Resources>
    <conv:RatioToWidthConverter x:Key="RatioToWidthConverter" />
    <!-- 缩略图布局：选中态背景（true → ThemeToggleBrush 半透明强调色，false → Transparent）。
         复用既有 BoolToToggleBgBrushConverter（与菜单/列头切换图标同源），不新增转换器类。 -->
    <conv:BoolToToggleBgBrushConverter x:Key="ThumbnailSelectedBrushConverter" />
    <!-- 文字片段非空判断（三态内容卡第 ② 态用），复用既有 StringNotEmptyConverter -->
    <conv:StringNotEmptyConverter x:Key="ThumbnailTextNotEmptyConverter" />
    <!-- Content 模式元数据行标签列定宽（假列头单元与此同宽保证标签对齐）。
         前置 spike（GridSharedSizeGroupSpikeTests，2026-11-07）：Avalonia 12 的
         Grid.SharedSizeGroup 不跨 Grid 共享 ⇒ 走计划兜底方案定宽。
         76px 覆盖最长标签（英文 "Compressed:" ≈71px @11pt；中文 4 字符 ≈48px），实测可微调。
         ⚠ 本资源只能给 Double 型属性（假列头 Border.Width 等）用——GridLength 型属性
         （RowDefinition/ColumnDefinition 的 Width/Height）禁止绑它：挂树重求值时
         double→GridLength 强转抛 InvalidCastException 整进程崩溃（2026-11-07 事故，
         崩溃回归见 ContentLayoutRenderTests）；元数据行的 ColumnDefinition 用字面量 76 与本资源同值同步。
         与规则 5 的 double/Thickness 双资源同理：GridLength 属性也吃不到 double 值。 -->
    <sys:Double x:Key="ContentRowLabelColumnWidth">76</sys:Double>

    <!-- ══════════════ 三态内容卡（平铺项 / 内容行共用） ══════════════
         绑定对象是条目模型 ArchiveItemModel，按优先级三选一显示，全部用 IsVisible 组合判断，
         不写转换器类：
         ① ThumbnailSource 非空 → 128 内等比缩略图（最长边 128，保持宽高比）
         ② 否则 TextSnippet 非空 → 128×128 文字卡片（文本类文件首屏内容预览）
         ③ 否则 → 文件类型图标兜底：有大图标时按 96px 显示（Windows 取 Shell 256px 档），
              拿不到大图标才按 16px 原尺寸显示（16px 放大到 96 会发虚）
         尺寸/边框/垫底色全部走 DynamicResource（设置 → 外观 → 缩略图）：
         ThumbnailCardSize（96/128/160）、ThumbnailCardBorderThickness（0 或 1）、
         ThumbnailCardBackdropBrush（保留透明时 = 透明画刷，关闭时 = 用户选的实色）。 -->
    <DataTemplate x:Key="ThumbnailContentCard" x:DataType="models:ArchiveItemModel">
      <Border Width="{DynamicResource ThumbnailCardSize}"
              Height="{DynamicResource ThumbnailCardSize}"
              Background="{DynamicResource ThumbnailCardBackdropBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}"
              BorderThickness="{DynamicResource ThumbnailCardBorderThickness}"
              CornerRadius="{DynamicResource BorderRadius}"
              ClipToBounds="True">
        <Panel>
          <!-- ① 缩略图 -->
          <Image Source="{Binding ThumbnailSource}"
                 Stretch="Uniform"
                 IsVisible="{Binding ThumbnailSource, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <!-- ② 文字片段卡片 -->
          <Border Background="{DynamicResource ThemeSurfaceBgBrush}"
                  BorderBrush="{DynamicResource ThemeBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource BorderRadius}"
                  IsVisible="{Binding TextSnippet, Converter={StaticResource ThumbnailTextNotEmptyConverter}}">
            <TextBlock Text="{Binding TextSnippet}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       Padding="{DynamicResource SpacingXsThk}" />
          </Border>

          <!-- ③ 兜底图标（目录 / 二进制 / 视频 / 超出缩略图上限的条目）
               优先大图标：Windows 取自 Shell 图像列表的 256px 档，按 96px 显示（缩图不糊）；
               拿不到大图标（非 Windows / 该类型无大图）才退回 16px 原尺寸——16px 拉到 96 只会更糊。 -->
          <Image Source="{Binding LargeIconSource}"
                 Width="96" Height="96"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsVisible="{Binding ShowLargeIcon}" />
          <Image Source="{Binding IconSource}"
                 Width="32" Height="32"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsVisible="{Binding ShowSmallIcon}" />

          <!-- ④ 格式角标：缩略图 / 文字卡态把兜底态的格式图标盖住了，这里以 chip 形式还给用户。
               仅在卡片有内容（HasThumbnailContent = 缩略图或文字卡非空）时显示；兜底图标态
               本身就是格式图标，不显示角标避免双图标。目录条目只有兜底态，天然不受影响。
               Margin="0,0,2,2" 为 chip 右上角定位微调常量，豁免间距资源体系（chip 内边距语义）。 -->
          <Border Width="{DynamicResource ControlHeightSm}"
                  Height="{DynamicResource ControlHeightSm}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,0,2,2"
                  Background="{DynamicResource ThemeSurfaceBgBrush}"
                  Opacity="0.9"
                  CornerRadius="{DynamicResource BorderRadius}"
                  IsVisible="{Binding HasThumbnailContent}">
            <Image Source="{Binding IconSource}"
                   Width="14" Height="14"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
          </Border>
        </Panel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <!-- 压缩包内容区：目录树 / 文件列表 / 预览面板 / 拖拽添加覆层
       2026-10-21 启动优化：自 MainWindow.axaml 抽出为独立 UserControl，**按需创建**——
       压缩包未打开时内容区不可见，启动路径无需实例化这 ~153 个元素
       （由 MainWindow.EnsureArchiveContent() 在 IsArchiveLoaded 首次为 true 时创建）。

       根 Grid 即拆分前的 ArchiveContentGrid（列/行定义与子元素坐标原样保留）→ 布局零变化。 -->
    <Grid x:Name="ArchiveContentGrid"
          IsVisible="{Binding IsArchiveLoaded}"
          ColumnDefinitions="1*,5,2.5*,5,3*"
          RowDefinitions="*,0,0">
      <!-- Folder tree panel (col 0) with tree toolbar -->
      <Border x:Name="FolderTreeBorder"
              Grid.Column="0"
              MinWidth="100"
              Background="{DynamicResource ThemeSurfaceBgBrush}">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <!-- Tree toolbar -->
          <Border Grid.Row="0"
                  Padding="4,2"
                  Background="{DynamicResource ThemeHeaderBgBrush}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding ExpandAllCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Tree_ExpandAll]}">
                <PathIcon Data="{StaticResource IconArrowExpandAll}" Width="16" Height="16" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding CollapseAllCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Tree_CollapseAll]}">
                <PathIcon Data="{StaticResource IconArrowCollapseAll}" Width="16" Height="16" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding ExpandToCurrentCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Tree_ExpandToCurrent]}">
                <PathIcon Data="{StaticResource IconLocation}" Width="16" Height="16" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <ToggleButton Classes="ToolbarButton ToolbarIcon"
                            IsChecked="{Binding AutoExpandTree}"
                            IsEnabled="{Binding IsArchiveLoaded}"
                            ToolTip.Tip="{Binding LocalizedStrings[Tree_AutoExpand]}">
                <!-- 图标不写本地 Foreground（会压掉选中态白色），挂全局 class 统一取色 -->
                <PathIcon Data="{StaticResource IconLocationCheckmark}" Width="16" Height="16" Classes="ToolbarButtonIcon" />
              </ToggleButton>
            </StackPanel>
          </Border>
          <!-- Header -->
          <TextBlock Grid.Row="1"
                     Text="{Binding LocalizedStrings[Tree_Browse]}"
                     Margin="8,4"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
          <!-- Tree search -->
          <TextBox Grid.Row="2"
                   MinHeight="{DynamicResource ControlHeightSm}"
                   x:Name="TreeSearchBox"
                   Text="{Binding TreeFilterText}"
                   PlaceholderText="{Binding LocalizedStrings[Tree_Filter]}"
                   Margin="4,0,4,2"
                   Background="{DynamicResource ThemeWindowBgBrush}"
                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                   BorderBrush="{DynamicResource ThemeBorderBrush}" />
          <!-- TreeView with IsExpanded/IsVisible bindings -->
          <TreeView Grid.Row="3"
                    ItemsSource="{Binding FolderTreeItems}"
                    SelectedItem="{Binding SelectedFolder}"
                    BorderThickness="0"
                    Background="Transparent">
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:CompileBindings="False">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                <Setter Property="IsVisible" Value="{Binding IsVisible}" />
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeightSm}" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <!-- Background=Transparent：让整行参与命中测试，点击行内任意位置均可选中 -->
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}"
                            Margin="4,2"
                            Background="Transparent">
                  <!-- 图标按节点类型区分：根节点是压缩包本身（IconArchive），其余目录为 IconFolder -->
                  <PathIcon Data="{Binding IconKey, Converter={StaticResource GeometryResourceConverter}}"
                            Width="16" Height="16"
                            Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                  <TextBlock Text="{Binding Name}"
                            Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Grid>
      </Border>

      <GridSplitter x:Name="TreeFileSplitter"
                    Grid.Column="1"
                    Width="5" />

      <!-- File list panel (col 2) with file list toolbar -->
      <Grid x:Name="FileListPanel"
            Grid.Column="2">
        <Grid RowDefinitions="Auto,Auto,*">
          <!-- File list toolbar -->
          <Border Grid.Row="0"
                  Padding="4,2"
                  Background="{DynamicResource ThemeHeaderBgBrush}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <!-- Navigation group -->
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding GoRootCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Nav_GoRoot]}">
                <PathIcon Data="{StaticResource IconHome}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding GoUpCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                       ToolTip.Tip="{Binding LocalizedStrings[Nav_GoUp]}">
                <PathIcon Data="{StaticResource IconArrowUp}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding GoBackCommand}"
                      IsEnabled="{Binding CanGoBack}"
                      ToolTip.Tip="{Binding LocalizedStrings[Nav_GoBack]}">
                <PathIcon Data="{StaticResource IconChevronLeft}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding GoForwardCommand}"
                      IsEnabled="{Binding CanGoForward}"
                      ToolTip.Tip="{Binding LocalizedStrings[Nav_GoForward]}">
                <PathIcon Data="{StaticResource IconChevronRight}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>

              <!-- Copy name -->
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding CopyFileNameCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Toolbar_CopyName]}">
                <PathIcon Data="{StaticResource IconCopy}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>

              <!-- View mode toggle -->
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding CycleViewModeCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Toolbar_ViewMode]}">
                <PathIcon Data="{StaticResource IconGrid}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <TextBlock Text="{Binding ViewModeLabel}"
                         FontSize="10"
                         Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                         VerticalAlignment="Center" />

              <!-- 布局模式切换（详情 → 平铺 → 内容 三态循环）：图标 + 当前模式文字。
                   图标 IconThumbnails 与 ViewMode 按钮的 IconGrid 视觉区分；
                   文案 LayoutModeLabel 由 VM 按当前模式本地化，随语言切换刷新（规则 13）。 -->
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding CycleLayoutModeCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[LayoutMode_CycleTip]}">
                <PathIcon Data="{StaticResource IconThumbnails}"
                          Width="16" Height="16"
                          Classes="ToolbarButtonIcon"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <TextBlock Text="{Binding LayoutModeLabel}"
                         FontSize="10"
                         Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                         VerticalAlignment="Center" />

              <!-- 复选框模式开关（v0.5.6 复选框多选）：开启后详情列表首列出现复选框，
                   勾选跨目录保持、可批量删除；关闭时行为与引入前完全一致。 -->
              <ToggleButton Classes="ToolbarButton ToolbarIcon"
                            IsChecked="{Binding IsCheckboxMode}"
                            IsEnabled="{Binding IsArchiveLoaded}"
                            ToolTip.Tip="{Binding CheckboxModeLabel}">
                <PathIcon Data="{StaticResource IconCheckmark}"
                          Width="16" Height="16"
                          Classes="ToolbarButtonIcon"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </ToggleButton>

              <Border Width="1" Height="20" Margin="2,0"
                      VerticalAlignment="Center"
                      Background="{DynamicResource ThemeBorderBrush}" />

              <!-- Select All / Invert -->
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding SelectAllCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Toolbar_SelectAll]}">
                <PathIcon Data="{StaticResource IconSelectAll}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding InvertSelectionCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Toolbar_InvertSelection]}">
                <PathIcon Data="{StaticResource IconProhibited}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>

              <Border Width="1" Height="20" Margin="2,0"
                      VerticalAlignment="Center"
                      Background="{DynamicResource ThemeBorderBrush}" />

              <!-- Extract Selected To... -->
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding ExtractSelectedToCommand}"
                      IsVisible="False"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Tooltip_ExtractSelectedTo]}">
                <PathIcon Data="{StaticResource IconExport}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding ExtractSelectedHereCommand}"
                      IsVisible="False"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Tooltip_ExtractSelectedHere]}">
                <PathIcon Data="{StaticResource IconPin}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>

              <Border Width="1" Height="20" Margin="2,0"
                      VerticalAlignment="Center"
                      Background="{DynamicResource ThemeBorderBrush}" />

              <!-- Refresh -->
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding RefreshArchiveCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Toolbar_Refresh]}">
                <PathIcon Data="{StaticResource IconRefresh}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>

              <Border Width="1" Height="20" Margin="2,0"
                      VerticalAlignment="Center"
                      Background="{DynamicResource ThemeBorderBrush}" />

              <!-- Flatten toggle (moved from global toolbar) -->
              <ToggleButton Classes="ToolbarButton ToolbarIcon"
                            IsChecked="{Binding ShowSubfolders}"
                            IsEnabled="{Binding IsArchiveLoaded}"
                            ToolTip.Tip="{Binding LocalizedStrings[Tooltip_Subfolders]}">
                <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" Classes="ToolbarButtonIcon" />
              </ToggleButton>
            </StackPanel>
          </Border>

          <!-- Address bar row -->
          <Border Grid.Row="1"
                  Padding="6,3"
                  Background="{DynamicResource ThemeHeaderBgBrush}">
            <controls:PathBreadcrumb
                                     x:Name="AddressBar"
                                     PathKind="Virtual"
                                     Path="{Binding CurrentFolder, Mode=OneWay}"
                                     FilterMode="StartsWith"
                                     ArchiveRootTooltipKey="Breadcrumb_ArchiveRoot"
                                     EditPlaceholderKey="Breadcrumb_EditPlaceholder" />
          </Border>

          <!-- DataGrid（详情布局）：三布局容器之一，仅在 IsDetailsLayout 时可见 -->
          <DataGrid x:Name="FileListGrid"
                    Grid.Row="2"
                    IsVisible="{Binding IsDetailsLayout}"
                    ItemsSource="{Binding CurrentEntries}"
                    SelectedItem="{Binding SelectedEntry}"
                    AutoGenerateColumns="False"
                    CanUserSortColumns="True"
                    CanUserResizeColumns="True"
                    CanUserReorderColumns="True"
                    IsReadOnly="True"
                    RowHeight="{DynamicResource ControlHeightMd}"
                    >
            <DataGrid.Styles>
              <!-- 列标题右键菜单：切换列显隐（菜单项在 Opening 事件中动态构建，见 ColumnHeaderContextMenu_Opening） -->
              <Style Selector="DataGridColumnHeader">
                <Setter Property="ContextMenu">
                  <ContextMenu Opening="ColumnHeaderContextMenu_Opening" />
                </Setter>
              </Style>
            </DataGrid.Styles>
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{Binding LocalizedStrings[Ctx_Extract]}"
                          Command="{Binding ExtractArchiveCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_ExtractSelectedHere]}"
                          Command="{Binding ExtractSelectedHereCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_ExtractSelectedTo]}"
                          Command="{Binding ExtractSelectedToCommand}" />
                <Separator />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_SmartExtract]}"
                          Command="{Binding SmartExtractCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_ExtractTo]}"
                          Command="{Binding ExtractToCommand}" />
                <Separator />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_CopyName]}"
                          Command="{Binding CopyFileNameCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_CopyPath]}"
                          Command="{Binding CopyFilePathCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_Test]}"
                          Command="{Binding TestEntryCommand}" />
                <Separator />
                <!-- 复选框模式专用：勾选集合的批量操作（勾选态与选区同一份事实源，故此处直接改勾选） -->
                <MenuItem Header="{Binding LocalizedStrings[Menu_CheckAllVisible]}"
                          Command="{Binding CheckAllVisibleCommand}"
                          IsVisible="{Binding IsCheckboxMode}" />
                <MenuItem Header="{Binding LocalizedStrings[Menu_InvertChecked]}"
                          Command="{Binding InvertCheckedCommand}"
                          IsVisible="{Binding IsCheckboxMode}" />
                <MenuItem Header="{Binding LocalizedStrings[Menu_ClearChecked]}"
                          Command="{Binding ClearCheckedCommand}"
                          IsVisible="{Binding IsCheckboxMode}" />
                <Separator />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_Delete]}"
                          Command="{Binding DeleteFilesCommand}"
                          IsEnabled="{Binding CanDeleteEntries}" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <!-- 复选框列（v0.5.6 复选框多选）：勾选落到 VM.SelectedEntries（唯一事实源），不是第二份集合。
                   显隐由 code-behind 按 Tag="Checkbox" 命令式切换 —— DataGridColumn 不在视觉树上、
                   不继承 DataContext，列上的 IsVisible 绑定不会生效（绑定静默失败）。 -->
              <DataGridTemplateColumn Header="" Width="30" Tag="Checkbox">
                <DataTemplate>
                  <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MinWidth="0" />
                </DataTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="" Width="22" Tag="Icon">
                <DataTemplate>
                  <Image Source="{Binding IconSource}"
                         Width="16" Height="16"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn SortMemberPath="Name"
                                  Width="250"
                                  MinWidth="120"
                                  MaxWidth="800">
                <DataGridTextColumn.Header>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <PathIcon Data="{StaticResource IconCopy}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        <TextBlock Text="{Binding LocalizedStrings[DataGrid_Name]}" />
                        <TextBlock x:Name="NameHeaderArrow" Width="12" FontSize="10" VerticalAlignment="Center" Text="" />
                    </StackPanel>
                </DataGridTextColumn.Header>
                <DataGridTextColumn.Binding>
                  <Binding Path="NameDisplay" />
                </DataGridTextColumn.Binding>
              </DataGridTextColumn>
              <DataGridTemplateColumn SortMemberPath="Size"
                                      Width="80"
                                      MinWidth="60"
                                      MaxWidth="400">
                <DataGridTemplateColumn.Header>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <PathIcon Data="{StaticResource IconRuler}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        <TextBlock Text="{Binding LocalizedStrings[DataGrid_Size]}" />
                        <TextBlock x:Name="SizeHeaderArrow" Width="12" FontSize="10" VerticalAlignment="Center" Text="" />
                    </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <!-- 数据条底色：文件用淡色、目录用饱和色（目录基线开启时）。
                           2026-10-22：原为单个 Rectangle 写死 Fill，模型算出的 UseDirProgressColor
                           无人使用 → 目录条与文件条同色。改为双 Rectangle 叠加 + IsVisible 切换，
                           保持 DynamicResource 随主题自动切换（不用 key→brush 转换器）。 -->
                      <Rectangle Fill="{DynamicResource ProgressBarSizeBrush}"
                                 HorizontalAlignment="Left"
                                 IsVisible="{Binding !UseDirProgressColor}">
                        <Rectangle.Width>
                          <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                            <Binding Path="SizeRatio" />
                            <Binding Path="Bounds.Width"
                                     RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                          </MultiBinding>
                        </Rectangle.Width>
                      </Rectangle>
                      <Rectangle Fill="{DynamicResource ProgressBarSizeDirBrush}"
                                 HorizontalAlignment="Left"
                                 IsVisible="{Binding UseDirProgressColor}">
                        <Rectangle.Width>
                          <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                            <Binding Path="SizeRatio" />
                            <Binding Path="Bounds.Width"
                                     RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                          </MultiBinding>
                        </Rectangle.Width>
                      </Rectangle>
                      <TextBlock Text="{Binding SizeDisplay}"
                                 VerticalAlignment="Center"
                                 Margin="4,0" />

                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn SortMemberPath="CompressedSize"
                                      Width="70"
                                      MinWidth="60"
                                      MaxWidth="400">
                <DataGridTemplateColumn.Header>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <PathIcon Data="{StaticResource IconCompress}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        <TextBlock Text="{Binding LocalizedStrings[DataGrid_Compressed]}" />
                        <TextBlock x:Name="CompressedSizeHeaderArrow" Width="12" FontSize="10" VerticalAlignment="Center" Text="" />
                    </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <!-- 数据条底色：文件淡紫 / 目录饱和紫（同大小列，目录基线开启时切目录色） -->
                      <Rectangle Fill="{DynamicResource ProgressBarCompressedSizeBrush}"
                                 HorizontalAlignment="Left"
                                 IsVisible="{Binding !UseDirProgressColor}">
                        <Rectangle.Width>
                          <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                            <Binding Path="CompressedSizeRatio" />
                            <Binding Path="Bounds.Width"
                                     RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                          </MultiBinding>
                        </Rectangle.Width>
                      </Rectangle>
                      <Rectangle Fill="{DynamicResource ProgressBarCompressedSizeDirBrush}"
                                 HorizontalAlignment="Left"
                                 IsVisible="{Binding UseDirProgressColor}">
                        <Rectangle.Width>
                          <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                            <Binding Path="CompressedSizeRatio" />
                            <Binding Path="Bounds.Width"
                                     RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                          </MultiBinding>
                        </Rectangle.Width>
                      </Rectangle>
                      <TextBlock Text="{Binding CompressedSizeDisplay}"
                                 VerticalAlignment="Center"
                                 Margin="4,0" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn SortMemberPath="RatioSort"
                                      Width="70"
                                      MinWidth="60"
                                      MaxWidth="300">
                <DataGridTemplateColumn.Header>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <PathIcon Data="{StaticResource IconDataBarVertical}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        <TextBlock Text="{Binding LocalizedStrings[DataGrid_Ratio]}" />
                        <TextBlock x:Name="RatioHeaderArrow" Width="12" FontSize="10" VerticalAlignment="Center" Text="" />
                    </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <Rectangle Fill="{DynamicResource ProgressBarRatioBrush}"
                                 HorizontalAlignment="Left">
                        <Rectangle.Width>
                          <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                            <Binding Path="RatioBarValue" />
                            <Binding Path="Bounds.Width"
                                     RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                          </MultiBinding>
                        </Rectangle.Width>
                      </Rectangle>
                      <TextBlock Text="{Binding RatioDisplay}"
                                 VerticalAlignment="Center"
                                 Margin="4,0" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn SortMemberPath="LastModified"
                                      Width="100"
                                      MinWidth="80"
                                      MaxWidth="400">
                <DataGridTemplateColumn.Header>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <PathIcon Data="{StaticResource IconCalendar}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        <TextBlock Text="{Binding LocalizedStrings[DataGrid_Modified]}" />
                        <TextBlock x:Name="LastModifiedHeaderArrow" Width="12" FontSize="10" VerticalAlignment="Center" Text="" />
                    </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <Rectangle Fill="{DynamicResource ProgressBarDateBrush}"
                                 HorizontalAlignment="Left">
                        <Rectangle.Width>
                          <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                            <Binding Path="DateRatio" />
                            <Binding Path="Bounds.Width"
                                     RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                          </MultiBinding>
                        </Rectangle.Width>
                      </Rectangle>
                      <TextBlock Text="{Binding LastModifiedDisplay}"
                                 VerticalAlignment="Center"
                                 Margin="4,0" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <!-- ══════════════ 平铺布局（Tile）：缩略图网格 ══════════════
               与 DataGrid 同处 Grid.Row=2，按 IsDetailsLayout / IsTileLayout / IsContentLayout 三选一显示。
               Avalonia 12 已移除 ItemsRepeater / UniformGridLayout / StackLayout，故用 ItemsControl +
               WrapPanel 铺网格（无 UI 虚拟化：缩略图由 VM 侧 ThumbnailService 限流批量加载，不依赖虚拟化）。
               事件接线：ThumbnailLayout_*（按下/移动/键盘/右键）与 ThumbnailItem_DoubleTapped 由
               MainWindow.Thumbnails.cs 的 SetupThumbnailLayoutEvents →
               HookThumbnailLayoutContainer("TileLayoutScrollViewer") 按 x:Name 在代码里订阅
               （Tunnel 阶段 + 容器级 DoubleTapped 兜底），因此这里不写 XAML 事件属性。 -->
          <!-- ══════ 平铺布局假列头：仿 Details 列头；右键 = 行显隐菜单（唯一入口），
               左键 = 排序（三态循环与 Details 列头同语义，共用窗口级排序状态） ══════
               最左「名称」单元恒显（名称不是信息行，兼做排序与全关时的右键宿主）；
               信息行单元显隐与对应迷你行同步（DynamicResource 行资源）；
               全关信息行时剩「名称」+ 空背景条，排序与右键入口均永在 -->
          <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <Border x:Name="TileRowHeaderBorder"
                    Grid.Row="0"
                    Tag="TileRowHeader"
                    IsVisible="{Binding IsTileLayout}"
                    Height="{DynamicResource ControlHeightMd}"
                    VerticalAlignment="Top"
                    Background="{DynamicResource ThemeHeaderBgBrush}"
                    BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="{DynamicResource SpacingXsThk}">
              <Border.ContextMenu>
                <!-- ⚠ Tile/Content 判定走本菜单 Tag（2026-11-07 回归：Avalonia 打开菜单时
                     PlacementTarget 不自动回填（恒 null，WPF 语义），判别必须用菜单自带标识，
                     回归见 CardRowHeaderMenuTests -->
                <ContextMenu Opening="CardRowHeaderContextMenu_Opening" Tag="Tile" />
              </Border.ContextMenu>
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
                <!-- ①「名称」：恒显（不可隐藏），左键 = 名称排序（DataGrid_Name 现有三语 key） -->
                <Border Tag="Tile:Name"
                        Width="{DynamicResource ThumbnailTileCellWidth}"
                        Background="Transparent"
                        Tapped="CardHeaderUnit_Tapped">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <PathIcon Data="{StaticResource IconCopy}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                    <TextBlock Text="{Binding LocalizedStrings[DataGrid_Name]}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TileSortArrowName" Width="12" FontSize="10" VerticalAlignment="Center" Text="" />
                  </StackPanel>
                </Border>
                <!-- ② 信息行单元（四个，见 CardRowCatalog）：图标/文字/排序路径与 Details 列头同款；
                     IsVisible 与对应迷你行绑同一行资源 ⇒ 隐藏行连列头一起消失 -->
                <Border Tag="Tile:Size"
                        Width="{DynamicResource ThumbnailTileCellWidth}"
                        Background="Transparent"
                        IsVisible="{DynamicResource ThumbnailRowSizeVisible}"
                        Tapped="CardHeaderUnit_Tapped">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <PathIcon Data="{StaticResource IconRuler}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                    <TextBlock Text="{Binding LocalizedStrings[DataGrid_Size]}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TileSortArrowSize" Width="12" FontSize="10" VerticalAlignment="Center" Text="" />
                  </StackPanel>
                </Border>
                <Border Tag="Tile:CompressedSize"
                        Width="{DynamicResource ThumbnailTileCellWidth}"
                        Background="Transparent"
                        IsVisible="{DynamicResource ThumbnailRowCompressedSizeVisible}"
                        Tapped="CardHeaderUnit_Tapped">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <PathIcon Data="{StaticResource IconCompress}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                    <TextBlock Text="{Binding LocalizedStrings[DataGrid_Compressed]}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TileSortArrowCompressedSize" Width="12" FontSize="10" VerticalAlignment="Center" Text="" />
                  </StackPanel>
                </Border>
                <Border Tag="Tile:RatioSort"
                        Width="{DynamicResource ThumbnailTileCellWidth}"
                        Background="Transparent"
                        IsVisible="{DynamicResource ThumbnailRowRatioVisible}"
                        Tapped="CardHeaderUnit_Tapped">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <PathIcon Data="{StaticResource IconDataBarVertical}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                    <TextBlock Text="{Binding LocalizedStrings[DataGrid_Ratio]}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TileSortArrowRatioSort" Width="12" FontSize="10" VerticalAlignment="Center" Text="" />
                  </StackPanel>
                </Border>
                <Border Tag="Tile:LastModified"
                        Width="{DynamicResource ThumbnailTileCellWidth}"
                        Background="Transparent"
                        IsVisible="{DynamicResource ThumbnailRowDateVisible}"
                        Tapped="CardHeaderUnit_Tapped">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <PathIcon Data="{StaticResource IconCalendar}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                    <TextBlock Text="{Binding LocalizedStrings[DataGrid_Modified]}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TileSortArrowLastModified" Width="12" FontSize="10" VerticalAlignment="Center" Text="" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          <ScrollViewer x:Name="TileLayoutScrollViewer"
                        Grid.Row="1"
                        IsVisible="{Binding IsTileLayout}"
                        Background="{DynamicResource ThemeSurfaceBgBrush}"
                        Padding="{DynamicResource SpacingXsThk}"
                        HorizontalScrollBarVisibility="Disabled"
                        Focusable="True">
            <!-- 右键菜单：与 DataGrid 内联菜单同构（DataContext 同为窗口 VM，命令绑定原样复用） -->
            <ScrollViewer.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{Binding LocalizedStrings[Ctx_Extract]}"
                          Command="{Binding ExtractArchiveCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_ExtractSelectedHere]}"
                          Command="{Binding ExtractSelectedHereCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_ExtractSelectedTo]}"
                          Command="{Binding ExtractSelectedToCommand}" />
                <Separator />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_SmartExtract]}"
                          Command="{Binding SmartExtractCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_ExtractTo]}"
                          Command="{Binding ExtractToCommand}" />
                <Separator />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_CopyName]}"
                          Command="{Binding CopyFileNameCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_CopyPath]}"
                          Command="{Binding CopyFilePathCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_Test]}"
                          Command="{Binding TestEntryCommand}" />
                <Separator />
                <!-- 复选框模式专用：勾选集合的批量操作（勾选态与选区同一份事实源，故此处直接改勾选） -->
                <MenuItem Header="{Binding LocalizedStrings[Menu_CheckAllVisible]}"
                          Command="{Binding CheckAllVisibleCommand}"
                          IsVisible="{Binding IsCheckboxMode}" />
                <MenuItem Header="{Binding LocalizedStrings[Menu_InvertChecked]}"
                          Command="{Binding InvertCheckedCommand}"
                          IsVisible="{Binding IsCheckboxMode}" />
                <MenuItem Header="{Binding LocalizedStrings[Menu_ClearChecked]}"
                          Command="{Binding ClearCheckedCommand}"
                          IsVisible="{Binding IsCheckboxMode}" />
                <Separator />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_Delete]}"
                          Command="{Binding DeleteFilesCommand}"
                          IsEnabled="{Binding CanDeleteEntries}" />
              </ContextMenu>
            </ScrollViewer.ContextMenu>
            <ItemsControl ItemsSource="{Binding CurrentEntries}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <!-- 网格铺排：格子宽 = 卡片边长 + 16（外壳内边距 + 间距），由设置 → 外观 → 缩略图决定 -->
                  <WrapPanel Orientation="Horizontal"
                             ItemWidth="{DynamicResource ThumbnailTileCellWidth}"
                             ItemSpacing="{DynamicResource SpacingXxs}"
                             LineSpacing="{DynamicResource SpacingXxs}"
                             ItemsAlignment="Start" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ArchiveItemModel">
                  <!-- 单个缩略图项：外壳 Border 承载选中高亮。
                       宽度 = 卡片边长 + 8（2×4 内边距，Padding 取 SpacingXxsThk：SpacingSmThk 的 12
                       会让卡片溢出格子）；MinHeight 走紧凑度资源（规则 7）。 -->
                  <Border Width="{DynamicResource ThumbnailTileItemWidth}"
                          MinHeight="{DynamicResource ControlHeightXxl}"
                          Padding="{DynamicResource SpacingXxsThk}"
                          CornerRadius="{DynamicResource BorderRadius}"
                          Background="{Binding IsSelected, Converter={StaticResource ThumbnailSelectedBrushConverter}}">
                      <!-- 单个缩略图卡 + 复选框模式的勾选框（勾选框只显示状态，点击由卡片热区统一处理） -->
                      <Panel>
                        <StackPanel Spacing="{DynamicResource SpacingXxs}">
                          <!-- 三态内容卡（缩略图 / 文字片段 / 类型图标） -->
                          <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource ThumbnailContentCard}"
                                HorizontalAlignment="Center" />
                          <TextBlock Text="{Binding NameDisplay}"
                                FontSize="11"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                          <!-- ══════ Tile 迷你信息行（假列头右键菜单控制显隐；数据条跟随 ShowProgressBars）════════
                               结构与 Details 列的 CellTemplate 同构：数据条底纹（文件/目录双 Rectangle，
                               UseDirProgressColor 切换）+ 文字覆盖；条宽 = RatioToWidthConverter(比例, 行宽)。
                               ⚠ 行宽基准是**本行 Grid 自身**（AncestorType=Grid），不是列表项 ContentPresenter：
                               Tile 的格子宽 = 卡片 + 16，卡片内宽只有 卡片 - 8，用格子宽会让 100% 的条
                               伸出卡片边框（2026-11-07 用户报障；回归见 CardRowDataBarLayoutTests）。
                               行显隐由 App 注入的行资源（TileRowShow*）经 DynamicResource 驱动 ⇒
                               假列头菜单切换即时生效、不走缩略图重解码；行高走紧凑度资源（规则 7）。
                               Margin="4,0" 与 Details 数据条文字一致。 -->
                          <Grid MinHeight="{DynamicResource ControlHeightSm}"
                                IsVisible="{DynamicResource ThumbnailRowSizeVisible}">
                            <Rectangle Fill="{DynamicResource ProgressBarSizeBrush}"
                                       HorizontalAlignment="Left"
                                       IsVisible="{Binding !UseDirProgressColor}">
                              <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                                  <Binding Path="SizeRatio" />
                                  <Binding Path="Bounds.Width"
                                           RelativeSource="{RelativeSource AncestorType=Grid}" />
                                </MultiBinding>
                              </Rectangle.Width>
                            </Rectangle>
                            <Rectangle Fill="{DynamicResource ProgressBarSizeDirBrush}"
                                       HorizontalAlignment="Left"
                                       IsVisible="{Binding UseDirProgressColor}">
                              <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                                  <Binding Path="SizeRatio" />
                                  <Binding Path="Bounds.Width"
                                           RelativeSource="{RelativeSource AncestorType=Grid}" />
                                </MultiBinding>
                              </Rectangle.Width>
                            </Rectangle>
                            <TextBlock Text="{Binding SizeDisplay}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="4,0"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                          </Grid>
                          <Grid MinHeight="{DynamicResource ControlHeightSm}"
                                IsVisible="{DynamicResource ThumbnailRowCompressedSizeVisible}">
                            <Rectangle Fill="{DynamicResource ProgressBarCompressedSizeBrush}"
                                       HorizontalAlignment="Left"
                                       IsVisible="{Binding !UseDirProgressColor}">
                              <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                                  <Binding Path="CompressedSizeRatio" />
                                  <Binding Path="Bounds.Width"
                                           RelativeSource="{RelativeSource AncestorType=Grid}" />
                                </MultiBinding>
                              </Rectangle.Width>
                            </Rectangle>
                            <Rectangle Fill="{DynamicResource ProgressBarCompressedSizeDirBrush}"
                                       HorizontalAlignment="Left"
                                       IsVisible="{Binding UseDirProgressColor}">
                              <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                                  <Binding Path="CompressedSizeRatio" />
                                  <Binding Path="Bounds.Width"
                                           RelativeSource="{RelativeSource AncestorType=Grid}" />
                                </MultiBinding>
                              </Rectangle.Width>
                            </Rectangle>
                            <TextBlock Text="{Binding CompressedSizeDisplay}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="4,0"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                          </Grid>
                          <Grid MinHeight="{DynamicResource ControlHeightSm}"
                                IsVisible="{DynamicResource ThumbnailRowRatioVisible}">
                            <!-- 压缩率：仅单画刷（与 Details 同款，无目录变体） -->
                            <Rectangle Fill="{DynamicResource ProgressBarRatioBrush}"
                                       HorizontalAlignment="Left">
                              <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                                  <Binding Path="RatioBarValue" />
                                  <Binding Path="Bounds.Width"
                                           RelativeSource="{RelativeSource AncestorType=Grid}" />
                                </MultiBinding>
                              </Rectangle.Width>
                            </Rectangle>
                            <TextBlock Text="{Binding RatioDisplay}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="4,0"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                          </Grid>
                          <Grid MinHeight="{DynamicResource ControlHeightSm}"
                                IsVisible="{DynamicResource ThumbnailRowDateVisible}">
                            <!-- 修改日期：单画刷（与 Details 同款）；短日期 yyyy-MM-dd（Tile 格宽放不下完整时间戳） -->
                            <Rectangle Fill="{DynamicResource ProgressBarDateBrush}"
                                       HorizontalAlignment="Left">
                              <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                                  <Binding Path="DateRatio" />
                                  <Binding Path="Bounds.Width"
                                           RelativeSource="{RelativeSource AncestorType=Grid}" />
                                </MultiBinding>
                              </Rectangle.Width>
                            </Rectangle>
                            <TextBlock Text="{Binding LastModifiedShortDisplay}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="4,0"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                          </Grid>
                        </StackPanel>
                        <!-- 复选框模式的勾选框：整张卡片是勾选热区，Shift 连勾 / 单张切换的逻辑在
                             MainWindow.Thumbnails.cs 的 ThumbnailLayout_PointerPressed；复选框自己不吃点击，
                             否则会和卡片热区各切换一次而互相抵消。 -->
                        <CheckBox MinWidth="0"
                                Padding="0"
                                Margin="{DynamicResource SpacingXxsThk}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).IsCheckboxMode}" />
                      </Panel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          </Grid>

          <!-- ══════════════ 内容布局（Content）：左侧内容卡 + 右侧元数据 ══════════════
               行 = 横向 Grid（左 128px 三态内容卡 + 右名称/大小/压缩后/压缩率/修改日期），
               事件与菜单接线方式与平铺布局完全一致（代码侧按 ContentLayoutScrollViewer 订阅）。 -->
          <!-- 内容布局外壳：假列头 + 滚动区（包壳方式与平铺布局一致） -->
          <Grid Grid.Row="2" RowDefinitions="Auto,*">
          <Border x:Name="ContentRowHeaderBorder"
                  Grid.Row="0"
                  Tag="ContentRowHeader"
                  IsVisible="{Binding IsContentLayout}"
                  Height="{DynamicResource ControlHeightMd}"
                  VerticalAlignment="Top"
                  Background="{DynamicResource ThemeHeaderBgBrush}"
                  BorderBrush="{DynamicResource ThemeBorderLightBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="{DynamicResource SpacingXsThk}">
            <Border.ContextMenu>
              <!-- ⚠ Tile/Content 判定走本菜单 Tag（同 Tile 列头，2026-11-07 回归） -->
              <ContextMenu Opening="CardRowHeaderContextMenu_Opening" Tag="Content" />
            </Border.ContextMenu>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <!-- 左垫位：内容行左侧三态内容卡的区域（卡片边长 + 行内边距），让标签单元落到元数据块起点 -->
              <Border Width="{DynamicResource ThumbnailTileCellWidth}" />
              <!-- 「名称」恒显单元（行内是元数据块首行加粗名称，未加 : 标签列——用同宽单元对齐） -->
              <Border Tag="Content:Name"
                      Width="{DynamicResource ContentRowLabelColumnWidth}"
                      Background="Transparent"
                      Tapped="CardHeaderUnit_Tapped">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <PathIcon Data="{StaticResource IconCopy}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                  <TextBlock Text="{Binding LocalizedStrings[DataGrid_Name]}" VerticalAlignment="Center" />
                  <TextBlock x:Name="ContentSortArrowName" Width="12" FontSize="10" VerticalAlignment="Center" Text="" />
                </StackPanel>
              </Border>
              <!-- 四个信息行单元：定宽标签列（与元数据行标签列同键 ContentRowLabelColumnWidth）；
                   IsVisible 与对应元数据行绑同一行资源 ⇒ 隐藏行连列头一起消失 -->
              <Border Tag="Content:Size"
                      Width="{DynamicResource ContentRowLabelColumnWidth}"
                      Background="Transparent"
                      IsVisible="{DynamicResource ThumbnailContentRowSizeVisible}"
                      Tapped="CardHeaderUnit_Tapped">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <PathIcon Data="{StaticResource IconRuler}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                  <TextBlock Text="{Binding LocalizedStrings[DataGrid_Size]}" VerticalAlignment="Center" />
                  <TextBlock x:Name="ContentSortArrowSize" Width="12" FontSize="10" VerticalAlignment="Center" Text="" />
                </StackPanel>
              </Border>
              <Border Tag="Content:CompressedSize"
                      Width="{DynamicResource ContentRowLabelColumnWidth}"
                      Background="Transparent"
                      IsVisible="{DynamicResource ThumbnailContentRowCompressedSizeVisible}"
                      Tapped="CardHeaderUnit_Tapped">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <PathIcon Data="{StaticResource IconCompress}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                  <TextBlock Text="{Binding LocalizedStrings[DataGrid_Compressed]}" VerticalAlignment="Center" />
                  <TextBlock x:Name="ContentSortArrowCompressedSize" Width="12" FontSize="10" VerticalAlignment="Center" Text="" />
                </StackPanel>
              </Border>
              <Border Tag="Content:RatioSort"
                      Width="{DynamicResource ContentRowLabelColumnWidth}"
                      Background="Transparent"
                      IsVisible="{DynamicResource ThumbnailContentRowRatioVisible}"
                      Tapped="CardHeaderUnit_Tapped">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <PathIcon Data="{StaticResource IconDataBarVertical}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                  <TextBlock Text="{Binding LocalizedStrings[DataGrid_Ratio]}" VerticalAlignment="Center" />
                  <TextBlock x:Name="ContentSortArrowRatioSort" Width="12" FontSize="10" VerticalAlignment="Center" Text="" />
                </StackPanel>
              </Border>
              <Border Tag="Content:LastModified"
                      Width="{DynamicResource ContentRowLabelColumnWidth}"
                      Background="Transparent"
                      IsVisible="{DynamicResource ThumbnailContentRowDateVisible}"
                      Tapped="CardHeaderUnit_Tapped">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <PathIcon Data="{StaticResource IconCalendar}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                  <TextBlock Text="{Binding LocalizedStrings[DataGrid_Modified]}" VerticalAlignment="Center" />
                  <TextBlock x:Name="ContentSortArrowLastModified" Width="12" FontSize="10" VerticalAlignment="Center" Text="" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <ScrollViewer x:Name="ContentLayoutScrollViewer"
                        Grid.Row="1"
                        IsVisible="{Binding IsContentLayout}"
                        Background="{DynamicResource ThemeSurfaceBgBrush}"
                        Padding="{DynamicResource SpacingXsThk}"
                        HorizontalScrollBarVisibility="Disabled"
                        Focusable="True">
            <!-- 右键菜单：与 DataGrid 内联菜单同构 -->
            <ScrollViewer.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{Binding LocalizedStrings[Ctx_Extract]}"
                          Command="{Binding ExtractArchiveCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_ExtractSelectedHere]}"
                          Command="{Binding ExtractSelectedHereCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_ExtractSelectedTo]}"
                          Command="{Binding ExtractSelectedToCommand}" />
                <Separator />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_SmartExtract]}"
                          Command="{Binding SmartExtractCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_ExtractTo]}"
                          Command="{Binding ExtractToCommand}" />
                <Separator />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_CopyName]}"
                          Command="{Binding CopyFileNameCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_CopyPath]}"
                          Command="{Binding CopyFilePathCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_Test]}"
                          Command="{Binding TestEntryCommand}" />
                <Separator />
                <!-- 复选框模式专用：勾选集合的批量操作（勾选态与选区同一份事实源，故此处直接改勾选） -->
                <MenuItem Header="{Binding LocalizedStrings[Menu_CheckAllVisible]}"
                          Command="{Binding CheckAllVisibleCommand}"
                          IsVisible="{Binding IsCheckboxMode}" />
                <MenuItem Header="{Binding LocalizedStrings[Menu_InvertChecked]}"
                          Command="{Binding InvertCheckedCommand}"
                          IsVisible="{Binding IsCheckboxMode}" />
                <MenuItem Header="{Binding LocalizedStrings[Menu_ClearChecked]}"
                          Command="{Binding ClearCheckedCommand}"
                          IsVisible="{Binding IsCheckboxMode}" />
                <Separator />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_Delete]}"
                          Command="{Binding DeleteFilesCommand}"
                          IsEnabled="{Binding CanDeleteEntries}" />
              </ContextMenu>
            </ScrollViewer.ContextMenu>
            <ItemsControl ItemsSource="{Binding CurrentEntries}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <!-- 纵向列表：行间距用紧凑度资源 -->
                  <StackPanel Orientation="Vertical" Spacing="{DynamicResource SpacingXxs}" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ArchiveItemModel">
                  <!-- 单行：左内容卡 + 右元数据块（名称加粗 14px + 四行「标签: 值」）
                       左列用 Auto（卡片自带宽高资源），缩略图尺寸变化时自动跟随，无需改列宽 -->
                  <Border MinHeight="{DynamicResource ControlHeightXxl}"
                          Padding="{DynamicResource SpacingXsThk}"
                          CornerRadius="{DynamicResource BorderRadius}"
                          Background="{Binding IsSelected, Converter={StaticResource ThumbnailSelectedBrushConverter}}">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="{DynamicResource SpacingSm}">
                      <Panel Grid.Column="0">
                        <ContentControl Content="{Binding}"
                                  ContentTemplate="{StaticResource ThumbnailContentCard}"
                                  VerticalAlignment="Top" />
                        <!-- 复选框模式的勾选框（只显示状态；点击由行热区统一处理，见 MainWindow.Thumbnails.cs） -->
                        <CheckBox MinWidth="0"
                                  Padding="0"
                                  Margin="{DynamicResource SpacingXxsThk}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  IsHitTestVisible="False"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  IsVisible="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).IsCheckboxMode}" />
                      </Panel>
                      <!-- 右侧信息块与左侧缩略图**顶边对齐**（2026-11-08 用户报障：原 VerticalAlignment=Center
                           让它在行内居中下沉，和缩略图错位）。水平间距改由 Grid.ColumnSpacing 提供，
                           不再用 Margin 的竖直分量——否则顶边还会差 8px。回归见 CardRowContentAlignmentTests。 -->
                      <StackPanel Grid.Column="1"
                                  Spacing="{DynamicResource SpacingXxs}"
                                  VerticalAlignment="Top">
                        <TextBlock Text="{Binding NameDisplay}"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        <!-- ══════ 元数据四行（T4 改版）：定宽标签列（与假列头同键对齐）+ 数据条底纹
                             + 行开关（DynamicResource 行资源，假列头右键菜单控制显隐）。
                             条结构 = Details CellTemplate 同款：文件/目录双 Rectangle（UseDirProgressColor 切换）
                             + 宽度 RatioToWidthConverter(比例, 行宽) + 文字覆盖；数据条跟随 ShowProgressBars。
                             ⚠ 行宽基准是**本行 Grid 自身**（AncestorType=Grid），不是列表项 ContentPresenter：
                             后者是整行宽度（含左侧缩略图卡），会让 100% 的条伸出右侧元数据栏
                             （2026-11-07 同 Tile 一起修复；回归见 CardRowDataBarLayoutTests）。 -->
                        <Grid MinHeight="{DynamicResource ControlHeightSm}"
                              IsVisible="{DynamicResource ThumbnailContentRowSizeVisible}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" /><!-- ⚠ GridLength 属性不得绑 {DynamicResource}（2026-11-07 崩溃回归：
                                                  ContentRowLabelColumnWidth 资源是 sys:Double，绑给 GridLength 类型的
                                                  Columns.Width 在行挂树重求值时 double→GridLength 强转抛 InvalidCastException，
                                                  整进程终止——修复 = 本处用字面常量；值必须与 ContentRowLabelColumnWidth
                                                  资源保持一致（改任一处必须同步另一处）） -->
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Rectangle Grid.ColumnSpan="2"
                                     Fill="{DynamicResource ProgressBarSizeBrush}"
                                     HorizontalAlignment="Left"
                                     IsVisible="{Binding !UseDirProgressColor}">
                            <Rectangle.Width>
                              <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                                <Binding Path="SizeRatio" />
                                <Binding Path="Bounds.Width"
                                         RelativeSource="{RelativeSource AncestorType=Grid}" />
                              </MultiBinding>
                            </Rectangle.Width>
                          </Rectangle>
                          <Rectangle Grid.ColumnSpan="2"
                                     Fill="{DynamicResource ProgressBarSizeDirBrush}"
                                     HorizontalAlignment="Left"
                                     IsVisible="{Binding UseDirProgressColor}">
                            <Rectangle.Width>
                              <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                                <Binding Path="SizeRatio" />
                                <Binding Path="Bounds.Width"
                                         RelativeSource="{RelativeSource AncestorType=Grid}" />
                              </MultiBinding>
                            </Rectangle.Width>
                          </Rectangle>
                          <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).LocalizedStrings[DataGrid_Size]}"
                                       FontSize="11"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                            <TextBlock Text=":"
                                       FontSize="11"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding SizeDisplay}"
                                     FontSize="11"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        </Grid>
                        <Grid MinHeight="{DynamicResource ControlHeightSm}"
                              IsVisible="{DynamicResource ThumbnailContentRowCompressedSizeVisible}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" /><!-- ⚠ GridLength 属性不得绑 {DynamicResource}（2026-11-07 崩溃回归：
                                                  ContentRowLabelColumnWidth 资源是 sys:Double，绑给 GridLength 类型的
                                                  Columns.Width 在行挂树重求值时 double→GridLength 强转抛 InvalidCastException，
                                                  整进程终止——修复 = 本处用字面常量；值必须与 ContentRowLabelColumnWidth
                                                  资源保持一致（改任一处必须同步另一处）） -->
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Rectangle Grid.ColumnSpan="2"
                                     Fill="{DynamicResource ProgressBarCompressedSizeBrush}"
                                     HorizontalAlignment="Left"
                                     IsVisible="{Binding !UseDirProgressColor}">
                            <Rectangle.Width>
                              <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                                <Binding Path="CompressedSizeRatio" />
                                <Binding Path="Bounds.Width"
                                         RelativeSource="{RelativeSource AncestorType=Grid}" />
                              </MultiBinding>
                            </Rectangle.Width>
                          </Rectangle>
                          <Rectangle Grid.ColumnSpan="2"
                                     Fill="{DynamicResource ProgressBarCompressedSizeDirBrush}"
                                     HorizontalAlignment="Left"
                                     IsVisible="{Binding UseDirProgressColor}">
                            <Rectangle.Width>
                              <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                                <Binding Path="CompressedSizeRatio" />
                                <Binding Path="Bounds.Width"
                                         RelativeSource="{RelativeSource AncestorType=Grid}" />
                              </MultiBinding>
                            </Rectangle.Width>
                          </Rectangle>
                          <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).LocalizedStrings[DataGrid_Compressed]}"
                                       FontSize="11"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                            <TextBlock Text=":"
                                       FontSize="11"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding CompressedSizeDisplay}"
                                     FontSize="11"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        </Grid>
                        <Grid MinHeight="{DynamicResource ControlHeightSm}"
                              IsVisible="{DynamicResource ThumbnailContentRowRatioVisible}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" /><!-- ⚠ GridLength 属性不得绑 {DynamicResource}（2026-11-07 崩溃回归：
                                                  ContentRowLabelColumnWidth 资源是 sys:Double，绑给 GridLength 类型的
                                                  Columns.Width 在行挂树重求值时 double→GridLength 强转抛 InvalidCastException，
                                                  整进程终止——修复 = 本处用字面常量；值必须与 ContentRowLabelColumnWidth
                                                  资源保持一致（改任一处必须同步另一处）） -->
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <!-- 压缩率：仅单画刷（与 Details 同款，无目录变体） -->
                          <Rectangle Grid.ColumnSpan="2"
                                     Fill="{DynamicResource ProgressBarRatioBrush}"
                                     HorizontalAlignment="Left">
                            <Rectangle.Width>
                              <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                                <Binding Path="RatioBarValue" />
                                <Binding Path="Bounds.Width"
                                         RelativeSource="{RelativeSource AncestorType=Grid}" />
                              </MultiBinding>
                            </Rectangle.Width>
                          </Rectangle>
                          <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).LocalizedStrings[DataGrid_Ratio]}"
                                       FontSize="11"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                            <TextBlock Text=":"
                                       FontSize="11"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding RatioDisplay}"
                                     FontSize="11"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        </Grid>
                        <Grid MinHeight="{DynamicResource ControlHeightSm}"
                              IsVisible="{DynamicResource ThumbnailContentRowDateVisible}">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" /><!-- ⚠ GridLength 属性不得绑 {DynamicResource}（2026-11-07 崩溃回归：
                                                  ContentRowLabelColumnWidth 资源是 sys:Double，绑给 GridLength 类型的
                                                  Columns.Width 在行挂树重求值时 double→GridLength 强转抛 InvalidCastException，
                                                  整进程终止——修复 = 本处用字面常量；值必须与 ContentRowLabelColumnWidth
                                                  资源保持一致（改任一处必须同步另一处）） -->
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <!-- 修改日期：单画刷（与 Details 同款） -->
                          <Rectangle Grid.ColumnSpan="2"
                                     Fill="{DynamicResource ProgressBarDateBrush}"
                                     HorizontalAlignment="Left">
                            <Rectangle.Width>
                              <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                                <Binding Path="DateRatio" />
                                <Binding Path="Bounds.Width"
                                         RelativeSource="{RelativeSource AncestorType=Grid}" />
                              </MultiBinding>
                            </Rectangle.Width>
                          </Rectangle>
                          <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).LocalizedStrings[DataGrid_Modified]}"
                                       FontSize="11"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                            <TextBlock Text=":"
                                       FontSize="11"
                                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                          </StackPanel>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding LastModifiedDisplay}"
                                     FontSize="11"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>

      <GridSplitter x:Name="PreviewColSplitter"
                    Grid.Column="3"
                    Width="5" />

      <!-- 水平分隔条：位置 1/2/3 时可见（Row 1），Column/ColumnSpan 由 ApplyPreviewPosition 注入 -->
      <GridSplitter x:Name="PreviewRowSplitter"
                    Grid.Row="1"
                    Height="4"
                    IsVisible="False" />

      <!-- 预览占位 host：真正的 PreviewPanel 由 EnsurePreviewPanel 在首帧后延迟创建并填充（启动提速，
           把 855 行预览控件树挪出启动关键路径）。IsVisible 绑定 MainWindowViewModel.IsPreviewVisible
           （菜单勾选态；原面板级绑定经 DataContext=Preview 解析到 PreviewViewModel.IsPreviewVisible，
           语义不同——原面板内部 Show* 置 true 的内容驱动逻辑保持在面板内部不变）。 -->
      <ContentControl x:Name="PreviewPanelHost"
                      Grid.Column="4"
                      IsVisible="{Binding IsPreviewVisible}">
        <!-- PreviewPanel 由 code-behind 的 EnsurePreviewPanel 填充 -->
      </ContentControl>

      <!-- 拖拽添加覆层（DragOver 悬停期间显示：覆盖文件列表列，视觉对齐拖拽解压覆层——
            状态色背景呼吸透明 alpha 40-120、8px 同色不透明边框、白色粗体文字+阴影、✓/⚠ 状态图标。
            呼吸由 code-behind DispatcherTimer 驱动，仅背景层 Opacity 呼吸，边框/文字保持不透明） -->
      <Border x:Name="DragAddOverlay"
              Grid.Column="2"
              Grid.Row="0"
              IsVisible="False"
              IsHitTestVisible="False"
              BorderBrush="#6BD46B"
              BorderThickness="8"
              ZIndex="10">
        <Grid>
          <Border x:Name="DragAddOverlayBg" Background="#6BD46B" />
          <StackPanel VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Spacing="{DynamicResource SpacingMd}"
                      Margin="40,0">
            <TextBlock x:Name="DragAddOverlayIcon"
                      Text="&#x2713;"
                      FontSize="48"
                      FontWeight="Bold"
                      Foreground="#90E060"
                      FontFamily="Segoe UI Symbol"
                      HorizontalAlignment="Center">
              <TextBlock.Effect>
                <DropShadowEffect OffsetX="1" OffsetY="1" BlurRadius="3" Color="#B0000000" />
              </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="DragAddOverlayText"
                      FontSize="24"
                      FontWeight="Bold"
                      Foreground="White"
                      TextAlignment="Center"
                      TextWrapping="Wrap"
                      MaxWidth="560">
              <TextBlock.Effect>
                <DropShadowEffect OffsetX="1" OffsetY="1" BlurRadius="3" Color="#B0000000" />
              </TextBlock.Effect>
            </TextBlock>
          </StackPanel>
        </Grid>
      </Border>
  </Grid>
</UserControl>
