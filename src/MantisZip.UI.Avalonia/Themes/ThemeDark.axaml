<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Window -->
  <Color x:Key="ThemeWindowBg">#FF1E1E1E</Color>
  <Color x:Key="ThemeTextPrimary">#FFE0E0E0</Color>
  <Color x:Key="ThemeTextSecondary">#FF999999</Color>
  <Color x:Key="ThemeBorder">#FF3E3E3E</Color>
  <Color x:Key="ThemeAccent">#FF0078D4</Color>
  <!-- Surfaces -->
  <Color x:Key="ThemeSurfaceBg">#FF252525</Color>
  <Color x:Key="ThemeHeaderBg">#FF2A2A2A</Color>
  <!-- Buttons -->
  <Color x:Key="ThemeButtonBg">#FF3E3E3E</Color>
  <Color x:Key="ThemeButtonHover">#FF4E4E4E</Color>
  <Color x:Key="ThemeButtonPressed">#FF5E5E5E</Color>
  <!-- Lists -->
  <Color x:Key="ThemeListBg">#FF252525</Color>
  <Color x:Key="ThemeListSelected">#FF2A3A5A</Color>
  <!-- Splitters -->
  <Color x:Key="ThemeSplitterBg">#FF3E3E3E</Color>
  <!-- TabControl -->
  <Color x:Key="ThemeTabHeaderBg">#FF2A2A2A</Color>
  <Color x:Key="ThemeTabHeaderFg">#FFE0E0E0</Color>
  <!-- ComboBox -->
  <Color x:Key="ThemeComboBoxBg">#FF252525</Color>
  <Color x:Key="ThemeComboBoxBorder">#FF3E3E3E</Color>

  <!-- SolidColorBrush resources -->
  <SolidColorBrush x:Key="ThemeWindowBgBrush" Color="{StaticResource ThemeWindowBg}" />
  <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="{StaticResource ThemeTextPrimary}" />
  <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="{StaticResource ThemeTextSecondary}" />
  <SolidColorBrush x:Key="ThemeBorderBrush" Color="{StaticResource ThemeBorder}" />
  <SolidColorBrush x:Key="ThemeAccentBrush" Color="{StaticResource ThemeAccent}" />
  <SolidColorBrush x:Key="ThemeSurfaceBgBrush" Color="{StaticResource ThemeSurfaceBg}" />
  <SolidColorBrush x:Key="ThemeHeaderBgBrush" Color="{StaticResource ThemeHeaderBg}" />
  <SolidColorBrush x:Key="ThemeButtonBgBrush" Color="{StaticResource ThemeButtonBg}" />
  <SolidColorBrush x:Key="ThemeButtonHoverBrush" Color="{StaticResource ThemeButtonHover}" />
  <SolidColorBrush x:Key="ThemeButtonPressedBrush" Color="{StaticResource ThemeButtonPressed}" />
  <SolidColorBrush x:Key="ThemeListBgBrush" Color="{StaticResource ThemeListBg}" />
  <SolidColorBrush x:Key="ThemeListSelectedBrush" Color="{StaticResource ThemeListSelected}" />
  <SolidColorBrush x:Key="ThemeSplitterBgBrush" Color="{StaticResource ThemeSplitterBg}" />
  <SolidColorBrush x:Key="ThemeTabHeaderBgBrush" Color="{StaticResource ThemeTabHeaderBg}" />
  <SolidColorBrush x:Key="ThemeTabHeaderFgBrush" Color="{StaticResource ThemeTabHeaderFg}" />
  <SolidColorBrush x:Key="ThemeComboBoxBgBrush" Color="{StaticResource ThemeComboBoxBg}" />
  <SolidColorBrush x:Key="ThemeComboBoxBorderBrush" Color="{StaticResource ThemeComboBoxBorder}" />

  <!-- ════════════════════════════════════════════ -->
  <!-- Fluent Theme Overrides — Button            -->
  <!-- ════════════════════════════════════════════ -->
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource ThemeButtonHover}" />
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource ThemeButtonPressed}" />
  <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource ThemeTextPrimary}" />
  <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource ThemeTextPrimary}" />
  <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource ThemeBorder}" />
  <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource ThemeBorder}" />

  <!-- ToggleButton -->
  <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="{StaticResource ThemeButtonHover}" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="{StaticResource ThemeButtonPressed}" />
  <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="{StaticResource ThemeTextPrimary}" />
  <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="{StaticResource ThemeTextPrimary}" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="{StaticResource ThemeBorder}" />
  <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="{StaticResource ThemeBorder}" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource ThemeAccent}" />
  <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{StaticResource ThemeButtonPressed}" />

  <!-- ════════════════════════════════════════════ -->
  <!-- Fluent Theme Overrides — MenuFlyoutPresenter -->
  <!-- ════════════════════════════════════════════ -->
  <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="{StaticResource ThemeHeaderBg}" />
  <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="{StaticResource ThemeBorder}" />

  <!-- ════════════════════════════════════════════ -->
  <!-- Fluent Theme Overrides — Control Foregrounds -->
  <!-- ════════════════════════════════════════════ -->
  <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="{StaticResource ThemeTextPrimary}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="{StaticResource ThemeTextPrimary}" />
  <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="{StaticResource ThemeTextSecondary}" />
  <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource ThemeTextSecondary}" />
</ResourceDictionary>
