<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MantisZip.UI.Avalonia.ViewModels"
        xmlns:models="clr-namespace:MantisZip.UI.Avalonia.Models"
        xmlns:conv="clr-namespace:MantisZip.UI.Avalonia.Converters"
        xmlns:views="clr-namespace:MantisZip.UI.Avalonia.Views"
        x:Class="MantisZip.UI.Avalonia.Views.MainWindow"
         x:Name="ThisWindow"
         x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="500"
        Background="{DynamicResource ThemeWindowBgBrush}"
        DragDrop.AllowDrop="True"
        DragDrop.Drop="OnWindowDrop"
        DragDrop.DragOver="OnWindowDragOver">

  <Window.Resources>
    <conv:FileSizeConverter x:Key="FileSizeConverter" />
    <conv:BoolInvertConverter x:Key="BoolInvertConverter" />
    <conv:DateTimeToOffsetConverter x:Key="DateTimeToOffsetConverter" />
    <conv:NullableLongConverter x:Key="NullableLongConverter" />
    <conv:RatioToWidthConverter x:Key="RatioToWidthConverter" />
    <conv:BoolToToggleBgBrushConverter x:Key="BoolToToggleBgBrushConverter" />
  </Window.Resources>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <!-- Menu (Row 0) -->
    <Menu Grid.Row="0">
      <MenuItem Header="{Binding LocalizedStrings[Menu_File]}">
        <MenuItem Command="{Binding OpenArchiveCommand}" InputGesture="Ctrl+O">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Menu_OpenArchive]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Command="{Binding CloseArchiveCommand}" InputGesture="Ctrl+W"
                  IsEnabled="{Binding IsArchiveLoaded}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconSignOut}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Menu_CloseArchive]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem ItemsSource="{Binding RecentFiles}"
                  IsEnabled="{Binding RecentFiles.Count}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconHistory}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Main_RecentFiles]}" />
            </StackPanel>
          </MenuItem.Header>
          <MenuItem.ItemTemplate>
            <DataTemplate>
              <MenuItem Click="RecentFileMenuItem_Click"
                        CommandParameter="{Binding .}">
                <MenuItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
                    <PathIcon Data="{StaticResource IconHistory}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                    <TextBlock Text="{Binding .}" />
                  </StackPanel>
                </MenuItem.Header>
              </MenuItem>
            </DataTemplate>
          </MenuItem.ItemTemplate>
        </MenuItem>
        <Separator />
        <MenuItem Command="{Binding ClearRecentFilesCommand}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconDelete}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Main_ClearRecentFiles]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Command="{Binding RefreshArchiveCommand}" InputGesture="F5"
                  IsEnabled="{Binding IsArchiveLoaded}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Menu_Refresh]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Command="{Binding OpenSettingsCommand}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Menu_Settings]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Command="{Binding ExitCommand}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconSignOut}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Menu_Exit]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Header="收藏夹">
          <MenuItem Command="{Binding OpenFavoritesManagerCommand}">
            <MenuItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
                <PathIcon Data="{StaticResource IconStar}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                <TextBlock Text="{Binding LocalizedStrings[FavMgr_OpenManager]}" />
              </StackPanel>
            </MenuItem.Header>
          </MenuItem>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{Binding LocalizedStrings[Menu_Edit]}">
        <MenuItem Command="{Binding ExtractArchiveCommand}" InputGesture="Ctrl+E"
                  IsEnabled="{Binding IsArchiveLoaded}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconExport}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Menu_ExtractArchive]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Command="{Binding ExtractArchiveHereCommand}"
                  IsEnabled="{Binding IsArchiveLoaded}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconPin}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Menu_ExtractHere]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Command="{Binding ExtractArchiveToNameCommand}"
                  IsEnabled="{Binding IsArchiveLoaded}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Menu_ExtractToName]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Command="{Binding SmartExtractCommand}"
                  IsEnabled="{Binding IsArchiveLoaded}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconWand}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Menu_SmartExtract]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Command="{Binding AddFilesCommand}"
                  IsEnabled="{Binding IsArchiveLoaded}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Menu_AddFiles]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Command="{Binding DeleteFilesCommand}"
                  IsEnabled="{Binding IsArchiveLoaded}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconDismiss}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Menu_DeleteFiles]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Command="{Binding TestArchiveCommand}"
                  IsEnabled="{Binding IsArchiveLoaded}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconCheckmark}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Menu_TestArchive]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Command="{Binding EditCommentCommand}"
                  IsEnabled="{Binding IsArchiveLoaded}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconChat}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Menu_ArchiveComment]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Command="{Binding NewArchiveCommand}" InputGesture="Ctrl+N">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconNewFile}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Menu_NewArchive]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Command="{Binding CompressSelectedCommand}" InputGesture="Ctrl+C">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconDownload}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Menu_Compress]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Header="{Binding LocalizedStrings[Menu_PasswordManager]}"
                  Command="{Binding OpenPasswordManagerCommand}" />
      </MenuItem>
      <MenuItem Header="{Binding LocalizedStrings[Menu_View]}">
        <MenuItem Command="{Binding ToggleThemeCommand}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <Border Classes="ToggleIconBox"
                      Background="{Binding IsDarkTheme, Converter={StaticResource BoolToToggleBgBrushConverter}}">
                <PathIcon Data="{StaticResource IconMoon}" Width="12" Height="12"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Border>
              <TextBlock Text="{Binding LocalizedStrings[Menu_ToggleTheme]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Command="{Binding ToggleProgressBarsCommand}"
                  IsEnabled="{Binding IsArchiveLoaded}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <Border Classes="ToggleIconBox"
                      Background="{Binding ShowProgressBars, Converter={StaticResource BoolToToggleBgBrushConverter}}">
                <PathIcon Data="{StaticResource IconDataBarVertical}" Width="12" Height="12"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Border>
              <TextBlock Text="{Binding LocalizedStrings[Menu_ProgressBars]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Command="{Binding ToggleSepDirBaselineCommand}"
                  IsEnabled="{Binding IsArchiveLoaded}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <Border Classes="ToggleIconBox"
                      Background="{Binding SeparateDirBaseline, Converter={StaticResource BoolToToggleBgBrushConverter}}">
                <PathIcon Data="{StaticResource IconFolder}" Width="12" Height="12"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Border>
              <TextBlock Text="{Binding LocalizedStrings[Menu_SepDirBaseline]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Command="{Binding ToggleInfoPanelOrientationCommand}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <Border Classes="ToggleIconBox"
                      Background="{Binding Preview.IsHorizontalInfoPanel, Converter={StaticResource BoolToToggleBgBrushConverter}}">
                <PathIcon Data="{StaticResource IconOrientation}" Width="12" Height="12"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Border>
              <TextBlock Text="{Binding LocalizedStrings[Menu_InfoPanelOrientation]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{Binding LocalizedStrings[Menu_Help]}">
        <MenuItem Command="{Binding OpenAboutCommand}">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconInfo}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Menu_About]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
      </MenuItem>
      <MenuItem>
        <MenuItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
            <PathIcon Data="{StaticResource IconEyedropper}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            <TextBlock Text="{Binding LocalizedStrings[Menu_Test]}" />
          </StackPanel>
        </MenuItem.Header>
        <MenuItem Click="TestWindow_Click" Tag="IconTestWindow">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconGrid}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="图标测试 — 所有图标列表" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Click="TestWindow_Click" Tag="AboutWindow">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconInfo}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_AboutWindow]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="TestWindow_Click" Tag="SettingsWindow">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_SettingsWindow]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="TestWindow_Click" Tag="PasswordManagerWindow">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconKey}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_PasswordManager]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="TestWindow_Click" Tag="DonationDialog">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconHeart}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_DonationDialog]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Click="TestWindow_Click" Tag="LogPrivacyHelpDialog">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconLockClosed}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_LogPrivacyHelp]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="TestWindow_Click" Tag="PasswordHelpDialog">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconQuestion}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_PasswordHelp]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Click="TestWindow_Click" Tag="CommentDialog">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconChat}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_CommentDialog]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="TestWindow_Click" Tag="PasswordEditDialog">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconEdit}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_PasswordEditDialog]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="TestWindow_Click" Tag="PasswordDialog">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconShieldLock}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_PasswordDialog]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Click="TestWindow_Click" Tag="ProgressWindow">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconTimer}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_ProgressWindow]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="TestWindow_Click" Tag="ErrorDialog">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_ErrorDialog]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Click="TestWindow_Click" Tag="CompressSettingsWindow">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconCompress}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_CompressSettings]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="TestWindow_Click" Tag="ExtractSettingsWindow">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconCompress}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_ExtractSettings]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="TestWindow_Click" Tag="CompressConflictDialog">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_CompressConflict]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="TestWindow_Click" Tag="ConflictDialog">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconLightning}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_ConflictDialog]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="TestWindow_Click" Tag="MatchedPasswordDialog">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconLockOpen}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_MatchedPassword]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Click="TestWindow_Click" Tag="ElevationDialog">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconShieldLock}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_ElevationDialog]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="TestWindow_Click" Tag="ElevationFailedDialog">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_ElevationFailedDialog]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="TestWindow_Click" Tag="ElevationInfoDialog">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconInfo}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_ElevationInfoDialog]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <Separator />
        <MenuItem Click="TestWindow_Click" Tag="AddFavoriteDialog">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconStar}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_AddFavoriteDialog]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="TestWindow_Click" Tag="FavoriteManagerWindow">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_FavoriteManagerWindow]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="TestWindow_Click" Tag="ArchiveCommentDialog">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconChat}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_ArchiveCommentDialog]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
        <MenuItem Click="TestWindow_Click" Tag="AppMessageBox">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <PathIcon Data="{StaticResource IconChat}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              <TextBlock Text="{Binding LocalizedStrings[Test_AppMessageBox]}" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{Binding LocalizedStrings[Menu_Language]}">
        <MenuItem Header="{Binding LocalizedStrings[Menu_LangChinese]}"
                  Command="{Binding SwitchLanguageCommand}" CommandParameter="zh-CN" />
        <MenuItem Header="{Binding LocalizedStrings[Menu_LangEnglish]}"
                  Command="{Binding SwitchLanguageCommand}" CommandParameter="en" />
      </MenuItem>
    </Menu>

    <!-- Toolbar (Row 1) — simplified: archive operations only -->
    <Border Grid.Row="1"
            Padding="6,4"
            Background="{DynamicResource ThemeHeaderBgBrush}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
        <Button Classes="ToolbarButton"
                Command="{Binding NewArchiveCommand}"
                ToolTip.Tip="{Binding LocalizedStrings[Tooltip_New]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconNewFile}" Classes="ToolbarButtonIcon" Width="14" Height="14" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_New]}"
                       Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
        <Button Classes="ToolbarButton"
                Command="{Binding OpenArchiveCommand}"
                ToolTip.Tip="{Binding LocalizedStrings[Tooltip_Open]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconFolder}" Classes="ToolbarButtonIcon" Width="14" Height="14" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_Open]}"
                       Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
        <Button Classes="ToolbarButton"
                Command="{Binding ExtractArchiveCommand}"
                IsEnabled="{Binding IsArchiveLoaded}"
                ToolTip.Tip="{Binding LocalizedStrings[Tooltip_Extract]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconExport}" Classes="ToolbarButtonIcon" Width="14" Height="14" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_Extract]}"
                       Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
        <Button Classes="ToolbarButton"
                Command="{Binding SmartExtractCommand}"
                IsEnabled="{Binding IsArchiveLoaded}"
                ToolTip.Tip="{Binding LocalizedStrings[Tooltip_SmartExtract]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconWand}" Classes="ToolbarButtonIcon" Width="14" Height="14" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_SmartExtract]}"
                       Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
        <Button Classes="ToolbarButton"
                Command="{Binding CompressSelectedCommand}"
                ToolTip.Tip="{Binding LocalizedStrings[Tooltip_Compress]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconDownload}" Classes="ToolbarButtonIcon" Width="14" Height="14" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_Compress]}"
                       Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
        <Border Width="1"
                Height="24"
                VerticalAlignment="Center"
                Background="{DynamicResource ThemeBorderBrush}"
                Margin="4,0" />
        <Button Classes="ToolbarButton"
                Command="{Binding AddFilesCommand}"
                IsEnabled="{Binding IsArchiveLoaded}"
                ToolTip.Tip="{Binding LocalizedStrings[Tooltip_AddFiles]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconAdd}" Classes="ToolbarButtonIcon" Width="14" Height="14" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_AddFiles]}"
                       Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
        <Button Classes="ToolbarButton"
                Command="{Binding DeleteFilesCommand}"
                IsEnabled="{Binding IsArchiveLoaded}"
                ToolTip.Tip="{Binding LocalizedStrings[Tooltip_DeleteFiles]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconDismiss}" Classes="ToolbarButtonIcon" Width="14" Height="14" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_DeleteFiles]}"
                       Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
        <Button Classes="ToolbarButton"
                Command="{Binding TestArchiveCommand}"
                IsEnabled="{Binding IsArchiveLoaded}"
                ToolTip.Tip="{Binding LocalizedStrings[Tooltip_Test]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconCheckmark}" Classes="ToolbarButtonIcon" Width="14" Height="14" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_Test]}"
                       Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
        <Border Width="1"
                Height="24"
                VerticalAlignment="Center"
                Background="{DynamicResource ThemeBorderBrush}"
                Margin="4,0" />
        <ToggleButton Classes="ToolbarButton"
                      IsChecked="{Binding IsPreviewVisible}"
                      ToolTip.Tip="{Binding LocalizedStrings[Tooltip_Preview]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconEye}" Classes="ToolbarButtonIcon" Width="14" Height="14" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_Preview]}"
                       Classes="ToolbarButtonLabel" />
          </StackPanel>
        </ToggleButton>
        <Border Width="1"
                Height="24"
                VerticalAlignment="Center"
                Background="{DynamicResource ThemeBorderBrush}"
                Margin="4,0" />
        <Button Classes="ToolbarButton"
                Command="{Binding OpenPasswordManagerCommand}"
                ToolTip.Tip="{Binding LocalizedStrings[Tooltip_Password]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconKey}" Classes="ToolbarButtonIcon" Width="14" Height="14" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_Password]}"
                       Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- Filter bar (Row 2, collapsible) — WPF consistent layout -->
    <Border Grid.Row="2"
            IsVisible="{Binding IsFilterBarVisible}"
            Padding="8,4"
            Background="{DynamicResource ThemeSurfaceBgBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal"
                  VerticalAlignment="Center">
        <!-- Section 1: 文字搜索 + 匹配模式 + 排除 -->
        <Grid VerticalAlignment="Center" Margin="0,0,4,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="100" />
          </Grid.ColumnDefinitions>
          <!-- Row 0: search icon + search box + match mode -->
          <PathIcon Grid.Row="0" Grid.Column="0" Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="2,0,4,2" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          <TextBox Grid.Row="0" Grid.Column="1" Height="{DynamicResource ControlHeightXs}" FontSize="11"
                   Text="{Binding FilterText}" Margin="0,0,0,2"
                   Background="{DynamicResource ThemeWindowBgBrush}"
                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                   BorderBrush="{DynamicResource ThemeBorderBrush}" />
          <ComboBox Grid.Row="0" Grid.Column="2" Height="{DynamicResource ControlHeightXs}" FontSize="11" Margin="2,0,0,2"
                    ItemsSource="{Binding MatchModeOptions}"
                    SelectedItem="{Binding SelectedMatchModeOption}"
                    Background="{DynamicResource ThemeWindowBgBrush}"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                    BorderBrush="{DynamicResource ThemeBorderBrush}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" FontSize="11"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <!-- Row 1: exclude icon + exclude box -->
          <PathIcon Grid.Row="1" Grid.Column="0" Data="{StaticResource IconProhibited}" Width="14" Height="14" Margin="2,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          <TextBox Grid.Row="1" Grid.Column="1" Height="{DynamicResource ControlHeightXs}" FontSize="11"
                   Text="{Binding FilterExcludeText}"
                   ToolTip.Tip="{Binding LocalizedStrings[Filter_Exclude]}"
                   PlaceholderText="{Binding LocalizedStrings[Filter_Exclude]}"
                   Background="{DynamicResource ThemeWindowBgBrush}"
                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                   BorderBrush="{DynamicResource ThemeBorderBrush}" />
        </Grid>
        <Border Width="1" Height="24" VerticalAlignment="Center"
                Background="{DynamicResource ThemeBorderBrush}" Margin="4,0" />

        <!-- Section 2: 日期范围 + 🧪 picker buttons -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
          <PathIcon Data="{StaticResource IconCalendar}" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          <StackPanel Orientation="Vertical" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
              <Button Width="20" Height="20" Padding="0" Margin="0,0,2,0" Click="PickDateFrom_Click"
                      Background="{DynamicResource ThemeButtonBgBrush}"
                      Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                      BorderBrush="{DynamicResource ThemeBorderBrush}">
                <PathIcon Data="{StaticResource IconEyedropper}" Width="11" Height="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <TextBlock Text="{Binding LocalizedStrings[Filter_DateFrom]}"
                         FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0"
                         Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
              <DatePicker x:Name="FilterDateFromPicker" Width="105" Height="{DynamicResource ControlHeightXs}"
                          SelectedDate="{Binding FilterDateFrom, Converter={StaticResource DateTimeToOffsetConverter}}"
                          Background="{DynamicResource ThemeWindowBgBrush}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button Width="20" Height="20" Padding="0" Margin="0,0,2,0" Click="PickDateTo_Click"
                      Background="{DynamicResource ThemeButtonBgBrush}"
                      Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                      BorderBrush="{DynamicResource ThemeBorderBrush}">
                <PathIcon Data="{StaticResource IconEyedropper}" Width="11" Height="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <TextBlock Text="{Binding LocalizedStrings[Filter_DateTo]}"
                         FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0"
                         Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
              <DatePicker x:Name="FilterDateToPicker" Width="105" Height="{DynamicResource ControlHeightXs}"
                          SelectedDate="{Binding FilterDateTo, Converter={StaticResource DateTimeToOffsetConverter}}"
                          Background="{DynamicResource ThemeWindowBgBrush}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <Border Width="1" Height="24" VerticalAlignment="Center"
                Background="{DynamicResource ThemeBorderBrush}" Margin="4,0" />

        <!-- Section 3: 大小范围 + 🧪 picker buttons -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
          <PathIcon Data="{StaticResource IconRuler}" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          <StackPanel Orientation="Vertical" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
              <Button Width="20" Height="20" Padding="0" Margin="0,0,2,0" Click="PickSizeMin_Click"
                      Background="{DynamicResource ThemeButtonBgBrush}"
                      Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                      BorderBrush="{DynamicResource ThemeBorderBrush}">
                <PathIcon Data="{StaticResource IconEyedropper}" Width="11" Height="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <TextBlock Text="{Binding LocalizedStrings[Filter_SizeMin]}"
                         FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0"
                         Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
              <TextBox Width="60" Height="{DynamicResource ControlHeightXs}"
                       Text="{Binding FilterSizeMin, Converter={StaticResource NullableLongConverter}}"
                       Background="{DynamicResource ThemeWindowBgBrush}"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       BorderBrush="{DynamicResource ThemeBorderBrush}"
                       Padding="2,0" BorderThickness="1" />
              <ComboBox Width="65" Height="{DynamicResource ControlHeightXs}" Margin="2,0,0,0"
                         ItemsSource="{Binding SizeUnitOptions}"
                         SelectedItem="{Binding FilterSizeUnit}"
                         Background="{DynamicResource ThemeWindowBgBrush}"
                         Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                         BorderBrush="{DynamicResource ThemeBorderBrush}"
                         Padding="2,0" BorderThickness="1" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button Width="20" Height="20" Padding="0" Margin="0,0,2,0" Click="PickSizeMax_Click"
                      Background="{DynamicResource ThemeButtonBgBrush}"
                      Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                      BorderBrush="{DynamicResource ThemeBorderBrush}">
                <PathIcon Data="{StaticResource IconEyedropper}" Width="11" Height="11" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <TextBlock Text="{Binding LocalizedStrings[Filter_SizeMax]}"
                         FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0"
                         Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
              <TextBox Width="60" Height="{DynamicResource ControlHeightXs}"
                       Text="{Binding FilterSizeMax, Converter={StaticResource NullableLongConverter}}"
                       Background="{DynamicResource ThemeWindowBgBrush}"
                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                       BorderBrush="{DynamicResource ThemeBorderBrush}"
                       Padding="2,0" BorderThickness="1" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Main content: TreeView | file list | preview (Row 3) -->
    <Grid Grid.Row="3">
      <!-- Drop hint overlay (shown when no archive loaded) -->
      <Border IsVisible="{Binding IsArchiveLoaded, Converter={StaticResource BoolInvertConverter}}"
              Background="{DynamicResource ThemeWindowBgBrush}">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="{DynamicResource SpacingXs}">
          <PathIcon Data="{StaticResource IconFolder}" Width="64" Height="64" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          <TextBlock Text="{Binding LocalizedStrings[Main_DropHint]}"
                     FontSize="16"
                     Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Archive content (hidden when no archive loaded) -->
      <Grid IsVisible="{Binding IsArchiveLoaded}"
            ColumnDefinitions="1*,5,2.5*,5,3*">
      <!-- Folder tree panel (col 0) with tree toolbar -->
      <Border Grid.Column="0"
              MinWidth="100"
              Background="{DynamicResource ThemeSurfaceBgBrush}">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <!-- Tree toolbar -->
          <Border Grid.Row="0"
                  Padding="4,2"
                  Background="{DynamicResource ThemeHeaderBgBrush}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding ExpandAllCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Tree_ExpandAll]}">
                <PathIcon Data="{StaticResource IconArrowExpandAll}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding CollapseAllCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Tree_CollapseAll]}">
                <PathIcon Data="{StaticResource IconArrowCollapseAll}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding ExpandToCurrentCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Tree_ExpandToCurrent]}">
                <PathIcon Data="{StaticResource IconLocation}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
            </StackPanel>
          </Border>
          <!-- Header -->
          <TextBlock Grid.Row="1"
                     Text="{Binding LocalizedStrings[Tree_Browse]}"
                     Margin="8,4"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
          <!-- Tree search -->
          <TextBox Grid.Row="2"
                   MinHeight="{DynamicResource ControlHeightSm}"
                   x:Name="TreeSearchBox"
                   Text="{Binding TreeFilterText}"
                   PlaceholderText="{Binding LocalizedStrings[Tree_Filter]}"
                   Margin="4,0,4,2"
                   Background="{DynamicResource ThemeWindowBgBrush}"
                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                   BorderBrush="{DynamicResource ThemeBorderBrush}" />
          <!-- TreeView with IsExpanded/IsVisible bindings -->
          <TreeView Grid.Row="3"
                    ItemsSource="{Binding FolderTreeItems}"
                    SelectedItem="{Binding SelectedFolder}"
                    BorderThickness="0"
                    Background="Transparent">
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:CompileBindings="False">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
                <Setter Property="IsVisible" Value="{Binding IsVisible}" />
                <Setter Property="MinHeight" Value="{DynamicResource ControlHeightSm}" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}"
                            Margin="4,2">
                  <PathIcon Data="{StaticResource IconFolder}"
                            Width="14" Height="14"
                            Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                  <TextBlock Text="{Binding Name}"
                             Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1"
                    Width="5" />

      <!-- File list panel (col 2) with file list toolbar -->
      <Grid Grid.Column="2">
        <Grid RowDefinitions="Auto,Auto,*">
          <!-- File list toolbar -->
          <Border Grid.Row="0"
                  Padding="4,2"
                  Background="{DynamicResource ThemeHeaderBgBrush}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
              <!-- Navigation group -->
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding GoRootCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Nav_GoRoot]}">
                <PathIcon Data="{StaticResource IconHome}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding GoUpCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                       ToolTip.Tip="{Binding LocalizedStrings[Nav_GoUp]}">
                <PathIcon Data="{StaticResource IconArrowUp}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding GoBackCommand}"
                      IsEnabled="{Binding CanGoBack}"
                      ToolTip.Tip="{Binding LocalizedStrings[Nav_GoBack]}">
                <PathIcon Data="{StaticResource IconChevronLeft}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding GoForwardCommand}"
                      IsEnabled="{Binding CanGoForward}"
                      ToolTip.Tip="{Binding LocalizedStrings[Nav_GoForward]}">
                <PathIcon Data="{StaticResource IconChevronRight}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>

              <!-- Copy name -->
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding CopyFileNameCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Toolbar_CopyName]}">
                <PathIcon Data="{StaticResource IconCopy}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>

              <!-- Column picker -->
              <Button x:Name="ColumnPickerButton" Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding ShowColumnPickerCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Toolbar_Columns]}">
                <PathIcon Data="{StaticResource IconNavigation}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>

              <!-- View mode toggle -->
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding CycleViewModeCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Toolbar_ViewMode]}">
                <PathIcon Data="{StaticResource IconGrid}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <TextBlock Text="{Binding ViewModeLabel}"
                         FontSize="10"
                         Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                         VerticalAlignment="Center" />

              <Border Width="1" Height="20" Margin="2,0"
                      VerticalAlignment="Center"
                      Background="{DynamicResource ThemeBorderBrush}" />

              <!-- Select All / Invert -->
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding SelectAllCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Toolbar_SelectAll]}">
                <PathIcon Data="{StaticResource IconSelectAll}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding InvertSelectionCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Toolbar_InvertSelection]}">
                <PathIcon Data="{StaticResource IconProhibited}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>

              <Border Width="1" Height="20" Margin="2,0"
                      VerticalAlignment="Center"
                      Background="{DynamicResource ThemeBorderBrush}" />

              <!-- Refresh -->
              <Button Classes="ToolbarButton ToolbarIcon"
                      Command="{Binding RefreshArchiveCommand}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Toolbar_Refresh]}">
                <PathIcon Data="{StaticResource IconRefresh}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
              </Button>

              <Border Width="1" Height="20" Margin="2,0"
                      VerticalAlignment="Center"
                      Background="{DynamicResource ThemeBorderBrush}" />

              <!-- Filter toggle + Flatten toggle (moved from global toolbar) -->
              <ToggleButton Classes="ToolbarButton ToolbarIcon"
                            IsChecked="{Binding IsFilterBarVisible}"
                            IsEnabled="{Binding IsArchiveLoaded}"
                            ToolTip.Tip="{Binding LocalizedStrings[Tooltip_Filter]}">
                <PathIcon Data="{StaticResource IconSearch}" Width="13" Height="13" />
              </ToggleButton>
              <ToggleButton Classes="ToolbarButton ToolbarIcon"
                            IsChecked="{Binding ShowSubfolders}"
                            IsEnabled="{Binding IsArchiveLoaded}"
                            ToolTip.Tip="{Binding LocalizedStrings[Tooltip_Subfolders]}">
                <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" />
              </ToggleButton>
            </StackPanel>
          </Border>

          <!-- Address bar row -->
          <Border Grid.Row="1"
                  Padding="6,3"
                  Background="{DynamicResource ThemeHeaderBgBrush}">
            <AutoCompleteBox Height="{DynamicResource ControlHeightSm}"
                             x:Name="AddressBar"
                             Text="{Binding CurrentFolder}"
                             ItemsSource="{Binding FolderPaths}"
                             FilterMode="StartsWith"
                             PlaceholderText="{Binding LocalizedStrings[Nav_AddressBar]}"
                             KeyDown="AddressBar_KeyDown"
                             Background="{DynamicResource ThemeWindowBgBrush}"
                             Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                             BorderBrush="{DynamicResource ThemeBorderBrush}" />
          </Border>

          <!-- DataGrid -->
          <DataGrid x:Name="FileListGrid"
                    Grid.Row="2"
                    ItemsSource="{Binding CurrentEntries}"
                    SelectedItem="{Binding SelectedEntry}"
                    AutoGenerateColumns="False"
                    CanUserSortColumns="True"
                    IsReadOnly="True"
                    RowHeight="{DynamicResource ControlHeightMd}"
                    SelectionChanged="FileListGrid_SelectionChanged"
                    DoubleTapped="FileListGrid_DoubleTapped"
                    KeyDown="FileListGrid_KeyDown"
                    Sorting="FileListGrid_Sorting">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{Binding LocalizedStrings[Ctx_Extract]}"
                          Command="{Binding ExtractArchiveCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_SmartExtract]}"
                          Command="{Binding SmartExtractCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_ExtractTo]}"
                          Command="{Binding ExtractToCommand}" />
                <Separator />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_CopyName]}"
                          Command="{Binding CopyFileNameCommand}" />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_Test]}"
                          Command="{Binding TestEntryCommand}" />
                <Separator />
                <MenuItem Header="{Binding LocalizedStrings[Ctx_Delete]}"
                          Command="{Binding DeleteFilesCommand}" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="22">
                <DataTemplate>
                  <Image Source="{Binding IconSource}"
                         Width="16" Height="16"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn SortMemberPath="Name"
                                  Width="*">
                <DataGridTextColumn.Header>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <PathIcon Data="{StaticResource IconCopy}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        <TextBlock Text="{Binding LocalizedStrings[DataGrid_Name]}" />
                    </StackPanel>
                </DataGridTextColumn.Header>
                <DataGridTextColumn.Binding>
                  <Binding Path="NameDisplay" />
                </DataGridTextColumn.Binding>
              </DataGridTextColumn>
              <DataGridTemplateColumn SortMemberPath="Size"
                                      Width="80">
                <DataGridTemplateColumn.Header>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <PathIcon Data="{StaticResource IconRuler}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        <TextBlock Text="{Binding LocalizedStrings[DataGrid_Size]}" />
                    </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <Rectangle Fill="{DynamicResource ProgressBarSizeBrush}"
                                 HorizontalAlignment="Left">
                        <Rectangle.Width>
                          <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                            <Binding Path="SizeRatio" />
                            <Binding Path="Bounds.Width"
                                     RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                          </MultiBinding>
                        </Rectangle.Width>
                      </Rectangle>
                      <TextBlock Text="{Binding SizeDisplay}"
                                 VerticalAlignment="Center"
                                 Margin="4,0" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn SortMemberPath="CompressedSize"
                                      Width="70">
                <DataGridTemplateColumn.Header>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <PathIcon Data="{StaticResource IconCompress}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        <TextBlock Text="{Binding LocalizedStrings[DataGrid_Compressed]}" />
                    </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <Rectangle Fill="{DynamicResource ProgressBarCompressedSizeBrush}"
                                 HorizontalAlignment="Left">
                        <Rectangle.Width>
                          <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                            <Binding Path="CompressedSizeRatio" />
                            <Binding Path="Bounds.Width"
                                     RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                          </MultiBinding>
                        </Rectangle.Width>
                      </Rectangle>
                      <TextBlock Text="{Binding CompressedSizeDisplay}"
                                 VerticalAlignment="Center"
                                 Margin="4,0" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn SortMemberPath="RatioSort"
                                      Width="70">
                <DataGridTemplateColumn.Header>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <PathIcon Data="{StaticResource IconDataBarVertical}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        <TextBlock Text="{Binding LocalizedStrings[DataGrid_Ratio]}" />
                    </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <Rectangle Fill="{DynamicResource ProgressBarRatioBrush}"
                                 HorizontalAlignment="Left">
                        <Rectangle.Width>
                          <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                            <Binding Path="RatioBarValue" />
                            <Binding Path="Bounds.Width"
                                     RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                          </MultiBinding>
                        </Rectangle.Width>
                      </Rectangle>
                      <TextBlock Text="{Binding RatioDisplay}"
                                 VerticalAlignment="Center"
                                 Margin="4,0" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn SortMemberPath="LastModified"
                                      Width="100">
                <DataGridTemplateColumn.Header>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <PathIcon Data="{StaticResource IconCalendar}" Width="13" Height="13" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        <TextBlock Text="{Binding LocalizedStrings[DataGrid_Modified]}" />
                    </StackPanel>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <Rectangle Fill="{DynamicResource ProgressBarDateBrush}"
                                 HorizontalAlignment="Left">
                        <Rectangle.Width>
                          <MultiBinding Converter="{StaticResource RatioToWidthConverter}">
                            <Binding Path="DateRatio" />
                            <Binding Path="Bounds.Width"
                                     RelativeSource="{RelativeSource AncestorType=ContentPresenter}" />
                          </MultiBinding>
                        </Rectangle.Width>
                      </Rectangle>
                      <TextBlock Text="{Binding LastModifiedDisplay}"
                                 VerticalAlignment="Center"
                                 Margin="4,0" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Grid>

      <GridSplitter Grid.Column="3"
                    Width="5" />

      <!-- Preview area -->
      <views:PreviewPanel Grid.Column="4"
                          DataContext="{Binding Preview}" />
    </Grid>
    </Grid>

    <!-- Status bar (Row 4) -->
    <Border Grid.Row="4"
            Padding="8,4"
            Background="{DynamicResource ThemeHeaderBgBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Column="0"
                   Text="{Binding SelectionStats}"
                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                   FontSize="12" />
        <TextBlock Grid.Column="1"
                   Text="{Binding ArchiveStats}"
                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                   FontSize="12"
                   HorizontalAlignment="Center" />
        <!-- Password status -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="4"
                    IsVisible="{Binding HasPasswordStatus}"
                    Margin="0,0,8,0">
          <PathIcon Data="{Binding PasswordStatusIcon}"
                    Width="14" Height="14"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          <TextBlock Text="{Binding PasswordStatusMessage}"
                     Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                     FontSize="12" />
        </StackPanel>
        <TextBlock Grid.Column="3"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                   FontSize="12"
                   HorizontalAlignment="Right" />
      </Grid>
    </Border>
  </Grid>
</Window>
