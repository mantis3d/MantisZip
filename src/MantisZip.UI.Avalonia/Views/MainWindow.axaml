<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MantisZip.UI.Avalonia.ViewModels"
        xmlns:models="clr-namespace:MantisZip.UI.Avalonia.Models"
        xmlns:conv="clr-namespace:MantisZip.UI.Avalonia.Converters"
        x:Class="MantisZip.UI.Avalonia.Views.MainWindow"
         x:Name="ThisWindow"
         x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="500"
        Background="{DynamicResource ThemeWindowBgBrush}"
        DragDrop.AllowDrop="True"
        DragDrop.Drop="OnWindowDrop"
        DragDrop.DragOver="OnWindowDragOver"
        DragDrop.DragLeave="OnWindowDragLeave">

  <Window.Resources>
    <conv:FileSizeConverter x:Key="FileSizeConverter" />
    <conv:BoolInvertConverter x:Key="BoolInvertConverter" />
    <conv:BoolToToggleBgBrushConverter x:Key="BoolToToggleBgBrushConverter" />
  </Window.Resources>

  <Window.Styles>
    <!-- 工具栏密码按钮：密码已匹配时绿色高亮底（对齐 WPF Theme_StatusSuccessBg） -->
    <Style Selector="Button.passwordMatched">
      <Setter Property="Background" Value="{DynamicResource ThemeStatusSuccessBgBrush}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <!-- ═══════ 主菜单栏 ═══════ -->
    <Menu Grid.Row="0">
      <!-- 文件菜单：打开/关闭/最近文件/刷新/退出 -->
      <MenuItem Header="{Binding LocalizedStrings[Menu_File]}">
        <!-- 打开压缩包：选择文件并加载到主窗口浏览 -->
        <MenuItem Command="{Binding OpenArchiveCommand}" InputGesture="Ctrl+O"
                  Header="{Binding LocalizedStrings[Menu_OpenArchive]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 打开压缩包所在位置：在资源管理器中定位当前压缩包文件 -->
        <MenuItem Command="{Binding OpenArchiveLocationCommand}" InputGesture="Ctrl+Shift+L"
                  IsEnabled="{Binding IsArchiveLoaded}"
                  Header="{Binding LocalizedStrings[Menu_OpenArchiveLocation]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconLocate}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 关闭压缩包：卸载当前压缩包，返回初始状态 -->
        <MenuItem Command="{Binding CloseArchiveCommand}" InputGesture="Ctrl+W"
                  IsEnabled="{Binding IsArchiveLoaded}"
                  Header="{Binding LocalizedStrings[Menu_CloseArchive]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconSignOut}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 最近文件：显示最近打开过的压缩包列表，点击可快速打开 -->
        <MenuItem ItemsSource="{Binding RecentFiles}"
                  IsEnabled="{Binding RecentFiles.Count}"
                  Header="{Binding LocalizedStrings[Main_RecentFiles]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconHistory}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
          <MenuItem.ItemTemplate>
            <DataTemplate>
              <MenuItem Click="RecentFileMenuItem_Click"
                        CommandParameter="{Binding .}"
                        Header="{Binding .}">
                <MenuItem.Icon>
                  <PathIcon Data="{StaticResource IconHistory}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                </MenuItem.Icon>
              </MenuItem>
            </DataTemplate>
          </MenuItem.ItemTemplate>
        </MenuItem>
        <Separator />
        <!-- 清除最近文件列表 -->
        <MenuItem Command="{Binding ClearRecentFilesCommand}"
                  Header="{Binding LocalizedStrings[Main_ClearRecentFiles]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconDelete}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 刷新当前压缩包：重新读取文件列表 -->
        <MenuItem Command="{Binding RefreshArchiveCommand}" InputGesture="F5"
                  IsEnabled="{Binding IsArchiveLoaded}"
                  Header="{Binding LocalizedStrings[Menu_Refresh]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- 退出应用 -->
        <MenuItem Command="{Binding ExitCommand}"
                  Header="{Binding LocalizedStrings[Menu_Exit]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconSignOut}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <!-- 编辑菜单：解压/添加/删除/测试/注释/新建压缩包 -->
      <MenuItem Header="{Binding LocalizedStrings[Menu_Edit]}">
        <!-- 解压到...：弹出解压设置对话框，选择目标路径和选项 -->
        <MenuItem Command="{Binding ExtractArchiveCommand}" InputGesture="Ctrl+E"
                  IsEnabled="{Binding IsArchiveLoaded}"
                  Header="{Binding LocalizedStrings[Menu_ExtractArchive]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconExport}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 解压到此处：直接解压到压缩包所在目录 -->
        <MenuItem Command="{Binding ExtractArchiveHereCommand}" InputGesture="Ctrl+Shift+E"
                  IsEnabled="{Binding IsArchiveLoaded}"
                  Header="{Binding LocalizedStrings[Menu_ExtractHere]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconPin}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 解压到（压缩包名）：解压到以压缩包名命名的子文件夹 -->
        <MenuItem Command="{Binding ExtractArchiveToNameCommand}" InputGesture="Ctrl+Shift+T"
                  IsEnabled="{Binding IsArchiveLoaded}"
                  Header="{Binding LocalizedStrings[Menu_ExtractToName]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 智能解压：自动判断是否有公共根目录，决定解压方式 -->
        <MenuItem Command="{Binding SmartExtractCommand}"
                  IsEnabled="{Binding IsArchiveLoaded}"
                  Header="{Binding LocalizedStrings[Menu_SmartExtract]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconWand}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- 添加文件到压缩包 -->
        <MenuItem Command="{Binding AddFilesCommand}" InputGesture="Ctrl+Shift+A"
                  IsEnabled="{Binding IsArchiveLoaded}"
                  Header="{Binding LocalizedStrings[Menu_AddFiles]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 从压缩包删除文件 -->
        <MenuItem Command="{Binding DeleteFilesCommand}"
                  IsEnabled="{Binding IsArchiveLoaded}"
                  Header="{Binding LocalizedStrings[Menu_DeleteFiles]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconDismiss}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- 测试压缩包完整性 -->
        <MenuItem Command="{Binding TestArchiveCommand}" InputGesture="Ctrl+T"
                  IsEnabled="{Binding IsArchiveLoaded}"
                  Header="{Binding LocalizedStrings[Menu_TestArchive]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconCheckmark}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- 编辑压缩包注释（仅 ZIP 支持） -->
        <MenuItem Command="{Binding EditCommentCommand}"
                  IsEnabled="{Binding IsArchiveLoaded}"
                  Header="{Binding LocalizedStrings[Menu_ArchiveComment]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconChat}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- 新建压缩包：打开压缩设置窗口 -->
        <MenuItem Command="{Binding NewArchiveCommand}" InputGesture="Ctrl+N"
                  Header="{Binding LocalizedStrings[Menu_NewArchive]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconNewFile}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>

      </MenuItem>
      <!-- 视图菜单：主题/进度条/目录基线/预览面板/信息面板/保存布局 -->
      <MenuItem Header="{Binding LocalizedStrings[Menu_View]}">
        <!-- 切换主题：亮色/暗色/跟随系统 -->
        <MenuItem Command="{Binding ToggleThemeCommand}"
                  Header="{Binding LocalizedStrings[Menu_ToggleTheme]}">
          <MenuItem.Icon>
            <Border Classes="ToggleIconBox"
                    Background="{Binding IsDarkTheme, Converter={StaticResource BoolToToggleBgBrushConverter}}">
              <PathIcon Data="{StaticResource IconMoon}" Width="10" Height="10"
                        Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            </Border>
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- 切换进度条显示：文件列表中的压缩比进度条 -->
        <MenuItem Command="{Binding ToggleProgressBarsCommand}"
                  IsEnabled="{Binding IsArchiveLoaded}"
                  Header="{Binding LocalizedStrings[Menu_ProgressBars]}">
          <MenuItem.Icon>
            <Border Classes="ToggleIconBox"
                    Background="{Binding ShowProgressBars, Converter={StaticResource BoolToToggleBgBrushConverter}}">
              <PathIcon Data="{StaticResource IconDataBarVertical}" Width="10" Height="10"
                        Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            </Border>
          </MenuItem.Icon>
        </MenuItem>
        <!-- 目录大小基线：目录行大小基于子树还是当前层 -->
        <MenuItem Command="{Binding ToggleSepDirBaselineCommand}"
                  IsEnabled="{Binding IsArchiveLoaded}"
                  Header="{Binding LocalizedStrings[Menu_SepDirBaseline]}">
          <MenuItem.Icon>
            <Border Classes="ToggleIconBox"
                    Background="{Binding SeparateDirBaseline, Converter={StaticResource BoolToToggleBgBrushConverter}}">
              <PathIcon Data="{StaticResource IconFolder}" Width="10" Height="10"
                        Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            </Border>
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- 切换预览面板显示/隐藏 -->
        <MenuItem Command="{Binding TogglePreviewCommand}" InputGesture="Ctrl+P"
                  Header="{Binding LocalizedStrings[Menu_ShowPreviewPanel]}">
          <MenuItem.Icon>
            <Border Classes="ToggleIconBox"
                    Background="{Binding IsPreviewVisible, Converter={StaticResource BoolToToggleBgBrushConverter}}">
              <PathIcon Data="{StaticResource IconEye}" Width="10" Height="10"
                        Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            </Border>
          </MenuItem.Icon>
        </MenuItem>
        <!-- 切换信息面板显示/隐藏（预览区域右侧/下方的元数据面板） -->
        <MenuItem Command="{Binding ToggleInfoPanelVisibilityCommand}" InputGesture="Ctrl+Shift+I"
                  Header="{Binding LocalizedStrings[Menu_ShowInfoPanel]}">
          <MenuItem.Icon>
            <Border Classes="ToggleIconBox"
                    Background="{Binding Preview.ShowInfoPanel, Converter={StaticResource BoolToToggleBgBrushConverter}}">
              <PathIcon Data="{StaticResource IconPanelRight}" Width="10" Height="10"
                        Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            </Border>
          </MenuItem.Icon>
        </MenuItem>
        <!-- 切换信息面板方向：右侧/下方 -->
        <MenuItem Command="{Binding ToggleInfoPanelOrientationCommand}"
                  Header="{Binding LocalizedStrings[Menu_InfoPanelOrientation]}">
          <MenuItem.Icon>
            <Border Classes="ToggleIconBox"
                    Background="{Binding Preview.IsHorizontalInfoPanel, Converter={StaticResource BoolToToggleBgBrushConverter}}">
              <PathIcon Data="{StaticResource IconOrientation}" Width="10" Height="10"
                        Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            </Border>
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- 保存当前布局（窗口大小、分割器位置等） -->
        <MenuItem Command="{Binding SaveLayoutCommand}"
                  Header="{Binding LocalizedStrings[Menu_SaveLayout]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconSave}" Width="14" Height="14"
                      Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <!-- 工具菜单：密码管理器/收藏夹管理/设置 -->
      <MenuItem Header="{Binding LocalizedStrings[Menu_Tools]}">
        <!-- 密码管理器：管理已保存的压缩包密码，支持导入导出 -->
        <MenuItem Command="{Binding OpenPasswordManagerCommand}"
                  Header="{Binding LocalizedStrings[Menu_PasswordManager]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconKeyMultiple}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 收藏夹管理：管理常用路径收藏，支持添加/编辑/删除/排序 -->
        <MenuItem Command="{Binding OpenFavoritesManagerCommand}"
                  Header="{Binding LocalizedStrings[FavMgr_OpenManager]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconBookmarkMultiple}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- 打开设置窗口：配置压缩/解压/外观/预览等选项 -->
        <MenuItem Command="{Binding OpenSettingsCommand}" InputGesture="Ctrl+,"
                  Header="{Binding LocalizedStrings[Menu_Settings]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <!-- 帮助菜单：关于/捐赠 -->
      <MenuItem Header="{Binding LocalizedStrings[Menu_Help]}">
        <!-- 关于：显示版本信息、作者、依赖库、致谢 -->
        <MenuItem Command="{Binding OpenAboutCommand}"
                  Header="{Binding LocalizedStrings[Menu_About]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconInfo}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 捐赠：支持项目开发 -->
        <MenuItem Command="{Binding OpenDonateCommand}"
                  Header="{Binding LocalizedStrings[Menu_Donate]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconHeart}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <!-- 测试菜单：开发者诊断工具，仅 Debug 模式显示 -->
      <MenuItem x:Name="TestMenu">
        <MenuItem.Header>
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
            <PathIcon Data="{StaticResource IconEyedropper}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            <TextBlock Text="{Binding LocalizedStrings[Menu_Test]}" />
          </StackPanel>
        </MenuItem.Header>
        <!-- 图标测试窗口：查看所有图标资源及其状态 -->
        <MenuItem Click="TestWindow_Click" Tag="IconTestWindow"
                  Header="{Binding LocalizedStrings[Main_IconTestTitle]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconGrid}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- UI 控件测试窗口：查看所有控件样式变体 -->
        <MenuItem Click="TestWindow_Click" Tag="UiTestWindow"
                  Header="{Binding LocalizedStrings[Main_UiTestTitle]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconGrid}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- 关于窗口测试 -->
        <MenuItem Click="TestWindow_Click" Tag="AboutWindow"
                  Header="{Binding LocalizedStrings[Test_AboutWindow]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconInfo}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 设置窗口测试 -->
        <MenuItem Click="TestWindow_Click" Tag="SettingsWindow"
                  Header="{Binding LocalizedStrings[Test_SettingsWindow]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 密码管理器窗口测试 -->
        <MenuItem Click="TestWindow_Click" Tag="PasswordManagerWindow"
                  Header="{Binding LocalizedStrings[Test_PasswordManager]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconKey}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 捐赠对话框测试 -->
        <MenuItem Click="TestWindow_Click" Tag="DonationDialog"
                  Header="{Binding LocalizedStrings[Test_DonationDialog]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconHeart}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- 日志隐私帮助对话框测试 -->
        <MenuItem Click="TestWindow_Click" Tag="LogPrivacyHelpDialog"
                  Header="{Binding LocalizedStrings[Test_LogPrivacyHelp]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconLockClosed}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 密码帮助对话框测试 -->
        <MenuItem Click="TestWindow_Click" Tag="PasswordHelpDialog"
                  Header="{Binding LocalizedStrings[Test_PasswordHelp]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconQuestion}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- 注释对话框测试 -->
        <MenuItem Click="TestWindow_Click" Tag="CommentDialog"
                  Header="{Binding LocalizedStrings[Test_CommentDialog]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconChat}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 密码编辑对话框测试 -->
        <MenuItem Click="TestWindow_Click" Tag="PasswordEditDialog"
                  Header="{Binding LocalizedStrings[Test_PasswordEditDialog]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconEdit}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 密码输入对话框测试 -->
        <MenuItem Click="TestWindow_Click" Tag="PasswordDialog"
                  Header="{Binding LocalizedStrings[Test_PasswordDialog]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconShieldLock}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- 进度窗口测试 -->
        <MenuItem Click="TestWindow_Click" Tag="ProgressWindow"
                  Header="{Binding LocalizedStrings[Test_ProgressWindow]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconTimer}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 错误对话框测试 -->
        <MenuItem Click="TestWindow_Click" Tag="ErrorDialog"
                  Header="{Binding LocalizedStrings[Test_ErrorDialog]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- 压缩设置窗口测试 -->
        <MenuItem Click="TestWindow_Click" Tag="CompressSettingsWindow"
                  Header="{Binding LocalizedStrings[Test_CompressSettings]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconCompress}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 解压设置窗口测试 -->
        <MenuItem Click="TestWindow_Click" Tag="ExtractSettingsWindow"
                  Header="{Binding LocalizedStrings[Test_ExtractSettings]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconCompress}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 压缩冲突对话框测试 -->
        <MenuItem Click="TestWindow_Click" Tag="CompressConflictDialog"
                  Header="{Binding LocalizedStrings[Test_CompressConflict]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 解压冲突对话框测试 -->
        <MenuItem Click="TestWindow_Click" Tag="ConflictDialog"
                  Header="{Binding LocalizedStrings[Test_ConflictDialog]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconLightning}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 匹配密码对话框测试 -->
        <MenuItem Click="TestWindow_Click" Tag="MatchedPasswordDialog"
                  Header="{Binding LocalizedStrings[Test_MatchedPassword]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconLockOpen}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- 提权对话框测试 -->
        <MenuItem Click="TestWindow_Click" Tag="ElevationDialog"
                  Header="{Binding LocalizedStrings[Test_ElevationDialog]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconShieldLock}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 提权失败对话框测试 -->
        <MenuItem Click="TestWindow_Click" Tag="ElevationFailedDialog"
                  Header="{Binding LocalizedStrings[Test_ElevationFailedDialog]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 提权信息对话框测试 -->
        <MenuItem Click="TestWindow_Click" Tag="ElevationInfoDialog"
                  Header="{Binding LocalizedStrings[Test_ElevationInfoDialog]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconInfo}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <!-- 添加收藏夹对话框测试 -->
        <MenuItem Click="TestWindow_Click" Tag="AddFavoriteDialog"
                  Header="{Binding LocalizedStrings[Test_AddFavoriteDialog]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconBookmarkAdd}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 收藏夹管理窗口测试 -->
        <MenuItem Click="TestWindow_Click" Tag="FavoriteManagerWindow"
                  Header="{Binding LocalizedStrings[Test_FavoriteManagerWindow]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 压缩包注释对话框测试 -->
        <MenuItem Click="TestWindow_Click" Tag="ArchiveCommentDialog"
                  Header="{Binding LocalizedStrings[Test_ArchiveCommentDialog]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconChat}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
        <!-- 自定义消息框测试 -->
        <MenuItem Click="TestWindow_Click" Tag="AppMessageBox"
                  Header="{Binding LocalizedStrings[Test_AppMessageBox]}">
          <MenuItem.Icon>
            <PathIcon Data="{StaticResource IconChat}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <!-- 语言菜单：切换界面语言 -->
      <MenuItem Header="{Binding LocalizedStrings[Menu_Language]}">
        <!-- 切换到中文 -->
        <MenuItem Header="{Binding LocalizedStrings[Menu_LangChinese]}"
                  Command="{Binding SwitchLanguageCommand}" CommandParameter="zh-CN" />
        <!-- 切换到繁體中文 -->
        <MenuItem Header="{Binding LocalizedStrings[Menu_LangTraditionalChinese]}"
                  Command="{Binding SwitchLanguageCommand}" CommandParameter="zh-TW" />
        <!-- 切换到英文 -->
        <MenuItem Header="{Binding LocalizedStrings[Menu_LangEnglish]}"
                  Command="{Binding SwitchLanguageCommand}" CommandParameter="en" />
      </MenuItem>
    </Menu>

    <!-- Toolbar (Row 1) — simplified: archive operations only -->
    <Border Grid.Row="1"
            Padding="6,4"
            Background="{DynamicResource ThemeHeaderBgBrush}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
        <Button Classes="ToolbarButton"
                Command="{Binding OpenArchiveCommand}"
                ToolTip.Tip="{Binding LocalizedStrings[Tooltip_Open]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconFolder}" Classes="ToolbarButtonIcon" Width="22" Height="22" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_Open]}"
                      Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
        <Button Classes="ToolbarButton"
                Command="{Binding NewArchiveCommand}"
                ToolTip.Tip="{Binding LocalizedStrings[Tooltip_NewArchive]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconDownload}" Classes="ToolbarButtonIcon" Width="22" Height="22" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_Compress]}"
                      Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
        <Button Classes="ToolbarButton"
                Command="{Binding ExtractArchiveCommand}"
                IsEnabled="{Binding IsArchiveLoaded}"
                ToolTip.Tip="{Binding LocalizedStrings[Tooltip_Extract]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconExport}" Classes="ToolbarButtonIcon" Width="22" Height="22" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_ExtractArchive]}"
                      Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
        <Button Classes="ToolbarButton"
                Command="{Binding ExtractSelectedToCommand}"
                IsEnabled="{Binding IsArchiveLoaded}"
                ToolTip.Tip="{Binding LocalizedStrings[Tooltip_ExtractSelectedTo]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconExport}" Classes="ToolbarButtonIcon" Width="22" Height="22" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_ExtractSelected]}"
                      Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
        <Button Classes="ToolbarButton"
                Command="{Binding SmartExtractCommand}"
                IsEnabled="{Binding IsArchiveLoaded}"
                ToolTip.Tip="{Binding LocalizedStrings[Tooltip_SmartExtract]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconWand}" Classes="ToolbarButtonIcon" Width="22" Height="22" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_SmartExtract]}"
                      Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
        
        <Border Width="1"
                Height="24"
                VerticalAlignment="Center"
                Background="{DynamicResource ThemeBorderBrush}"
                Margin="4,0" />
        <Button Classes="ToolbarButton"
                Command="{Binding AddFilesCommand}"
                IsEnabled="{Binding IsArchiveLoaded}"
                ToolTip.Tip="{Binding LocalizedStrings[Tooltip_AddFiles]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconAdd}" Classes="ToolbarButtonIcon" Width="22" Height="22" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_AddFiles]}"
                      Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
        <Button Classes="ToolbarButton"
                Command="{Binding DeleteFilesCommand}"
                IsEnabled="{Binding IsArchiveLoaded}"
                ToolTip.Tip="{Binding LocalizedStrings[Tooltip_DeleteFiles]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconDismiss}" Classes="ToolbarButtonIcon" Width="22" Height="22" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_DeleteFiles]}"
                      Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
        <Button Classes="ToolbarButton"
                Command="{Binding TestArchiveCommand}"
                IsEnabled="{Binding IsArchiveLoaded}"
                ToolTip.Tip="{Binding LocalizedStrings[Toolbar_Test]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconCheckmark}" Classes="ToolbarButtonIcon" Width="22" Height="22" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_Test]}"
                       Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
        <!-- 筛选栏开关：收起时筛选功能整体停用（条件保留，重新展开即恢复） -->
        <ToggleButton Classes="ToolbarButton"
                      IsChecked="{Binding IsFilterBarVisible}"
                      IsEnabled="{Binding IsArchiveLoaded}"
                      ToolTip.Tip="{Binding LocalizedStrings[Tooltip_Filter]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconSearch}" Classes="ToolbarButtonIcon" Width="22" Height="22" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_Filter]}"
                       Classes="ToolbarButtonLabel" />
          </StackPanel>
        </ToggleButton>
        <Border Width="1"
                Height="24"
                VerticalAlignment="Center"
                Background="{DynamicResource ThemeBorderBrush}"
                Margin="4,0" />
        <ToggleButton Classes="ToolbarButton"
                      IsChecked="{Binding IsPreviewVisible}"
                      ToolTip.Tip="{Binding LocalizedStrings[Tooltip_Preview]}">
          <StackPanel >
            <PathIcon Data="{StaticResource IconEye}" Classes="ToolbarButtonIcon" Width="22" Height="22" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_Preview]}"
                      Classes="ToolbarButtonLabel" />
          </StackPanel>
        </ToggleButton>
        <Border Width="1"
                Height="24"
                VerticalAlignment="Center"
                Background="{DynamicResource ThemeBorderBrush}"
                Margin="4,0" />
        <!-- 工具栏密码按钮：针对当前压缩包（对齐 WPF EnterPasswordBtn 三态：无加密禁用 / 未匹配红锁 / 已匹配绿开锁） -->
        <Button Classes="ToolbarButton"
                Classes.passwordMatched="{Binding HasMatchedPassword}"
                Command="{Binding EnterPasswordCommand}"
                ToolTip.Tip="{Binding ToolbarPasswordTooltip}">
          <StackPanel >
            <PathIcon Data="{Binding ToolbarPasswordIcon}" Classes="ToolbarButtonIcon" Width="22" Height="22"
                      Foreground="{Binding ToolbarPasswordForeground}" />
            <TextBlock Text="{Binding LocalizedStrings[Toolbar_Password]}"
                       Classes="ToolbarButtonLabel" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- 过滤栏（Row 2，可折叠）—— 延迟创建：默认隐藏时**不实例化**（启动优化：省 ~50 元素 XAML 膨胀）。
         实际控件在 Controls/MainFilterBar.axaml，由 MainWindow.EnsureFilterBar() 在 IsFilterBarVisible 首次为 true 时创建。 -->
    <ContentControl Grid.Row="2" x:Name="FilterBarHost" />

    <!-- Main content: TreeView | file list | preview (Row 3) -->
    <Grid Grid.Row="3">
      <!-- Drop hint overlay (shown when no archive loaded) -->
      <Border IsVisible="{Binding IsArchiveLoaded, Converter={StaticResource BoolInvertConverter}}"
              Background="{DynamicResource ThemeWindowBgBrush}">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="{DynamicResource SpacingXs}">
          <PathIcon Data="{StaticResource IconFolder}" Width="64" Height="64" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          <TextBlock Text="{Binding LocalizedStrings[Main_DropHint]}"
                    FontSize="16"
                    Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                    TextWrapping="Wrap"
                    HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- 压缩包内容区 —— 延迟创建：压缩包未打开时不可见，启动路径无需实例化 ~153 个元素
           （2026-10-21 启动优化）。实际控件在 Controls/ArchiveContentView.axaml，
           由 MainWindow.EnsureArchiveContent() 在 IsArchiveLoaded 首次为 true 时创建。 -->
      <ContentControl x:Name="ArchiveContentHost" />
    </Grid>

    <!-- Status bar (Row 4) -->
    <Border Grid.Row="4"
            Padding="8,4"
            Background="{DynamicResource ThemeHeaderBgBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Column="0"
                    Text="{Binding SelectionStats}"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                    FontSize="12" />
        <TextBlock Grid.Column="1"
                    Text="{Binding ArchiveStats}"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                    FontSize="12"
                    HorizontalAlignment="Center" />
        <!-- Password status -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="4"
                    IsVisible="{Binding HasPasswordStatus}"
                    Margin="0,0,8,0">
          <PathIcon Data="{Binding PasswordStatusIcon}"
                    Width="14" Height="14"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          <TextBlock Text="{Binding PasswordStatusMessage}"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                    FontSize="12" />
        </StackPanel>
        <!-- 状态栏错误文本：用只读 TextBox 以便鼠标选中 + Ctrl+C 复制 -->
        <TextBox Grid.Column="3"
                 Text="{Binding StatusMessage}"
                 IsReadOnly="True"
                 Background="Transparent"
                 Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                 BorderThickness="0"
                 Padding="0"
                 MinHeight="0"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Right"
                 FontSize="12" />
      </Grid>
    </Border>

    <!-- 打开压缩包加载遮罩（覆盖整个窗口，绑定 IsLoading） -->
    <Grid Grid.RowSpan="5"
          IsVisible="{Binding IsLoading}"
          Background="#88000000"
          ZIndex="1000">
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="{DynamicResource DialogPadding}"
              Background="{DynamicResource ThemeSurfaceBgBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}"
              BorderThickness="1"
              CornerRadius="{DynamicResource BorderRadius}">
        <StackPanel Spacing="{DynamicResource SpacingMd}"
                    HorizontalAlignment="Center"
                    MinWidth="260">
          <TextBlock Text="{Binding LocalizedStrings[Status_OpeningArchive]}"
                    Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                    FontSize="16"
                    HorizontalAlignment="Center" />
          <ProgressBar IsIndeterminate="True"
                      Width="180"
                      Height="6"
                      HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
