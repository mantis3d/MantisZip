<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MantisZip.UI.Avalonia.Views.PasswordDialog"
        x:CompileBindings="False"
        Title="{Binding DialogTitle}"
        Width="400"
        MinWidth="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBgBrush}">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBgBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
    </Style>
  </Window.Styles>

  <StackPanel Spacing="12"
              Margin="16">
    <!-- File name label -->
    <TextBlock Text="{Binding PromptText, FallbackValue=需要密码才能打开此压缩包}"
               TextWrapping="Wrap" />

    <!-- PasswordBox + reveal toggle -->
    <Grid ColumnDefinitions="*,Auto">
      <TextBox x:Name="PasswordBox"
               Grid.Column="0"
               PlaceholderText="{Binding PasswordPlaceholder}"
               PasswordChar="●" />
      <Button Grid.Column="1"
              Content="👁"
              Width="32"
              Height="28"
              Margin="4,0,0,0"
              Click="OnRevealToggle"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
        <Button.Styles>
          <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource ThemeButtonPressedBrush}" />
          </Style>
          <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}" />
          </Style>
        </Button.Styles>
      </Button>
    </Grid>

    <!-- Remember in session -->
    <CheckBox x:Name="RememberCheck"
              Content="{Binding RememberText}"
              IsChecked="True" />

    <!-- Buttons -->
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <Button Content="{Binding OkText}"
              Padding="16,6"
              Click="OnOkClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
        <Button.Styles>
          <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource ThemeButtonPressedBrush}" />
          </Style>
          <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}" />
          </Style>
        </Button.Styles>
      </Button>
      <Button Content="{Binding CancelText}"
              Padding="16,6"
              Click="OnCancelClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
        <Button.Styles>
          <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource ThemeButtonPressedBrush}" />
          </Style>
          <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeButtonHoverBrush}" />
          </Style>
        </Button.Styles>
      </Button>
    </StackPanel>
  </StackPanel>
</Window>
