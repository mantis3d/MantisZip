<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MantisZip.UI.Avalonia.Views.PasswordDialog"
        x:CompileBindings="False"
        Title="{Binding DialogTitle}"
        Width="400"
        MinWidth="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBgBrush}">

  <StackPanel Spacing="{DynamicResource SpacingSm}"
              Margin="{DynamicResource SpacingMdThk}">
    <!-- File name label -->
    <TextBlock Text="{Binding PromptText, FallbackValue=需要密码才能打开此压缩包}"
               TextWrapping="Wrap"
               Foreground="{DynamicResource ThemeTextPrimaryBrush}" />

    <!-- PasswordBox + reveal toggle -->
    <Grid ColumnDefinitions="*,Auto">
      <TextBox x:Name="PasswordBox"
               Grid.Column="0"
               PlaceholderText="{Binding PasswordPlaceholder}"
               PasswordChar="●" />
      <Button Grid.Column="1"
              Content="👁"
              Width="32"
              Height="{DynamicResource ControlHeight}"
              Margin="4,0,0,0"
              Click="OnRevealToggle"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
      </Button>
    </Grid>

    <!-- Remember in session -->
    <CheckBox x:Name="RememberCheck"
              Content="{Binding RememberText}"
              IsChecked="True" />

    <!-- Buttons -->
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="{DynamicResource SpacingXs}">
      <Button Content="{Binding OkText}"
              Padding="16,6"
              Click="OnOkClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
      </Button>
      <Button Content="{Binding CancelText}"
              Padding="16,6"
              Click="OnCancelClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
      </Button>
    </StackPanel>
  </StackPanel>
</Window>
