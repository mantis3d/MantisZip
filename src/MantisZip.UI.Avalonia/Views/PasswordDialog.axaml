<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MantisZip.UI.Avalonia.Views.PasswordDialog"
        x:CompileBindings="False"
        Title="{Binding DialogTitle}"
        Width="440"
        MinWidth="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeWindowBgBrush}">

  <StackPanel Spacing="{DynamicResource SpacingSm}"
              Margin="{DynamicResource SpacingMdThk}">
    <!-- 文件名标签：显示当前需要输入密码的压缩包名称 -->
    <TextBlock x:Name="FileNameText"
               FontWeight="Bold" FontSize="14"
               Margin="0,0,0,4"
               Foreground="{DynamicResource ThemeTextPrimaryBrush}" />

    <!-- 已保存密码选择器：下拉选择已保存的密码，或选择「输入新密码」 -->
    <ComboBox x:Name="PasswordSelector"
              IsEditable="False"
              FontSize="13"
              Padding="6,4"
              SelectionChanged="PasswordSelector_SelectionChanged">
      <ComboBoxItem Content="{Binding NewPasswordOptionText}" Tag="__new__"/>
    </ComboBox>

    <!-- 密码输入框 + 显示/隐藏切换按钮 -->
    <Grid ColumnDefinitions="*,Auto">
      <Grid Grid.Column="0">
        <!-- 密码输入框：使用 PasswordChar 掩码显示，支持回车键确认 -->
        <TextBox x:Name="PasswordBox"
                 PlaceholderText="{Binding PasswordPlaceholder}"
                 PasswordChar="●"
                 KeyDown="PasswordBox_KeyDown" />
      </Grid>
      <!-- 密码显示/隐藏切换按钮：点击切换密码明文/掩码显示 -->
      <Button Grid.Column="1"
              Width="32"
              Height="{DynamicResource ControlHeight}"
              Margin="4,0,0,0"
              Click="OnRevealToggle"
              ToolTip.Tip="{Binding RevealTooltip}"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
        <PathIcon Data="{StaticResource IconEye}" Width="16" Height="16" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
      </Button>
    </Grid>

    <!-- 会话内记住密码复选框：勾选后本次会话内自动匹配该密码 -->
    <CheckBox x:Name="RememberCheck"
              Content="{Binding RememberText}"
              IsChecked="True"
              IsCheckedChanged="OnRememberChanged" />

    <!-- 扩展保存选项区域：永久保存、自动生成匹配规则、描述、匹配规则 -->
    <StackPanel x:Name="SaveOptionsPanel" Spacing="{DynamicResource SpacingSm}">
      <!-- 永久保存到密码库复选框 -->
      <CheckBox x:Name="SavePermanentlyCheck"
                Content="{Binding SavePermanentlyText}"
                IsChecked="False"
                IsCheckedChanged="OnSavePermanentlyChanged" />

      <!-- 自动生成匹配规则复选框：根据文件名自动生成 glob/regex 规则 -->
      <CheckBox x:Name="AutoGenerateRulesCheck"
                Content="{Binding AutoGenerateRulesText}"
                IsChecked="True"
                IsCheckedChanged="OnAutoGenerateRulesChanged" />

      <!-- 密码描述输入框：为密码添加备注说明 -->
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding DescriptionLabelText}"
                   FontSize="11"
                   Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
        <TextBox x:Name="DescTextBox"
                 FontSize="12"
                 Padding="4,2"
                 Height="22"
                 PlaceholderText="{Binding DescriptionWatermark}" />
      </StackPanel>

      <!-- 匹配规则输入框：支持 glob 通配符和 regex 正则表达式，多行输入 -->
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding MatchRulesLabelText}"
                   FontSize="11"
                   Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
        <TextBox x:Name="PatternsTextBox"
                 FontSize="12"
                 Padding="4,2"
                 Height="50"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 PlaceholderText="{Binding MatchRulesWatermark}" />
      </StackPanel>
    </StackPanel>

    <!-- 底部按钮区域：确定（IsDefault）/ 取消（IsCancel） -->
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="{DynamicResource SpacingXs}">
      <Button Content="{Binding OkText}"
              Padding="16,6"
              Click="OnOkClick"
              IsDefault="True"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
      </Button>
      <Button Content="{Binding CancelText}"
              Padding="16,6"
              Click="OnCancelClick"
              IsCancel="True"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
      </Button>
    </StackPanel>
  </StackPanel>
</Window>
