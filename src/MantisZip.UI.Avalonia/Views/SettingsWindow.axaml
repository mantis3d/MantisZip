<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MantisZip.UI.Avalonia.ViewModels"
        x:Class="MantisZip.UI.Avalonia.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="520"
        Height="440"
        MinWidth="400"
        MinHeight="300"
        Background="{DynamicResource ThemeWindowBgBrush}">

  <Grid RowDefinitions="*,Auto"
        Margin="16">
    <!-- TabControl -->
    <TabControl Grid.Row="0"
                Background="{DynamicResource ThemeSurfaceBgBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}">
      <TabItem Header="{Binding TabPreviewHeader}">
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
          <StackPanel Spacing="10"
                      Margin="12">
            <CheckBox Content="{Binding EnableImagePreviewText}"
                      IsChecked="{Binding EnableImagePreview}" />
            <CheckBox Content="{Binding EnableTextPreviewText}"
                      IsChecked="{Binding EnableTextPreview}" />

            <Separator Background="{DynamicResource ThemeBorderBrush}" />

            <StackPanel Spacing="4">
              <TextBlock Text="{Binding TextPreviewFontSizeText}"
                         FontSize="13" />
              <Grid ColumnDefinitions="*,Auto">
                <Slider Grid.Column="0"
                        Minimum="8"
                        Maximum="48"
                        Value="{Binding TextPreviewFontSize}"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Margin="0,0,8,0" />
                <Border Grid.Column="1"
                        Padding="8,2">
                  <TextBlock Text="{Binding TextPreviewFontSize}"
                             VerticalAlignment="Center"
                             FontWeight="SemiBold" />
                </Border>
              </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="{Binding MaxPreviewBytesText}"
                         FontSize="13" />
              <TextBox Text="{Binding MaxTextPreviewBytes}"
                       Width="200"
                       HorizontalAlignment="Left" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding TabCompressHeader}">
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
          <StackPanel Spacing="10"
                      Margin="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding DefaultFormatText}"
                         FontSize="13" />
              <ComboBox SelectedValue="{Binding DefaultFormat}"
                        Width="160"
                        HorizontalAlignment="Left">
                <ComboBoxItem Content="zip" />
                <ComboBoxItem Content="7z" />
                <ComboBoxItem Content="tar.gz" />
              </ComboBox>
            </StackPanel>

            <Separator Background="{DynamicResource ThemeBorderBrush}" />

            <StackPanel Spacing="4">
              <TextBlock Text="{Binding CompressionLevelText}"
                         FontSize="13" />
              <Grid ColumnDefinitions="*,Auto">
                <Slider Grid.Column="0"
                        Minimum="1"
                        Maximum="9"
                        Value="{Binding DefaultLevel}"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Margin="0,0,8,0" />
                <Border Grid.Column="1"
                        Padding="8,2">
                  <TextBlock Text="{Binding DefaultLevel}"
                             VerticalAlignment="Center"
                             FontWeight="SemiBold" />
                </Border>
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{Binding TabDebugHeader}">
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
          <StackPanel Spacing="10"
                      Margin="12">
            <CheckBox Content="{Binding EnableDebugLogText}"
                      IsChecked="{Binding EnableDebugLogging}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Bottom buttons -->
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,12,0,0">
      <Button Content="{Binding SaveText}"
              Padding="16,6"
              Click="OnSaveClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
      </Button>
      <Button Content="{Binding CancelText}"
              Padding="16,6"
              Click="OnCancelClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}">
      </Button>
    </StackPanel>
  </Grid>
</Window>
