<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MantisZip.UI.Avalonia.ViewModels"
        xmlns:services="clr-namespace:MantisZip.UI.Avalonia.Services"
        xmlns:controls="clr-namespace:MantisZip.UI.Avalonia.Controls"
        xmlns:models="clr-namespace:MantisZip.UI.Avalonia.Models"
        xmlns:local="clr-namespace:MantisZip.UI.Avalonia.Views"
        x:Class="MantisZip.UI.Avalonia.Views.SettingsWindow"
        x:Name="SettingsWin"
        x:DataType="vm:SettingsWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="820"
        Height="640"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        Foreground="{DynamicResource ThemeTextPrimaryBrush}"
        Background="{DynamicResource ThemeWindowBgBrush}">
  <Window.Resources>
    <local:PositionDisplayConverter x:Key="PositionDisplayConverter" />
  </Window.Resources>

  <Grid RowDefinitions="*,Auto"
        Margin="16">
    <!-- Tabs -->
    <TabControl Grid.Row="0" TabStripPlacement="Left"
                Background="{DynamicResource ThemeSurfaceBgBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}">


      <!-- ═══════ 1. 压缩 ═══════ -->
      <TabItem Classes="compactTab">
        <TabItem.Header>
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Data="{StaticResource IconCompress}" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            <TextBlock Text="{Binding TabCompressHeader}" Grid.Column="1" Margin="4,0,0,0"
                      VerticalAlignment="Center" />
          </Grid>
        </TabItem.Header>
        <Grid>
          <TabControl TabStripPlacement="Top"
                      Background="{DynamicResource ThemeSurfaceBgBrush}"
                      BorderBrush="{DynamicResource ThemeBorderBrush}">
            <!-- 通用 General -->
            <TabItem Header="{Binding CompressTabGeneralHeader}" Classes="compactTab">
              <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
                <StackPanel Spacing="{DynamicResource SpacingSm}" Margin="{DynamicResource SpacingSmThk}">
                  <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
                    <StackPanel Spacing="{DynamicResource SpacingXs}">
                      <TextBlock Text="{Binding DefaultFormatText}" FontWeight="SemiBold" />
                      <ComboBox ItemsSource="{Binding DefaultFormatOptions}"
                                SelectedItem="{Binding SelectedDefaultFormatOption}"
                                Width="240" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                  </Border>
      
                  <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
                    <StackPanel Spacing="{DynamicResource SpacingXs}">
                      <TextBlock Text="{Binding CompressionLevelText}" FontWeight="SemiBold" />
                      <ComboBox ItemsSource="{Binding DefaultLevelOptions}"
                                SelectedItem="{Binding SelectedDefaultLevelOption}"
                                Width="240" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                  </Border>
      
                  <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
                    <StackPanel Spacing="{DynamicResource SpacingXs}">
                      <TextBlock Text="{Binding CompressOptionsText}" FontWeight="SemiBold" />
                      <CheckBox Content="{Binding CloseAfterCompressText}"
                                IsChecked="{Binding CloseAfterCompress}" />
                      <CheckBox Content="{Binding KeepOriginalExtensionText}"
                                IsChecked="{Binding KeepOriginalExtension}" />
                      <CheckBox Content="{Binding PreserveDirectoryRootText}"
                                IsChecked="{Binding PreserveDirectoryRoot}" />
                    </StackPanel>
                  </Border>
      
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <!-- 格式 Format -->
            <TabItem Header="{Binding CompressTabFormatHeader}" Classes="compactTab">
              <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
                <StackPanel Spacing="{DynamicResource SpacingSm}" Margin="{DynamicResource SpacingSmThk}">
                  <!-- ZIP 默认选项 -->
                  <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
                    <StackPanel Spacing="{DynamicResource SpacingXs}">
                      <TextBlock Text="{Binding ZipDefaultOptionsText}" FontWeight="SemiBold" />
      
                      <Grid ColumnDefinitions="120,*">
                        <TextBlock Text="{Binding ZipEncodingText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ZipEncodingOptions}"
                                  SelectedItem="{Binding SelectedZipEncodingOption}"
                                  Width="200" HorizontalAlignment="Left">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
      
                      <Grid ColumnDefinitions="120,*">
                        <TextBlock Text="{Binding ZipCompressionMethodText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ZipCompressionMethodOptions}"
                                  SelectedItem="{Binding SelectedZipCompressionMethodOption}"
                                  Width="200" HorizontalAlignment="Left">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
      
                      <Grid ColumnDefinitions="120,*">
                        <TextBlock Text="{Binding ZipEncryptionMethodText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ZipEncryptionMethodOptions}"
                                  SelectedItem="{Binding SelectedZipEncryptionMethodOption}"
                                  Width="200" HorizontalAlignment="Left">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
                    </StackPanel>
                  </Border>
      
                  <!-- 7z 默认选项 -->
                  <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
                    <StackPanel Spacing="{DynamicResource SpacingXs}">
                      <TextBlock Text="{Binding SevenZipDefaultOptionsText}" FontWeight="SemiBold" />
      
                      <Grid ColumnDefinitions="120,*">
                        <TextBlock Text="{Binding SevenZipCompressionMethodText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SevenZipCompressionMethodOptions}"
                                  SelectedItem="{Binding SelectedSevenZipCompressionMethodOption}"
                                  Width="200" HorizontalAlignment="Left">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
      
                      <CheckBox Content="{Binding SevenZipSolidText}" IsChecked="{Binding SevenZipSolid}" />
                      <CheckBox Content="{Binding SevenZipEncryptHeadersText}" IsChecked="{Binding SevenZipEncryptHeaders}" />
      
                      <Grid ColumnDefinitions="120,*">
                        <TextBlock Text="{Binding SevenZipSolidBlockSizeText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SevenZipSolidBlockSizeOptions}"
                                  SelectedItem="{Binding SelectedSevenZipSolidBlockSizeOption}"
                                  Width="200" HorizontalAlignment="Left">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
      
                      <Grid ColumnDefinitions="120,*">
                        <TextBlock Text="{Binding SevenZipDictionarySizeText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SevenZipDictionarySizeOptions}"
                                  SelectedItem="{Binding SelectedSevenZipDictionarySizeOption}"
                                  Width="200" HorizontalAlignment="Left">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
      
                      <Grid ColumnDefinitions="120,*">
                        <TextBlock Text="{Binding SevenZipNumFastBytesText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SevenZipNumFastBytesOptions}"
                                  SelectedItem="{Binding SelectedSevenZipNumFastBytesOption}"
                                  Width="200" HorizontalAlignment="Left">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
      
                      <Grid ColumnDefinitions="120,*">
                        <TextBlock Text="{Binding SevenZipMatchFinderText}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SevenZipMatchFinderOptions}"
                                  SelectedItem="{Binding SelectedSevenZipMatchFinderOption}"
                                  Width="200" HorizontalAlignment="Left">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </Grid>
      </TabItem>

      <!-- ═══════ 2. 解压 ═══════ -->
      <TabItem Classes="compactTab">
        <TabItem.Header>
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Data="{StaticResource IconFolder}" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            <TextBlock Text="{Binding TabExtractHeader}" Grid.Column="1" Margin="4,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
        </TabItem.Header>
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
          <StackPanel Spacing="{DynamicResource SpacingSm}" Margin="{DynamicResource SpacingSmThk}">
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding ExtractDefaultDestText}" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding ExtractDestinationOptions}"
                          SelectedItem="{Binding SelectedExtractDestinationOption}"
                          Width="240" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding ExtractConflictActionText}" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding FileConflictActionOptions}"
                          SelectedItem="{Binding SelectedFileConflictActionOption}"
                          Width="240" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding CompressOptionsText}" FontWeight="SemiBold" />
                <CheckBox Content="{Binding ExtractOpenFolderAfterText}"
                          IsChecked="{Binding OpenFolderAfterExtract}" />
                <CheckBox Content="{Binding ExtractEnableDragText}"
                          IsChecked="{Binding EnableDragExtract}" />
                <CheckBox Content="{Binding ExtractPreserveFullPathText}"
                          IsChecked="{Binding ExtractPreserveFullPath}" />
                <CheckBox Content="{Binding ExtractDeleteAfterExtractText}"
                          IsChecked="{Binding DeleteArchiveAfterExtract}" />
              </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding ExtractDoubleClickActionText}" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding DoubleClickActionOptions}"
                          SelectedItem="{Binding SelectedDoubleClickActionOption}"
                          Width="240" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Text="{Binding ExtractDoubleClickThresholdText}"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox Grid.Column="1" Text="{Binding DoubleClickOpenThresholdMB}"
                           Width="80" HorizontalAlignment="Left"
                           Background="{DynamicResource ThemeWindowBgBrush}"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           BorderBrush="{DynamicResource ThemeBorderBrush}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══════ 3. 外观 ═══════ -->
      <TabItem Classes="compactTab">
        <TabItem.Header>
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Data="{StaticResource IconPaintBrush}" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            <TextBlock Text="{Binding TabAppearanceHeader}" Grid.Column="1" Margin="4,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
        </TabItem.Header>
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
          <StackPanel Spacing="{DynamicResource SpacingSm}" Margin="{DynamicResource SpacingSmThk}">
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding AppearanceThemeText}" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedThemeOption}"
                          Width="200" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding AppearanceCompactnessText}" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding CompactnessModeOptions}"
                          SelectedItem="{Binding SelectedCompactnessModeOption}"
                          Width="200" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding AppearanceMaxRecentFilesText}" FontWeight="SemiBold" />
                <TextBox Text="{Binding MaxRecentFiles}"
                         Width="120" HorizontalAlignment="Left"
                         Background="{DynamicResource ThemeWindowBgBrush}"
                         Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                         BorderBrush="{DynamicResource ThemeBorderBrush}" />
              </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding AppearanceAppFontFamilyText}" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding AppFontFamilyOptions}"
                          SelectedItem="{Binding SelectedAppFontFamilyOption}"
                          Width="240" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══════ 4. 预览 ═══════ -->
      <TabItem Classes="compactTab">
        <TabItem.Header>
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Data="{StaticResource IconEye}" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            <TextBlock Text="{Binding TabPreviewHeader}" Grid.Column="1" Margin="4,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
        </TabItem.Header>
        <Grid>
          <TabControl TabStripPlacement="Top"
                      Background="{DynamicResource ThemeSurfaceBgBrush}"
                      BorderBrush="{DynamicResource ThemeBorderBrush}">
            <!-- 通用 General -->
            <TabItem Header="{Binding PreviewTabGeneralHeader}" Classes="compactTab">
              <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
                <StackPanel Spacing="{DynamicResource SpacingSm}" Margin="{DynamicResource SpacingSmThk}">
                  <CheckBox Content="{Binding PreviewShowPanelText}"
                            IsChecked="{Binding ShowPreviewPanel}" />

                  <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
                    <StackPanel Spacing="{DynamicResource SpacingXs}">
                      <TextBlock Text="{Binding PreviewPositionText}" FontWeight="SemiBold" />
                      <ComboBox ItemsSource="{Binding PreviewPositionOptions}"
                                SelectedItem="{Binding SelectedPreviewPositionOption}"
                                Width="240" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                  </Border>

                  <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
                    <StackPanel Spacing="{DynamicResource SpacingXs}">
                      <TextBlock Text="{Binding PreviewInfoOrientationText}" FontWeight="SemiBold" />
                      <ComboBox ItemsSource="{Binding InfoPanelOrientationOptions}"
                                SelectedItem="{Binding SelectedInfoPanelOrientationOption}"
                                Width="200" HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                  </Border>

                  <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
                    <StackPanel Spacing="{DynamicResource SpacingXs}">
                      <TextBlock Text="{Binding FormatDetectionSectionText}" FontWeight="SemiBold" />
                      <CheckBox Content="{Binding EnableFormatDetectionText}"
                                IsChecked="{Binding EnableFormatDetection}" />
                      <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0" Minimum="1" Maximum="64"
                                Value="{Binding PreviewHeadSizeKB}"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,0,8,0" />
                        <Border Grid.Column="1" Padding="8,2">
                          <TextBlock Text="{Binding PreviewHeadSizeKBText}"
                                     VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Border>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
                    <StackPanel Spacing="{DynamicResource SpacingXs}">
                      <TextBlock Text="{Binding PreviewMaxFileSizeText}" FontWeight="SemiBold" />
                      <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0" Minimum="1" Maximum="200"
                                Value="{Binding MaxPreviewFileSizeMB}"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,0,8,0" />
                        <Border Grid.Column="1" Padding="8,2">
                          <TextBlock Text="{Binding MaxPreviewFileSizeMBText}"
                                     VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Border>
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- 图片 Image -->
            <TabItem Header="{Binding PreviewTabImageHeader}" Classes="compactTab">
              <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
                <StackPanel Spacing="{DynamicResource SpacingSm}" Margin="{DynamicResource SpacingSmThk}">
                  <CheckBox Content="{Binding EnableImagePreviewText}"
                            IsChecked="{Binding EnableImagePreview}" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- 文本 Text -->
            <TabItem Header="{Binding PreviewTabTextHeader}" Classes="compactTab">
              <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
                <StackPanel Spacing="{DynamicResource SpacingSm}" Margin="{DynamicResource SpacingSmThk}">
                  <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
                    <StackPanel Spacing="{DynamicResource SpacingXs}">
                      <TextBlock Text="{Binding TextPreviewFontSizeText}" FontWeight="SemiBold" />
                      <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0" Minimum="8" Maximum="48"
                                Value="{Binding TextPreviewFontSize}"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,0,8,0" />
                        <Border Grid.Column="1" Padding="8,2">
                          <TextBlock Text="{Binding TextPreviewFontSize}"
                                     VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Border>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
                    <StackPanel Spacing="{DynamicResource SpacingXs}">
                      <TextBlock Text="{Binding PreviewTextFontFamilyText}" FontWeight="SemiBold" />
                      <ComboBox Width="240" HorizontalAlignment="Left"
                                ItemsSource="{Binding TextFontFamilyOptions}"
                                SelectedItem="{Binding SelectedTextFontFamilyOption}"
                                Background="{DynamicResource ThemeWindowBgBrush}"
                                Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Display}"
                                       Background="{DynamicResource ThemeWindowBgBrush}"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                  </Border>

                  <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
                    <StackPanel Spacing="{DynamicResource SpacingXs}">
                      <TextBlock Text="{Binding PreviewTextMaxSizeText}" FontWeight="SemiBold" />
                      <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0" Minimum="1" Maximum="100"
                                Value="{Binding MaxTextPreviewMB}"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,0,8,0" />
                        <Border Grid.Column="1" Padding="8,2">
                          <TextBlock Text="{Binding MaxTextPreviewMBText}"
                                     VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Border>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <CheckBox Content="{Binding EnableTextPreviewText}"
                            IsChecked="{Binding EnableTextPreview}" />
                  <CheckBox Content="{Binding PreviewTextColorEmojiText}"
                            IsChecked="{Binding UseColorEmoji}" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- 字体 Font -->
            <TabItem Header="{Binding PreviewTabFontHeader}" Classes="compactTab">
              <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
                <StackPanel Spacing="{DynamicResource SpacingSm}" Margin="{DynamicResource SpacingSmThk}">
                  <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
                    <StackPanel Spacing="{DynamicResource SpacingXs}">
                      <TextBlock Text="{Binding PreviewFontSampleText}" FontWeight="SemiBold" />
                      <TextBox Text="{Binding FontPreviewSampleText}"
                               AcceptsReturn="True"
                               Height="120"
                               TextWrapping="Wrap"
                               Background="{DynamicResource ThemeWindowBgBrush}"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                               BorderBrush="{DynamicResource ThemeBorderBrush}" />
                    </StackPanel>
                  </Border>

                  <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
                    <StackPanel Spacing="{DynamicResource SpacingXs}">
                      <TextBlock Text="{Binding PreviewFontPreviewSizeText}" FontWeight="SemiBold" />
                      <Grid ColumnDefinitions="*,Auto">
                        <Slider Grid.Column="0" Minimum="8" Maximum="72"
                                Value="{Binding FontPreviewFontSize}"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,0,8,0" />
                        <Border Grid.Column="1" Padding="8,2">
                          <TextBlock Text="{Binding FontPreviewFontSize}"
                                     VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Border>
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- 种子 Torrent -->
            <TabItem Header="{Binding PreviewTabTorrentHeader}" Classes="compactTab">
              <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
                <StackPanel Spacing="{DynamicResource SpacingSm}" Margin="{DynamicResource SpacingSmThk}">
                  <TextBlock Text="{Binding TorrentComingSoonText}"
                             Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                             FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- 可执行文件 PE -->
            <TabItem Header="{Binding PreviewTabExecutableHeader}" Classes="compactTab">
              <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
                <StackPanel Spacing="{DynamicResource SpacingSm}" Margin="{DynamicResource SpacingSmThk}">
                  <TextBlock Text="{Binding PeComingSoonText}"
                             Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                             FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- 数据表格 Datatable -->
            <TabItem Header="{Binding PreviewTabTableHeader}" Classes="compactTab">
              <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
                <StackPanel Spacing="{DynamicResource SpacingSm}" Margin="{DynamicResource SpacingSmThk}">
                  <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
                    <StackPanel Spacing="{DynamicResource SpacingXs}">
                      <TextBlock Text="{Binding PreviewTableMaxRowsText}" FontWeight="SemiBold" />
                      <TextBox Text="{Binding MaxTablePreviewRows}"
                               Width="120" HorizontalAlignment="Left"
                               Background="{DynamicResource ThemeWindowBgBrush}"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                               BorderBrush="{DynamicResource ThemeBorderBrush}" />
                    </StackPanel>
                  </Border>

                  <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
                    <StackPanel Spacing="{DynamicResource SpacingXs}">
                      <TextBlock Text="{Binding PreviewTableMaxColsText}" FontWeight="SemiBold" />
                      <TextBox Text="{Binding MaxTablePreviewCols}"
                               Width="120" HorizontalAlignment="Left"
                               Background="{DynamicResource ThemeWindowBgBrush}"
                               Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                               BorderBrush="{DynamicResource ThemeBorderBrush}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <!-- ═══════ 元数据面板 ═══════ -->
            <TabItem Header="{Binding PreviewTabMetadataPanelHeader}" Classes="compactTab">
              <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="{DynamicResource SpacingSmThk}">
                <!-- Field layout toggle -->
                <CheckBox Grid.Row="0"
                          IsChecked="{Binding MetadataPanelSettings.IsHorizontalLayout}"
                          Content="{Binding MetadataPanelSettings.FieldLayoutText}"
                          Margin="0,0,0,8"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}" />

                <!-- Type selector -->
                <ComboBox Grid.Row="1"
                          ItemsSource="{Binding MetadataPanelSettings.TypeOptions}"
                          SelectedItem="{Binding MetadataPanelSettings.SelectedType}"
                          Width="240" HorizontalAlignment="Left"
                          Margin="0,0,0,8"
                          Background="{DynamicResource ThemeWindowBgBrush}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Field list -->
                <ScrollViewer Grid.Row="2" Background="{DynamicResource ThemeWindowBgBrush}">
                  <StackPanel>
                    <!-- Header -->
                    <Grid ColumnDefinitions="*,80,80,110" Margin="4,4,4,2">
                    <TextBlock Grid.Column="0" Text="{Binding MetadataPanelSettings.ColumnFieldText}" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding MetadataPanelSettings.ColumnRowText}" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding MetadataPanelSettings.ColumnOrderText}" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding MetadataPanelSettings.ColumnPositionText}" FontWeight="SemiBold" FontSize="11"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding MetadataPanelSettings.Fields}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1"
                                  Padding="4,4">
                            <Grid ColumnDefinitions="*,80,80,110">
                              <!-- Field name -->
                              <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource ThemeTextPrimaryBrush}" />

                              <!-- Row -->
                              <TextBox Grid.Column="1" Text="{Binding Row}"
                                       Width="50" HorizontalContentAlignment="Center"
                                       Background="{DynamicResource ThemeWindowBgBrush}"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                       BorderBrush="{DynamicResource ThemeBorderBrush}"
                                       Height="24" HorizontalAlignment="Center" />

                              <!-- Order -->
                              <TextBox Grid.Column="2" Text="{Binding Order}"
                                       Width="50" HorizontalContentAlignment="Center"
                                       Background="{DynamicResource ThemeWindowBgBrush}"
                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                       BorderBrush="{DynamicResource ThemeBorderBrush}"
                                       Height="24" HorizontalAlignment="Center" />

                              <!-- Position -->
                              <ComboBox Grid.Column="3" ItemsSource="{Binding PositionOptions}"
                                        SelectedItem="{Binding Position}"
                                        Background="{DynamicResource ThemeWindowBgBrush}"
                                        Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                        Height="24" Width="100" HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding Converter={StaticResource PositionDisplayConverter}}" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>

                <!-- Preview -->
                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                  <TextBlock Text="{Binding MetadataPanelSettings.PreviewTitleText}" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"
                             Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                  <ItemsControl ItemsSource="{Binding MetadataPanelSettings.PreviewSections}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:MetadataSection">
                          <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                                  CornerRadius="{DynamicResource BorderRadius}" Padding="8,4" Margin="0,4,0,0"
                                  Background="{DynamicResource ThemeWindowBgBrush}">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11"
                                         Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                              <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="services:InfoPanelRow">
                                    <ItemsControl ItemsSource="{Binding Items}">
                                      <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                          <local:JustifyWrapPanel />
                                        </ItemsPanelTemplate>
                                      </ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:FormatMetadataItem">
                                          <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding Key}" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                                              <Button Width="16" Height="16" Padding="0"
                                                      BorderThickness="1"
                                                      Background="{DynamicResource ThemeSurfaceBgBrush}"
                                                      Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                      BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                      Click="OnPreviewFieldMoveUp">
                                                <PathIcon Data="{StaticResource IconArrowUp}" Width="10" Height="10" />
                                              </Button>
                                              <Button Width="16" Height="16" Padding="0"
                                                      BorderThickness="1"
                                                      Background="{DynamicResource ThemeSurfaceBgBrush}"
                                                      Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                                                      BorderBrush="{DynamicResource ThemeBorderBrush}"
                                                      Click="OnPreviewFieldMoveDown">
                                                <PathIcon Data="{StaticResource IconArrowDown}" Width="10" Height="10" />
                                              </Button>
                                            </StackPanel>
                                          </StackPanel>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
              </Grid>
            </TabItem>
          </TabControl>
        </Grid>
      </TabItem>

      <!-- ═══════ 5. 密码管理 ═══════ -->
      <TabItem Classes="compactTab">
        <TabItem.Header>
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Data="{StaticResource IconShieldLock}" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            <TextBlock Text="{Binding TabPasswordHeader}" Grid.Column="1" Margin="4,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
        </TabItem.Header>
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
          <StackPanel Spacing="{DynamicResource SpacingSm}" Margin="{DynamicResource SpacingSmThk}">
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding PasswordOptionsSectionText}" FontWeight="SemiBold" />
                <CheckBox Content="{Binding PwdShowNotificationText}"
                          IsChecked="{Binding ShowPasswordMatchNotification}" />
                <CheckBox Content="{Binding PwdRevealDefaultText}"
                          IsChecked="{Binding PasswordRevealByDefault}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══════ 6. 语言 ═══════ -->
      <TabItem Classes="compactTab">
        <TabItem.Header>
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Data="{StaticResource IconGlobe}" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            <TextBlock Text="{Binding TabLanguageHeader}" Grid.Column="1" Margin="4,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
        </TabItem.Header>
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
          <StackPanel Spacing="{DynamicResource SpacingSm}" Margin="{DynamicResource SpacingSmThk}">
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding LanguageText}" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding SelectedLanguageOptions}"
                          SelectedItem="{Binding SelectedSelectedLanguageOption}"
                          Width="200" HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding LanguageTranslatorText}"
                       FontSize="12"
                       Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══════ 7. 上下文菜单 ═══════ -->
      <TabItem Classes="compactTab">
        <TabItem.Header>
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Data="{StaticResource IconCopy}" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            <TextBlock Text="{Binding TabContextMenuHeader}" Grid.Column="1" Margin="4,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
        </TabItem.Header>
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
          <StackPanel Spacing="{DynamicResource SpacingSm}" Margin="{DynamicResource SpacingSmThk}">
            <!-- 菜单项目组 -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding ContextMenuGroupHeader}"
                           FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />

                <TextBlock Text="{Binding ContextMenuGroupBrowse}"
                           FontWeight="SemiBold" FontSize="12" />
                <CheckBox Content="{Binding ContextMenuEnableOpen}"
                          IsChecked="{Binding EnableOpenMenu}"
                          Margin="12,0,0,0" />

                <TextBlock Text="{Binding ContextMenuGroupCompress}"
                           FontWeight="SemiBold" FontSize="12"
                           Margin="0,6,0,0" />
                <CheckBox Content="{Binding ContextMenuEnableCompress}"
                          IsChecked="{Binding EnableCompressMenu}"
                          Margin="12,0,0,0" />
                <CheckBox Content="{Binding ContextMenuEnableCompressSeparate}"
                          IsChecked="{Binding EnableCompressSeparate}"
                          Margin="12,0,0,0" />
                <CheckBox Content="{Binding ContextMenuEnableCompressCombined}"
                          IsChecked="{Binding EnableCompressCombined}"
                          Margin="12,0,0,0" />

                <TextBlock Text="{Binding ContextMenuGroupExtract}"
                           FontWeight="SemiBold" FontSize="12"
                           Margin="0,6,0,0" />
                <CheckBox Content="{Binding ContextMenuEnableExtractHere}"
                          IsChecked="{Binding EnableExtractHereMenu}"
                          Margin="12,0,0,0" />
                <CheckBox Content="{Binding ContextMenuEnableSmartExtract}"
                          IsChecked="{Binding EnableSmartExtractMenu}"
                          Margin="12,0,0,0" />
                <CheckBox Content="{Binding ContextMenuEnableExtractToNamed}"
                          IsChecked="{Binding EnableExtractToNamedMenu}"
                          Margin="12,0,0,0" />
                <CheckBox Content="{Binding ContextMenuEnableExtractTo}"
                          IsChecked="{Binding EnableExtractToMenu}"
                          Margin="12,0,0,0" />
              </StackPanel>
            </Border>

            <!-- 显示组 -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding ContextMenuGroupDisplay}"
                           FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                <CheckBox Content="{Binding ContextMenuEnableDynamicMenu}"
                          IsChecked="{Binding EnableDynamicMenu}" />
                <CheckBox Content="{Binding ContextMenuShowMenuIcons}"
                          IsChecked="{Binding ShowMenuIcons}" />
              </StackPanel>
            </Border>

            <!-- 状态组 -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding ContextMenuStatusGroup}"
                           FontWeight="SemiBold" FontSize="13" Margin="0,0,0,4" />
                <TextBlock Text="{Binding ShellStatusText}"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
              </StackPanel>
            </Border>

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="{DynamicResource SpacingXs}">
              <Button Content="{Binding ContextMenuBtnApply}"
                      Command="{Binding ApplyShellChangesCommand}"
                      Padding="12,4"
                      Background="{DynamicResource ThemeButtonBgBrush}"
                      Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                      BorderBrush="{DynamicResource ThemeBorderBrush}" />
              <Button Content="{Binding ContextMenuInstall}"
                      Command="{Binding InstallShellCommand}"
                      IsEnabled="{Binding IsShellNotInstalled}"
                      Padding="12,4"
                      Background="{DynamicResource ThemeButtonBgBrush}"
                      Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                      BorderBrush="{DynamicResource ThemeBorderBrush}" />
              <Button Content="{Binding ContextMenuUninstall}"
                      Command="{Binding UninstallShellCommand}"
                      IsEnabled="{Binding IsShellInstalled}"
                      Padding="12,4"
                      Background="{DynamicResource ThemeButtonBgBrush}"
                      Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                      BorderBrush="{DynamicResource ThemeBorderBrush}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ═══════ 8. 文件关联 ═══════ -->
      <TabItem Classes="compactTab">
        <TabItem.Header>
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Data="{StaticResource IconLink}" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            <TextBlock Text="{Binding TabFileAssocHeader}" Grid.Column="1" Margin="4,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
        </TabItem.Header>
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
          <StackPanel Spacing="{DynamicResource SpacingSm}" Margin="{DynamicResource SpacingSmThk}">
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding AssocSectionText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding FileAssocDescText}"
                           FontSize="12"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                           TextWrapping="Wrap" />

                <!-- Per-extension list -->
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                              BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="4">
                  <ItemsControl ItemsSource="{Binding AssocItems}" Margin="4">
                    <ItemsControl.ItemTemplate>
                                          <DataTemplate x:DataType="vm:FormatAssocItemModel">
                        <Grid Margin="4" ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto">
                          <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                          <Image Source="{Binding Icon}" Width="16" Height="16" Margin="8,0,0,0" Grid.Column="1" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Extension}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                          </StackPanel>
                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentHandler}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}" VerticalAlignment="Center" />
                            <Button Width="28" Height="28" Command="{Binding DeleteCommand}" IsVisible="{Binding IsCustom}" Background="{DynamicResource ThemeButtonBgBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" Padding="4">
                                <PathIcon Data="{StaticResource IconDelete}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                              </Button>
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                  <Button Content="{Binding FileAssocSelectAllText}" Command="{Binding SelectAllAssocCommand}" Padding="12,4" />
                  <Button Content="{Binding FileAssocDeselectAllText}" Command="{Binding DeselectAllAssocCommand}" Padding="12,4" />
                                    <Button Content="{Binding FileAssocAddText}" Command="{Binding AddCustomAssocCommand}" Padding="12,4" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                  <Button Content="{Binding FileAssocInstallText}" Command="{Binding InstallSelectedAssocCommand}" Padding="12,4" Background="{DynamicResource ThemeButtonBgBrush}" />
                                    <Button Content="{Binding FileAssocUninstallText}" Command="{Binding UninstallAllAssocCommand}" Padding="12,4" Background="{DynamicResource ThemeButtonBgBrush}" />
                </StackPanel>

              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    
      <!-- ═══════ 9. 调试 ═══════ -->
      <TabItem Classes="compactTab">
        <TabItem.Header>
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Data="{StaticResource IconBug}" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            <TextBlock Text="{Binding TabDebugHeader}" Grid.Column="1" Margin="4,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
        </TabItem.Header>
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
          <StackPanel Spacing="{DynamicResource SpacingSm}" Margin="{DynamicResource SpacingSmThk}">
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding DebugSectionText}" FontWeight="SemiBold" />
                <CheckBox Content="{Binding DebugText}"
                          IsChecked="{Binding EnableDebugLogging}" />
              </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding LogPrivacyModeText}" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto">
                  <ComboBox Grid.Column="0"
                            ItemsSource="{Binding LogPrivacyModeOptions}"
                            SelectedItem="{Binding SelectedLogPrivacyModeOption}"
                            Width="240"
                            HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Display}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1"
                          Content="{Binding LogPrivacyHelpText}"
                          Command="{Binding OpenLogPrivacyHelpCommand}"
                          Padding="8,4"
                          Margin="8,0,0,0"
                          Background="{DynamicResource ThemeButtonBgBrush}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding LogPathText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LogFilePath}"
                           FontSize="12"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- ═══════ 10. 高级 ═══════ -->
      <TabItem Classes="compactTab">
        <TabItem.Header>
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Data="{StaticResource IconWrench}" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
            <TextBlock Text="{Binding TabAdvancedHeader}" Grid.Column="1" Margin="4,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>
        </TabItem.Header>
        <ScrollViewer Background="{DynamicResource ThemeWindowBgBrush}">
          <StackPanel Spacing="{DynamicResource SpacingSm}" Margin="{DynamicResource SpacingSmThk}">
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding AdvancedSevenZipPathText}" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0"
                           Text="{Binding SevenZipPath}"
                           PlaceholderText="C:\Program Files\7-Zip\7z.dll"
                           Margin="0,0,8,0"
                           Background="{DynamicResource ThemeWindowBgBrush}"
                           Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                           BorderBrush="{DynamicResource ThemeBorderBrush}" />
                  <Button Grid.Column="1"
                          Content="{Binding AdvancedBrowseText}"
                          Command="{Binding BrowseSevenZipCommand}"
                          Padding="12,4"
                          Background="{DynamicResource ThemeButtonBgBrush}"
                          Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                          BorderBrush="{DynamicResource ThemeBorderBrush}" />
                </Grid>
              </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <CheckBox Content="{Binding AdvancedAllowElevationText}"
                          IsChecked="{Binding AllowElevation}" />
              </StackPanel>
            </Border>

            <!-- 默认路径优先级（图片选择器初始路径） -->
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding DefaultPathGroupHeader}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding PathPriorityItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PathPriorityItemModel">
                      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2,0,2">
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        <Button Grid.Column="1" Width="26" Height="22" Padding="0" Margin="2,0,0,0"
                                IsEnabled="{Binding CanMoveUp}"
                                Command="{Binding $parent[ItemsControl].((vm:SettingsWindowViewModel)DataContext).MovePathUpCommand}"
                                CommandParameter="{Binding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ThemeButtonBgBrush}"
                                BorderBrush="{DynamicResource ThemeBorderBrush}">
                          <PathIcon Data="{StaticResource IconArrowUp}" Width="12" Height="12"
                                    Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        </Button>
                        <Button Grid.Column="2" Width="26" Height="22" Padding="0" Margin="2,0,0,0"
                                IsEnabled="{Binding CanMoveDown}"
                                Command="{Binding $parent[ItemsControl].((vm:SettingsWindowViewModel)DataContext).MovePathDownCommand}"
                                CommandParameter="{Binding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource ThemeButtonBgBrush}"
                                BorderBrush="{DynamicResource ThemeBorderBrush}">
                          <PathIcon Data="{StaticResource IconArrowDown}" Width="12" Height="12"
                                    Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXs}" Margin="0,4,0,0">
                  <TextBlock Text="{Binding DefaultPathDesktopRow}"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                </StackPanel>
                <controls:QuickPathPicker x:Name="CustomPathPicker"
                                          Path="{Binding CustomPath}"
                                          Margin="0,4,0,0" />
                <TextBlock Text="{Binding DefaultPathHint}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
              </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource BorderRadius}" Padding="{DynamicResource SpacingSmThk}" Background="{DynamicResource ThemeSurfaceBgBrush}">
              <StackPanel Spacing="{DynamicResource SpacingXs}">
                <TextBlock Text="{Binding AdvancedTempGroupText}"
                           FontWeight="SemiBold" />
                <Button Content="{Binding AdvancedCleanPreviewTempText}"
                        Command="{Binding CleanPreviewTempCommand}"
                        Padding="12,4"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource ThemeButtonBgBrush}"
                        Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" />
                <Button Content="{Binding AdvancedCleanAllTempText}"
                        Command="{Binding CleanAllTempCommand}"
                        Padding="12,4"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource ThemeButtonBgBrush}"
                        Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                        BorderBrush="{DynamicResource ThemeBorderBrush}" />
                <CheckBox Content="{Binding AdvancedCleanOnStartupText}"
                          IsChecked="{Binding CleanTempOnStartup}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>

    <!-- Bottom buttons -->
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="{DynamicResource SpacingXs}"
                Margin="0,12,0,0">
      <Button Content="{Binding SaveText}"
              Padding="16,6"
              Click="OnSaveClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}" />
      <Button Content="{Binding CancelText}"
              Padding="16,6"
              Click="OnCancelClick"
              Background="{DynamicResource ThemeButtonBgBrush}"
              Foreground="{DynamicResource ThemeTextPrimaryBrush}"
              BorderBrush="{DynamicResource ThemeBorderBrush}" />
    </StackPanel>
  </Grid>
</Window>
