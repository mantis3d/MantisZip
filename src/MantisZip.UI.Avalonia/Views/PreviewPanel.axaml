<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MantisZip.UI.Avalonia.ViewModels"
             xmlns:models="clr-namespace:MantisZip.UI.Avalonia.Models"
             xmlns:services="clr-namespace:MantisZip.UI.Avalonia.Services"
             xmlns:local="clr-namespace:MantisZip.UI.Avalonia.Views"

             x:Class="MantisZip.UI.Avalonia.Views.PreviewPanel"
             x:Name="ThisPanel"
             x:DataType="vm:PreviewViewModel">
    <UserControl.Resources>
      <!-- 透明棋盘格背景画刷 -->
      <DrawingBrush x:Key="TransparencyCheckerboardBrush"
                    TileMode="Tile" Stretch="None"
                    DestinationRect="0,0,8,8">
        <DrawingBrush.Drawing>
          <DrawingGroup>
            <GeometryDrawing Brush="#CCCCCC">
              <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="0,0,8,8" />
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="#FFFFFF">
              <GeometryDrawing.Geometry>
                <GeometryGroup>
                  <RectangleGeometry Rect="0,0,4,4" />
                  <RectangleGeometry Rect="4,4,4,4" />
                </GeometryGroup>
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
          </DrawingGroup>
        </DrawingBrush.Drawing>
      </DrawingBrush>
      <local:OrientationToBoolConverter x:Key="OrientationToBoolConverter" />
      <local:InvertBoolConverter x:Key="InvertBoolConverter" />
    </UserControl.Resources>
    <Grid x:Name="PreviewRootGrid"
          RowDefinitions="Auto,*,Auto"
          ColumnDefinitions="*,Auto">
    <!-- Toolbar -->
    <Border Grid.Row="0" Grid.Column="0"
            Padding="4,2"
            Background="{DynamicResource ThemeHeaderBgBrush}">
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXxs}">
        <!-- Zoom controls (image/gif) -->
        <StackPanel Orientation="Horizontal" Spacing="2"
                    IsVisible="{Binding HasZoomControls}">
          <Button Command="{Binding ZoomOutCommand}"
                  Width="32" Height="{DynamicResource ControlHeight}" Padding="0">
            <PathIcon Data="{StaticResource IconSubtract}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </Button>
          <Button Command="{Binding ZoomInCommand}"
                  Width="32" Height="{DynamicResource ControlHeight}" Padding="0">
            <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </Button>
          <Button Command="{Binding ZoomFitCommand}"
                  Width="32" Height="{DynamicResource ControlHeight}" Padding="0">
            <PathIcon Data="{StaticResource IconArrowFitIn}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </Button>
        </StackPanel>

        <!-- Font size controls (text) -->
        <StackPanel Orientation="Horizontal" Spacing="2"
                    IsVisible="{Binding HasFontSizeControls}">
          <Button Command="{Binding DecreaseFontSizeCommand}"
                  Width="36" Height="{DynamicResource ControlHeight}" Padding="0">
            <PathIcon Data="{StaticResource IconFontDecrease}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </Button>
          <Button Command="{Binding IncreaseFontSizeCommand}"
                  Width="36" Height="{DynamicResource ControlHeight}" Padding="0">
            <PathIcon Data="{StaticResource IconFontIncrease}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </Button>
        </StackPanel>

        <!-- GIF controls -->
        <StackPanel Orientation="Horizontal" Spacing="2"
                    IsVisible="{Binding HasGifControls}">
          <Button Command="{Binding PreviousGifFrameCommand}"
                  Width="32" Height="{DynamicResource ControlHeight}" Padding="0">
            <PathIcon Data="{StaticResource IconPrevious}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </Button>
          <Button Command="{Binding PlayPauseGifCommand}"
                  Width="32" Height="{DynamicResource ControlHeight}" Padding="0">
            <PathIcon Data="{StaticResource IconPlay}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </Button>
          <Button Command="{Binding NextGifFrameCommand}"
                  Width="32" Height="{DynamicResource ControlHeight}" Padding="0">
            <PathIcon Data="{StaticResource IconNext}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </Button>
          <TextBox Text="{Binding CurrentFrame}"
                   Width="36" Height="26"
                   FontSize="14"
                   VerticalContentAlignment="Center"
                   HorizontalContentAlignment="Center" />
           <TextBlock Text="{Binding TotalFrames, StringFormat=/ {0}}"
                      FontSize="14"
                      VerticalAlignment="Center" />
         </StackPanel>

        <!-- Transparency toggle (image / ICO gallery) -->
        <StackPanel Orientation="Horizontal" Spacing="2"
                    IsVisible="{Binding HasTransparencyControls}">
          <Button Width="32" Height="{DynamicResource ControlHeight}" Padding="0"
                  Command="{Binding ToggleTransparencyBgCommand}">
            <PathIcon Data="{StaticResource IconGrid}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </Button>
          <Button Width="32" Height="{DynamicResource ControlHeight}" Padding="0"
                  Command="{Binding ToggleFlattenAlphaCommand}"
                  IsVisible="{Binding HasFlattenAlphaControls}">
            <PathIcon Data="{StaticResource IconPaintBrush}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </Button>
        </StackPanel>

        <!-- ICO gallery controls -->
        <StackPanel Orientation="Horizontal" Spacing="2"
                    IsVisible="{Binding IsIcoGalleryVisible}">
          <Button Width="32" Height="{DynamicResource ControlHeight}" Padding="0"
                  Command="{Binding ToggleIcoFlattenAlphaCommand}">
            <PathIcon Data="{StaticResource IconPaintBrush}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </Button>
        </StackPanel>

        <!-- Ligature toggle (font preview) -->
        <StackPanel Orientation="Horizontal" Spacing="2"
                    IsVisible="{Binding HasLigatureControls}">
          <Button Content="连字"
                  Command="{Binding ToggleLigatureCommand}"
                  Width="48" Height="{DynamicResource ControlHeight}" FontSize="12" Padding="0"
                  IsEnabled="{Binding CanLigatureToggle}" />
        </StackPanel>

        <!-- Metadata panel settings (right-aligned) -->
        <StackPanel Orientation="Horizontal" Spacing="2"
                    HorizontalAlignment="Right">
          <Button Width="32" Height="{DynamicResource ControlHeight}" Padding="0"
                  Command="{Binding OpenMetadataSettingsCommand}"
                   ToolTip.Tip="{Binding MetadataSettingsTooltip}">
            <PathIcon Data="{StaticResource IconSettings}" Width="14" Height="14" Foreground="{DynamicResource ThemeTextPrimaryBrush}" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Preview content area -->
    <ScrollViewer x:Name="PreviewContentScroller" Grid.Row="1" Grid.Column="0"
                  Background="{DynamicResource ThemeSurfaceBgBrush}">
      <StackPanel>
        <!-- Content-top metadata items -->
        <Border Padding="{DynamicResource SpacingSmThk}"
                Background="{DynamicResource ThemeSurfaceBgBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="0,0,0,1">
          <ItemsControl ItemsSource="{Binding ContentTopItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="services:InfoPanelRow">
                <ItemsControl ItemsSource="{Binding Items}" Padding="8,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <local:JustifyWrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:FormatMetadataItem">
                      <StackPanel Margin="0,0,16,0" MinWidth="60">
                        <!-- Vertical: Key above Value -->
                        <StackPanel IsVisible="{Binding #ThisPanel.DataContext.FieldOrientation, Converter={StaticResource OrientationToBoolConverter}, ConverterParameter=vertical}">
                          <TextBlock Text="{Binding Key}" FontSize="11"
                                     Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                          <TextBlock Text="{Binding Value}" FontSize="12"
                                     Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                        <!-- Horizontal: Key: Value side by side -->
                        <StackPanel Orientation="Horizontal" Spacing="3"
                                    IsVisible="{Binding #ThisPanel.DataContext.FieldOrientation, Converter={StaticResource OrientationToBoolConverter}, ConverterParameter=horizontal}">
                          <TextBlock FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}">
                            <Run Text="{Binding Key}" />
                            <Run Text=":" />
                          </TextBlock>
                          <TextBlock Text="{Binding Value}" FontSize="12"
                                     Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <Grid>
        <!-- Unsupported / empty state -->
        <TextBlock Text="{Binding TextContent}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   IsVisible="{Binding IsUnsupportedVisible}" />

        <!-- Text preview -->
        <ScrollViewer IsVisible="{Binding IsTextVisible}">
          <TextBox Text="{Binding TextContent}"
                   IsReadOnly="True"
                   TextWrapping="Wrap"
                   FontFamily="{Binding TextPreviewFontFamily}"
                   FontSize="{Binding FontSize}"
                   Background="{DynamicResource ThemeSurfaceBgBrush}"
                   Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                   BorderThickness="0" />
        </ScrollViewer>

        <!-- CSV preview -->
        <DataGrid x:Name="CsvDataGrid"
                  IsVisible="{Binding IsCsvVisible}"
                  ItemsSource="{Binding CsvData}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  RowHeight="{DynamicResource ControlHeightMd}"
                  GridLinesVisibility="All" />

        <!-- PE preview -->
        <StackPanel IsVisible="{Binding IsPeVisible}"
                    Spacing="{DynamicResource SpacingXs}">
          <TextBlock Text="{Binding PeTitle}"
                     FontSize="20"
                     FontWeight="Bold" />
          <TextBlock Text="{Binding PeSubtitle}"
                     FontSize="13"
                     Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
          <Separator />
          <ItemsControl ItemsSource="{Binding PeMetadata}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PeMetadataItem">
                <Grid ColumnDefinitions="Auto,8,*"
                      Margin="0,2">
                  <TextBlock Text="{Binding Key}"
                             FontWeight="Bold"
                             Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                  <TextBlock Grid.Column="2"
                             Text="{Binding Value}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Image preview -->
        <ScrollViewer x:Name="ImagePreviewScrollViewer" IsVisible="{Binding IsImageVisible}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
          <Grid>
            <Rectangle Fill="{DynamicResource TransparencyCheckerboardBrush}"
                       IsVisible="{Binding IsTransparencyBgShown}" />
            <Image Source="{Binding PreviewImage}"
                   Width="{Binding ScaledWidth}"
                   Height="{Binding ScaledHeight}"
                   Stretch="Uniform" />
          </Grid>
        </ScrollViewer>

        <!-- GIF preview (same image control) -->
        <ScrollViewer x:Name="GifPreviewScrollViewer" IsVisible="{Binding IsGifVisible}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
          <Grid>
            <Rectangle Fill="{DynamicResource TransparencyCheckerboardBrush}"
                       IsVisible="{Binding IsTransparencyBgShown}" />
            <Image Source="{Binding PreviewImage}"
                   Width="{Binding ScaledWidth}"
                   Height="{Binding ScaledHeight}"
                   Stretch="Uniform" />
          </Grid>
        </ScrollViewer>

        <!-- ICO gallery -->
        <ScrollViewer IsVisible="{Binding IsIcoGalleryVisible}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding IcoFrames}"
                        Margin="{DynamicResource SpacingMdThk}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel HorizontalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource ThemeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource BorderRadius}"
                        Margin="8"
                        Padding="10">
                  <StackPanel Orientation="Vertical"
                              HorizontalAlignment="Center">
                    <Grid>
                      <Rectangle Fill="{DynamicResource TransparencyCheckerboardBrush}"
                                 x:CompileBindings="False"
                                 IsVisible="{Binding DataContext.IsTransparencyBgShown, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" />
                      <Image Source="{Binding Bitmap}"
                             Stretch="None"
                             MaxWidth="256"
                             MaxHeight="256"
                             Margin="{DynamicResource SpacingXxsThk}" />
                    </Grid>
                    <TextBlock Text="{Binding Label}"
                               FontSize="11"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- SVG preview -->
        <ScrollViewer IsVisible="{Binding IsSvgVisible}">
          <Grid>
            <Rectangle Fill="{DynamicResource TransparencyCheckerboardBrush}"
                       IsVisible="{Binding IsTransparencyBgShown}" />
            <Image Source="{Binding PreviewImage}" />
          </Grid>
        </ScrollViewer>

        <!-- Font preview -->
        <ScrollViewer x:Name="FontPreviewScrollViewer" IsVisible="{Binding IsFontVisible}">
          <StackPanel Spacing="{DynamicResource SpacingSm}">
            <TextBlock Text="{Binding PreviewHeaderText}"
                       FontSize="20"
                       FontWeight="Bold" />

            <Separator />
            <!-- SkiaSharp 渲染的字体样本位图（非空时显示） -->
            <Image Source="{Binding PreviewImage}"
                   Stretch="None"
                   HorizontalAlignment="Left" />
            <!-- SkiaSharp 渲染失败时的回退文本 -->
            <TextBlock Text="{Binding TextContent}"
                   FontFamily="{Binding TextPreviewFontFamily}"
                       FontSize="{Binding FontSize}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding IsFontTextFallbackVisible}" />
          </StackPanel>
        </ScrollViewer>

        <!-- Audio preview (metadata only) -->
        <StackPanel IsVisible="{Binding IsAudioVisible}"
                    Spacing="{DynamicResource SpacingXs}">
          <TextBlock Text="{Binding PreviewHeaderText}"
                     FontSize="20"
                     FontWeight="Bold" />
        </StackPanel>
        <!-- SQLite preview -->
        <Grid IsVisible="{Binding IsSqliteVisible}"
              RowDefinitions="Auto,*">
          <TabControl Grid.Row="0"
                      ItemsSource="{Binding SqliteTableNames}"
                      SelectedIndex="{Binding SelectedTableIndex}">
            <TabControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" />
              </DataTemplate>
            </TabControl.ItemTemplate>
          </TabControl>
          <DataGrid x:Name="SqliteDataGrid"
                    Grid.Row="1"
                    ItemsSource="{Binding SqliteTableData}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="True"
                    RowHeight="{DynamicResource ControlHeightMd}"
                    GridLinesVisibility="All" />
        </Grid>

        <!-- ISO preview (metadata only) -->
        <StackPanel IsVisible="{Binding IsIsoVisible}"
                    Spacing="{DynamicResource SpacingXs}">
          <TextBlock Text="{Binding PreviewHeaderText}"
                     FontSize="20"
                     FontWeight="Bold" />
        </StackPanel>
        
        <!-- Torrent preview -->
        <StackPanel IsVisible="{Binding IsTorrentVisible}"
                    Spacing="{DynamicResource SpacingXs}">
          <TextBlock Text="{Binding PreviewHeaderText}"
                     FontSize="20"
                     FontWeight="Bold" />
          <TextBlock Text="文件列表" FontWeight="SemiBold" />
          <TreeView ItemsSource="{Binding TorrentTreeRoots}"
                    BorderThickness="0"
                    Background="Transparent">
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}"
                                x:DataType="vm:TorrentTreeNode">
                <!-- Background=Transparent：让整行参与命中测试，点击行内任意位置均可选中 -->
                <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Text="{Binding SizeDisplay}"
                             Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </StackPanel>

        <!-- DOCX preview: 大纲（左）+ GridSplitter + 全文（右） -->
        <Grid IsVisible="{Binding IsDocxVisible}"
              ColumnDefinitions="Auto,4,*">
          <!-- 大纲 -->
          <Border Grid.Column="0"
                  Background="{DynamicResource ThemeSurfaceBgBrush}">
            <ScrollViewer MinWidth="120" MaxWidth="400">
              <StackPanel Spacing="2">
                <TextBlock Text="文档大纲"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                           Margin="4" />
                <ItemsControl ItemsSource="{Binding DocxOutline}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DocxOutlineItem">
                      <TextBlock Text="{Binding Text}"
                                 Margin="{Binding Indent}"
                                 Foreground="{DynamicResource ThemeAccentBrush}"
                                 FontWeight="Bold"
                                 TextWrapping="NoWrap"
                                 PointerPressed="OnOutlineItemClicked" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- 无大纲时的回退 -->
                <TextBlock Text="{Binding DocxNoOutlineText}"
                           IsVisible="{Binding !HasDocxOutline}"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                           Margin="4" />
              </StackPanel>
            </ScrollViewer>
          </Border>

          <!-- Splitter -->
          <GridSplitter Grid.Column="1" Width="4"
                        Background="{DynamicResource ThemeBorderBrush}"
                        ResizeBehavior="PreviousAndNext" />

          <!-- 全文 -->
          <Border Grid.Column="2"
                  Background="{DynamicResource ThemeSurfaceBgBrush}">
            <ScrollViewer x:Name="DocxFullTextScroller">
              <TextBlock Text="{Binding DocxFullText}"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                         Margin="8" />
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- XLSX preview -->
        <DataGrid x:Name="XlsxDataGrid"
                  IsVisible="{Binding IsXlsxVisible}"
                  ItemsSource="{Binding XlsxData}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="All" />

        <!-- PPTX preview -->
        <Border IsVisible="{Binding IsPptxVisible}"
                Background="{DynamicResource ThemeSurfaceBgBrush}">
          <ScrollViewer>
            <TextBox Text="{Binding TextContent}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     Background="Transparent"
                     Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                     BorderThickness="0"
                     Margin="8" />
          </ScrollViewer>
        </Border>

        <!-- Office preview (metadata only, legacy fallback) -->
        <StackPanel IsVisible="{Binding IsOfficeVisible}"
                    Spacing="{DynamicResource SpacingXs}">
          <TextBlock Text="{Binding PreviewHeaderText}"
                     FontSize="20"
                     FontWeight="Bold" />
        </StackPanel>
        
        <!-- Video preview (metadata only) -->
        <StackPanel IsVisible="{Binding IsVideoVisible}"
                    Spacing="{DynamicResource SpacingXs}">
          <TextBlock Text="{Binding PreviewHeaderText}"
                     FontSize="20"
                     FontWeight="Bold" />
        </StackPanel>
        
        <!-- Markdown 预览（控件树） -->
        <ScrollViewer IsVisible="{Binding IsMarkdownOrHtmlVisible}"
                      Background="{DynamicResource ThemeSurfaceBgBrush}"
                      Padding="{DynamicResource SpacingMdThk}">
          <ContentControl Content="{Binding MarkdownPreviewPanel}" />
        </ScrollViewer>


        <!-- PDF 预览（PdfPig + SkiaSharp 逐页位图渲染） -->
        <ScrollViewer IsVisible="{Binding IsPdfVisible}"
                      Background="{DynamicResource ThemeSurfaceBgBrush}">
          <Grid RowDefinitions="Auto,*">
            <!-- 翻页栏 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal"
                        HorizontalAlignment="Center" Spacing="{DynamicResource SpacingXs}"
                        IsVisible="{Binding HasPdfNavigation}">
              <Button Content="◀" Command="{Binding PdfPreviousPageCommand}"
                      Width="28" Height="26" FontSize="14" Padding="0" />
              <TextBox Text="{Binding PdfCurrentPage}"
                       Width="50" Height="26"
                       HorizontalContentAlignment="Center"
                       VerticalContentAlignment="Center" />
              <TextBlock Text="{Binding PdfPageInfo}"
                         VerticalAlignment="Center" />
              <Button Content="▶" Command="{Binding PdfNextPageCommand}"
                      Width="28" Height="26" FontSize="14" Padding="0" />
            </StackPanel>
            <!-- PDF 页内容（缩放联动 ImagePreview 的 ScrollViewer） -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
              <Image Source="{Binding PreviewImage}"
                     Width="{Binding ScaledWidth}"
                     Height="{Binding ScaledHeight}"
                     Stretch="Uniform" />
            </ScrollViewer>
          </Grid>
        </ScrollViewer>

        <!-- Loading page (Phase 1 — replaces preview content area entirely) -->
        <StackPanel IsVisible="{Binding IsLoadingPreview}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="20">
          <!-- Bouncing dots spinner -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{DynamicResource SpacingXs}">
            <Border Width="10" Height="10" CornerRadius="5"
                    Background="{DynamicResource ThemeTextSecondaryBrush}">
              <Border.Styles>
                <Style Selector="Border">
                  <Style.Animations>
                    <Animation Duration="0:0:1.0" IterationCount="Infinite">
                      <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.25"/>
                      </KeyFrame>
                      <KeyFrame Cue="40%">
                        <Setter Property="Opacity" Value="1.0"/>
                      </KeyFrame>
                      <KeyFrame Cue="60%">
                        <Setter Property="Opacity" Value="0.25"/>
                      </KeyFrame>
                      <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.25"/>
                      </KeyFrame>
                    </Animation>
                  </Style.Animations>
                </Style>
              </Border.Styles>
            </Border>
            <Border Width="10" Height="10" CornerRadius="5"
                    Background="{DynamicResource ThemeTextSecondaryBrush}">
              <Border.Styles>
                <Style Selector="Border">
                  <Style.Animations>
                    <Animation Duration="0:0:1.0" IterationCount="Infinite"
                               Delay="0:0:0.2">
                      <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.25"/>
                      </KeyFrame>
                      <KeyFrame Cue="40%">
                        <Setter Property="Opacity" Value="1.0"/>
                      </KeyFrame>
                      <KeyFrame Cue="60%">
                        <Setter Property="Opacity" Value="0.25"/>
                      </KeyFrame>
                      <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.25"/>
                      </KeyFrame>
                    </Animation>
                  </Style.Animations>
                </Style>
              </Border.Styles>
            </Border>
            <Border Width="10" Height="10" CornerRadius="5"
                    Background="{DynamicResource ThemeTextSecondaryBrush}">
              <Border.Styles>
                <Style Selector="Border">
                  <Style.Animations>
                    <Animation Duration="0:0:1.0" IterationCount="Infinite"
                               Delay="0:0:0.4">
                      <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.25"/>
                      </KeyFrame>
                      <KeyFrame Cue="40%">
                        <Setter Property="Opacity" Value="1.0"/>
                      </KeyFrame>
                      <KeyFrame Cue="60%">
                        <Setter Property="Opacity" Value="0.25"/>
                      </KeyFrame>
                      <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.25"/>
                      </KeyFrame>
                    </Animation>
                  </Style.Animations>
                </Style>
              </Border.Styles>
            </Border>
          </StackPanel>

          <TextBlock Text="{Binding LoadingFileName, StringFormat=正在加载: {0}}"
                     HorizontalAlignment="Center"
                     FontSize="14"
                     Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                     TextWrapping="Wrap"
                     MaxWidth="450"
                     TextAlignment="Center" />
        </StackPanel>
      </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- Preview Info Panel (placed dynamically by ApplyInfoPanelOrientation) -->
    <Border x:Name="PreviewInfoBorder"
            Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
            Width="220"
            Background="{DynamicResource ThemeHeaderBgBrush}"
            BorderBrush="{DynamicResource ThemeBorderBrush}"
            BorderThickness="1,0,0,0"
            IsVisible="{Binding IsInfoPanelVisible}">
      <ScrollViewer Padding="10">
        <StackPanel Spacing="{DynamicResource SpacingXs}">
          <!-- Format-specific info section (Phase 2) — shown first -->
          <ItemsControl ItemsSource="{Binding FormatSections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="services:MetadataSection">
                <StackPanel Spacing="{DynamicResource SpacingXxs}">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                             Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="services:InfoPanelRow">
                        <ItemsControl ItemsSource="{Binding Items}" Padding="8,0">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <local:JustifyWrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:FormatMetadataItem">
                              <StackPanel Margin="0,0,12,4" MinWidth="80">
                                <!-- Vertical: Key above Value -->
                                <StackPanel IsVisible="{Binding #ThisPanel.DataContext.FieldOrientation, Converter={StaticResource OrientationToBoolConverter}, ConverterParameter=vertical}">
                                  <TextBlock Text="{Binding Key}" FontSize="11"
                                             Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                                  <TextBlock Text="{Binding Value}" FontSize="12"
                                             Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                             TextWrapping="Wrap" />
                                </StackPanel>
                                <!-- Horizontal: Key: Value side by side -->
                                <StackPanel Orientation="Horizontal" Spacing="3"
                                            IsVisible="{Binding #ThisPanel.DataContext.FieldOrientation, Converter={StaticResource OrientationToBoolConverter}, ConverterParameter=horizontal}">
                                  <TextBlock FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}">
                                    <Run Text="{Binding Key}" />
                                    <Run Text=":" />
                                  </TextBlock>
                                  <TextBlock Text="{Binding Value}" FontSize="12"
                                             Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                             TextWrapping="Wrap" />
                                </StackPanel>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Separator -->
          <Separator />

          <!-- Common file info section — shown below -->
          <ItemsControl ItemsSource="{Binding CommonSections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="services:MetadataSection">
                <StackPanel Spacing="{DynamicResource SpacingXxs}">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                             Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="services:InfoPanelRow">
                        <ItemsControl ItemsSource="{Binding Items}" Padding="8,0">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <local:JustifyWrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:FormatMetadataItem">
                              <StackPanel Margin="0,0,12,4" MinWidth="80">
                                <!-- Vertical: Key above Value -->
                                <StackPanel IsVisible="{Binding #ThisPanel.DataContext.FieldOrientation, Converter={StaticResource OrientationToBoolConverter}, ConverterParameter=vertical}">
                                  <TextBlock Text="{Binding Key}" FontSize="11"
                                             Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                                  <TextBlock Text="{Binding Value}" FontSize="12"
                                             Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                             TextWrapping="Wrap" />
                                </StackPanel>
                                <!-- Horizontal: Key: Value side by side -->
                                <StackPanel Orientation="Horizontal" Spacing="3"
                                            IsVisible="{Binding #ThisPanel.DataContext.FieldOrientation, Converter={StaticResource OrientationToBoolConverter}, ConverterParameter=horizontal}">
                                  <TextBlock FontSize="11" Foreground="{DynamicResource ThemeTextSecondaryBrush}">
                                    <Run Text="{Binding Key}" />
                                    <Run Text=":" />
                                  </TextBlock>
                                  <TextBlock Text="{Binding Value}" FontSize="12"
                                             Foreground="{DynamicResource ThemeTextPrimaryBrush}"
                                             TextWrapping="Wrap" />
                                </StackPanel>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Bottom spacer -->
          <Rectangle Height="6" Fill="Transparent" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
