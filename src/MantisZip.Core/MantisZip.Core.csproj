<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MantisZip.UI.Avalonia</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MantisZip.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- UI 测试要替身化 UpdateService 的网络层（SetTestHandler 是 internal）：
         KI-008 的回归点是「失败要显示失败文案而不是已是最新」，只能在这一层断言。 -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MantisZip.UI.Avalonia.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <!-- 覆盖传递依赖的原生库：Microsoft.Data.Sqlite 10.0.8 传递钉住 SQLitePCLRaw.lib.e_sqlite3 2.1.11
         （捆绑 SQLite < 3.50.2，CVE-2025-6965 / GHSA-2m69-gcr7-jv3q）。仅替换纯原生 e_sqlite3（ABI 稳定，
         不动 managed provider/core/bundle），消除该高危告警。 -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="SharpSevenZip" Version="2.0.45" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.8" />
    <PackageReference Include="Ude.NetStandard" Version="1.2.0" />
  </ItemGroup>

</Project>
