<Window x:Class="MantisZip.UI.CompressConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:MantisZip.UI.Localization"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="{l:L CompressConflict_Title}" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Theme_WindowBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>  <!-- Row 9: 分割线 -->
            <RowDefinition Height="Auto"/>  <!-- Row 10: 暂停/取消按钮 -->
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="13" Foreground="{StaticResource Theme_TextPrimary}" TextWrapping="Wrap"/>

        <!-- Row 2: 目标文件信息面板 -->
        <Border Grid.Row="2" Background="{StaticResource Theme_SurfaceBg}" BorderBrush="{StaticResource Theme_BorderLight}" BorderThickness="1" CornerRadius="4" Padding="12">
            <StackPanel>
                <TextBlock Text="{l:L CompressConflict_TargetLabel}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Theme_TextSecondary}" Margin="0,0,0,6"/>
                <TextBlock FontSize="11" Foreground="{StaticResource Theme_TextPrimary}" LineHeight="18">
                    <Run Text="{l:L Conflict_SizeLabel}"/><Run x:Name="TargetSizeText" Foreground="{StaticResource Theme_TextDisabled}"/>
                </TextBlock>
                <TextBlock FontSize="11" Foreground="{StaticResource Theme_TextPrimary}" LineHeight="18">
                    <Run Text="{l:L Conflict_DateLabel}"/><Run x:Name="TargetDateText" Foreground="{StaticResource Theme_TextDisabled}"/>
                </TextBlock>
                <TextBlock x:Name="TargetPathBlock" FontSize="11" Foreground="{StaticResource Theme_TextDisabled}" LineHeight="18" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Row 4: 操作按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="OverwriteBtn" Height="Auto" Padding="6,4" MinWidth="80" Click="Overwrite_Click"
                    Background="{StaticResource Theme_ButtonBg}" BorderBrush="{StaticResource Theme_Border}" BorderThickness="1" Margin="0,0,6,0">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <emoji:TextBlock Text="🔄" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="{l:L CompressConflict_Overwrite}" FontSize="11" Foreground="{StaticResource Theme_TextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="AddBtn" Height="Auto" Padding="6,4" MinWidth="100" Click="Add_Click"
                    Background="{StaticResource Theme_ButtonBg}" BorderBrush="{StaticResource Theme_Border}" BorderThickness="1" Margin="6,0,6,0">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <emoji:TextBlock Text="➕" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="{l:L CompressConflict_Add}" FontSize="11" Foreground="{StaticResource Theme_TextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="RenameBtn" Height="Auto" Padding="6,4" MinWidth="80" Click="Rename_Click"
                    Background="{StaticResource Theme_ButtonBg}" BorderBrush="{StaticResource Theme_Border}" BorderThickness="1" Margin="6,0,6,0">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <emoji:TextBlock Text="✏️" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="RenameBtnLabel" Text="{l:L CompressConflict_Rename}" FontSize="11" Foreground="{StaticResource Theme_TextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>
            <Button Height="Auto" Padding="6,4" MinWidth="70" Click="Cancel_Click"
                    Background="{StaticResource Theme_ButtonBg}" BorderBrush="{StaticResource Theme_Border}" BorderThickness="1" Margin="6,0,0,0">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <emoji:TextBlock Text="⏭️" FontSize="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="{l:L Error_Skip}" FontSize="11" Foreground="{StaticResource Theme_TextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Row 6: 自定义重命名输入 -->
        <Grid Grid.Row="6" HorizontalAlignment="Stretch" Margin="14,0">
            <TextBox x:Name="RenameTextBox" FontSize="12" Padding="3,2"/>
        </Grid>

        <!-- Row 8: 应用到全部 -->
        <CheckBox x:Name="ApplyAllCheck" Grid.Row="8"
                  Content="{l:L Error_ApplyToAll}"
                  FontSize="12" Foreground="{StaticResource Theme_TextSecondary}"
                  HorizontalAlignment="Center"/>

        <!-- Row 9: 分割线 -->
        <Rectangle Grid.Row="9" Height="1" Fill="{StaticResource Theme_BorderLight}" Margin="0,6,0,6"/>

        <!-- Row 10: 暂停/取消按钮 -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="PauseBtn" Height="Auto" Padding="10,5" MinWidth="80" Click="Pause_Click"
                    Background="{StaticResource Theme_ButtonBg}" BorderBrush="{StaticResource Theme_Border}" BorderThickness="1" Margin="0,0,8,0">
                <TextBlock Text="{l:L CompressConflict_Pause}" FontSize="12" Foreground="{StaticResource Theme_TextPrimary}" HorizontalAlignment="Center"/>
            </Button>
            <Button x:Name="CancelAllBtn" Height="Auto" Padding="10,5" MinWidth="80" Click="CancelOperation_Click"
                    Background="{StaticResource Theme_ButtonBg}" BorderBrush="{StaticResource Theme_Border}" BorderThickness="1">
                <TextBlock Text="{l:L CompressConflict_CancelOperation}" FontSize="12" Foreground="{StaticResource Theme_TextPrimary}" HorizontalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
