<Window x:Class="MantisZip.UI.ArchiveSaveAsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MantisZip.UI.Localization"
        xmlns:controls="clr-namespace:MantisZip.UI.Controls"
        Title="另存为" Height="420" Width="530"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource Theme_WindowBg}"
        Foreground="{DynamicResource Theme_TextPrimary}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Format conversion hint -->
        <TextBlock x:Name="ConversionHint" Grid.Row="0"
                   Foreground="{DynamicResource Theme_TextSecondary}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <!-- Main settings area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Output path: QuickPathControl (file-save mode) -->
                <GroupBox Header="保存位置" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="输出路径:" VerticalAlignment="Center"/>
                        <controls:QuickPathControl x:Name="PathControl" Grid.Row="0" Grid.Column="1"
                                                   IsFolderMode="False"
                                                   IsFileOpenMode="False"
                                                   FileTypeFilter="ZIP 文件|*.zip|7z 文件|*.7z|TAR.GZ 文件|*.tar.gz|所有文件|*.*"
                                                   DefaultFileName="archive.zip"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="格式:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <ComboBox x:Name="FormatComboBox" Grid.Row="1" Grid.Column="1" Height="24" Margin="0,8,0,0"
                                  SelectedIndex="0" SelectionChanged="FormatComboBox_SelectionChanged">
                            <ComboBoxItem Content="ZIP (.zip)" Tag="zip"/>
                            <ComboBoxItem Content="7z (.7z)" Tag="7z"/>
                            <ComboBoxItem Content="TAR.GZ (.tar.gz)" Tag="tar.gz"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <!-- Format-specific options -->
                <GroupBox Header="格式选项" Margin="0,0,0,10">
                    <controls:DynamicFormatOptionsPanel x:Name="FormatOptionsPanel"/>
                </GroupBox>

                <!-- Encryption options -->
                <GroupBox Header="加密" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="EncryptCheckBox" Content="启用加密"
                                  Checked="EncryptCheckBox_Changed" Unchecked="EncryptCheckBox_Changed"/>
                        <Grid x:Name="PasswordGrid" IsEnabled="False" Margin="20,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="密码:" VerticalAlignment="Center"/>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <PasswordBox x:Name="PasswordBox" Height="24"/>
                                <TextBox x:Name="PwdTextBox" Height="24" Visibility="Collapsed"/>
                            </Grid>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="确认密码:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,6,0,0">
                                <PasswordBox x:Name="ConfirmPasswordBox" Height="24"/>
                                <TextBox x:Name="ConfirmPwdTextBox" Height="24" Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- OK/Cancel -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="80" Height="28" Margin="0,0,8,0" IsDefault="True"
                    Click="Ok_Click"
                    Background="{DynamicResource Theme_Accent}"
                    Foreground="{DynamicResource Theme_TextOnAccent}"
                    BorderThickness="0"/>
            <Button Content="取消" Width="80" Height="28" IsCancel="True"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>