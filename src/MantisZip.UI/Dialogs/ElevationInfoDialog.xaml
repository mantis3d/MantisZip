<Window x:Class="MantisZip.UI.ElevationInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:MantisZip.UI.Localization"
        Title="{l:L ElevationInfoDialog_Title}" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource Theme_WindowBg}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 消息 -->
        <TextBlock Grid.Row="0" Text="{l:L ElevationInfoDialog_Message}"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource Theme_TextPrimary}"
                   TextWrapping="Wrap"/>

        <!-- 不可写入目录列表 -->
        <ItemsControl Grid.Row="2" x:Name="DirectoryList"
                      Foreground="{StaticResource Theme_TextSecondary}"
                      FontSize="12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="12,2,0,2"
                               TextWrapping="Wrap"
                               FontFamily="Consolas, Courier New, monospace"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 底部提示 + 确定按钮 -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="{l:L ElevationInfoDialog_Hint}"
                       Foreground="{StaticResource Theme_TextDisabled}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <Button Content="{l:L ElevationInfoDialog_Ok}"
                    Width="100" Height="32" HorizontalAlignment="Right"
                    IsDefault="True" IsCancel="True"
                    Click="Ok_Click"
                    Background="{StaticResource Theme_Accent}"
                    Foreground="{StaticResource Theme_TextOnAccent}"/>
        </StackPanel>
    </Grid>
</Window>
