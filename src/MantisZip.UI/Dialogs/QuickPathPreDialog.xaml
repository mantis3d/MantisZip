<Window x:Class="MantisZip.UI.QuickPathPreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MantisZip.UI.Controls"
        xmlns:l="clr-namespace:MantisZip.UI.Localization"
        Title="选择路径" Height="180" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme_WindowBg}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" FontSize="13" Margin="0,0,0,8"
                   Text="选择目标路径:"
                   Foreground="{DynamicResource Theme_TextPrimary}"/>

        <!-- QuickPathControl embedded -->
        <controls:QuickPathControl x:Name="PathControl" Grid.Row="1"
                                   IsFolderMode="True"
                                   VerticalAlignment="Top"/>

        <!-- OK/Cancel buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="{l:L MsgBox_Ok}" Width="80" Height="28" Margin="0,0,8,0" IsDefault="True"
                    Click="Ok_Click"
                    Background="{DynamicResource Theme_Accent}"
                    Foreground="{DynamicResource Theme_TextOnAccent}"
                    BorderThickness="0"/>
            <Button Content="{l:L MsgBox_Cancel}" Width="80" Height="28" IsCancel="True"
                    Click="Cancel_Click"
                    Background="{DynamicResource Theme_ButtonBg}"
                    Foreground="{DynamicResource Theme_TextPrimary}"
                    BorderBrush="{DynamicResource Theme_ButtonBorder}"/>
        </StackPanel>
    </Grid>
</Window>
